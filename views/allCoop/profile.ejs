  @media (max-width: 479.98px) {
    .coop-profile-page .quick-stats > [class*="col-"] { width: 100%; }
    .coop-profile-page .profile-header-card .d-flex.align-items-center.gap-3 { align-items: flex-start !important; }
    .coop-profile-page .profile-code { flex-wrap: wrap; }
