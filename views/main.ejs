<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'หน้าแรกระบบ CoopChain' %></title>
    <% if (typeof themeColor !== 'undefined' && themeColor) { %>
      <meta name="theme-color" content="<%= themeColor %>" />
    <% } %>
    <% if (typeof manifestPath !== 'undefined' && manifestPath) { %>
      <link rel="manifest" href="<%= manifestPath %>" />
      <link rel="icon" href="/icon/seal.svg" />
      <link rel="apple-touch-icon" href="/icon/seal.svg" />
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-title" content="CoopChain" />
      <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <% } %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@200;400;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  </head>
  <body class="main-dashboard-body d-flex flex-column min-vh-100 flex-grow-1">
    <main class="container-fluid main-dashboard-wrap py-3 py-lg-4 flex-grow-1">

<style>
  :root {
    --main-ink: #182230;
    --main-muted: #697586;
    --main-line: #dde5ee;
    --main-soft: #f5f7fb;
    --main-panel: #ffffff;
    --main-navy: #152238;
    --main-green: #137a57;
    --main-teal: #116c7a;
    --main-blue: #2c6ed5;
    --main-amber: #c98312;
    --main-red: #c94444;
    --main-shadow: 0 3px 12px rgba(30, 50, 42, .05);
    --main-shadow-soft: 0 1px 3px rgba(30, 50, 42, .025);
  }

  .main-dashboard-body {
    background:
      radial-gradient(circle at 18% 0%, rgba(19, 122, 87, .11), transparent 26rem),
      linear-gradient(180deg, #f6f8fb 0, #eef3f8 34rem, #f3f6fa 100%);
    color: var(--main-ink);
    font-family: 'Sarabun', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .main-dashboard-wrap {
    max-width: 1520px;
  }

  .main-dashboard-shell {
    display: grid;
    grid-template-columns: 15.25rem minmax(0, 1fr);
    gap: 1.25rem;
    min-height: calc(100vh - 2rem);
  }

  .main-sidebar {
    background: #122033;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, .08);
    box-shadow: 0 18px 42px rgba(15, 23, 42, .18);
    color: #dbe5ee;
    padding: .95rem;
    position: sticky;
    top: 1rem;
    height: calc(100vh - 2rem);
    min-height: 42rem;
  }

  .main-brand {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding: .5rem .35rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, .12);
  }

  .main-brand img {
    width: 2.55rem;
    height: 2.55rem;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
    padding: .35rem;
    box-shadow: 0 .75rem 1.4rem rgba(0, 0, 0, .16);
  }

  .main-brand-title {
    margin: 0;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .main-brand-subtitle {
    color: #a9b7c8;
    font-size: .78rem;
  }

  .main-nav {
    display: grid;
    gap: .35rem;
    margin: 1rem 0;
  }

  .main-nav-link {
    display: flex;
    align-items: center;
    gap: .65rem;
    border-radius: 8px;
    color: #c4d0dc;
    padding: .68rem .72rem;
    text-decoration: none;
    line-height: 1.35;
    transition: background-color .15s ease, color .15s ease, transform .15s ease;
  }

  .main-nav-link:hover,
  .main-nav-link.active {
    background: rgba(255, 255, 255, .1);
    color: #fff;
    transform: translateX(2px);
  }

  .main-nav-link i {
    width: 1.3rem;
    text-align: center;
    color: #84d9b8;
    flex: 0 0 auto;
  }

  .main-sidebar-foot {
    margin-top: auto;
    padding: .95rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, .09);
    border: 1px solid rgba(255, 255, 255, .08);
  }

  .main-content {
    min-width: 0;
  }

  .main-topbar,
  .main-panel,
  .main-stat,
  .main-login-card,
  .main-hero {
    background: var(--main-panel);
    border: 1px solid var(--main-line);
    border-radius: 8px;
    box-shadow: var(--main-shadow-soft);
  }

  .main-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem;
    margin-bottom: 1rem;
    backdrop-filter: blur(12px);
  }

  .main-avatar {
    width: 2.55rem;
    height: 2.55rem;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e7f8ef, #eef7ff);
    color: var(--main-green);
    font-weight: 700;
  }

  .main-hero {
    position: relative;
    min-height: 29rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.45rem, 3vw, 2.35rem);
    color: #fff;
    overflow: hidden;
    box-shadow: var(--main-shadow);
    background:
      linear-gradient(90deg, rgba(9, 20, 34, .92) 0%, rgba(16, 54, 67, .76) 46%, rgba(19, 122, 87, .28) 100%),
      url('/images/coopchain-network-hero.png') center / cover no-repeat;
  }

  .main-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, .08), rgba(5, 18, 32, .2));
    pointer-events: none;
  }

  .main-hero > * {
    position: relative;
    z-index: 1;
  }

  .main-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    width: max-content;
    border-radius: 8px;
    background: rgba(255, 255, 255, .16);
    border: 1px solid rgba(255, 255, 255, .22);
    padding: .45rem .7rem;
    color: #fff;
    font-size: .84rem;
    font-weight: 700;
  }

  .main-hero h2 {
    max-width: 43rem;
    margin: 1.05rem 0 .75rem;
    color: #fff;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.14;
  }

  .main-hero p {
    max-width: 35rem;
    color: rgba(255, 255, 255, .86);
  }

  .main-login-card {
    height: 100%;
    box-shadow: var(--main-shadow);
    overflow: hidden;
  }

  .main-login-card .card-body {
    background: linear-gradient(180deg, #fff 0%, #fbfdff 100%);
  }

  .main-login-card .form-control {
    border-radius: 8px;
    border-color: var(--main-line);
    background: #fbfcfe;
    min-height: 3rem;
  }

  .main-login-card .form-control:focus {
    border-color: rgba(22, 155, 98, .55);
    box-shadow: 0 0 0 .22rem rgba(22, 155, 98, .13);
  }

  .main-login-card .btn {
    border-radius: 8px;
    min-height: 3.05rem;
    border: 0;
    background: linear-gradient(135deg, #147b83, #107f50);
    box-shadow: 0 .7rem 1.2rem rgba(22, 155, 98, .22);
  }

  .main-login-card .btn:hover {
    filter: brightness(.97);
    transform: translateY(-1px);
  }

  .main-stat {
    position: relative;
    overflow: hidden;
    padding: 1.05rem;
    height: 100%;
    transition: transform .15s ease, box-shadow .15s ease;
  }

  .main-stat:hover {
    box-shadow: var(--main-shadow);
    transform: translateY(-1px);
  }

  .main-stat-icon {
    width: 2.65rem;
    height: 2.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-size: 1.15rem;
  }

  .main-stat-icon.green { background: #e9f7ef; color: var(--main-green); }
  .main-stat-icon.amber { background: #fff4dc; color: #b86f00; }
  .main-stat-icon.teal { background: #e5f6f8; color: var(--main-teal); }
  .main-stat-icon.blue { background: #eef5ff; color: var(--main-blue); }
  .main-stat-icon.red { background: #fdecec; color: var(--main-red); }

  .main-turnover-card {
    background: var(--main-panel);
    border: 1px solid var(--main-line);
    border-radius: 8px;
    box-shadow: var(--main-shadow-soft);
    height: 100%;
    overflow: hidden;
    padding: 1rem;
    position: relative;
  }

  .main-turnover-card::before {
    content: "";
    inset: 0 0 auto;
    height: .22rem;
    position: absolute;
    background: var(--turnover-accent, var(--main-green));
  }

  .main-turnover-card.green { --turnover-accent: var(--main-green); }
  .main-turnover-card.teal { --turnover-accent: var(--main-teal); }
  .main-turnover-card.amber { --turnover-accent: var(--main-amber); }

  .main-turnover-label {
    color: var(--main-muted);
    font-size: .85rem;
    font-weight: 700;
  }

  .main-turnover-value {
    color: var(--main-ink);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.15;
    margin-top: .45rem;
    overflow-wrap: anywhere;
  }

  .main-turnover-meta {
    border-top: 1px solid var(--main-line);
    color: var(--main-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: .82rem;
    gap: .45rem .85rem;
    margin-top: .9rem;
    padding-top: .75rem;
  }

  .main-strength-card {
    background: var(--main-panel);
    border: 1px solid var(--main-line);
    border-radius: 8px;
    box-shadow: var(--main-shadow-soft);
    height: 100%;
    padding: 1rem;
  }

  .main-chamra-overview,
  .main-chamra-stage-panel,
  .main-chamra-kpi {
    border-radius: 16px;
  }

  .main-chamra-overview,
  .main-chamra-kpi {
    height: 100%;
  }

  .main-chamra-overview {
    position: relative;
    overflow: hidden;
    padding: 1.2rem;
    color: #fff;
    background: linear-gradient(135deg, #123d35, #137a57);
    box-shadow: 0 14px 30px rgba(19, 122, 87, .2);
  }

  .main-chamra-overview-label {
    color: rgba(255,255,255,.72);
    font-size: .82rem;
    font-weight: 700;
  }

  .main-chamra-overview-value {
    margin-top: .2rem;
    color: #fff;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .main-chamra-progress-ring {
    display: grid;
    width: 6.2rem;
    height: 6.2rem;
    place-items: center;
    border-radius: 50%;
    background: conic-gradient(#74e0b3 var(--chamra-progress, 0%), rgba(255,255,255,.16) 0);
  }

  .main-chamra-progress-ring::before {
    content: '';
    grid-area: 1 / 1;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: #17664f;
  }

  .main-chamra-progress-value {
    z-index: 1;
    grid-area: 1 / 1;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .main-chamra-kind-list {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: .6rem;
    margin-top: 1.1rem;
  }

  .main-chamra-kind {
    padding: .7rem;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 12px;
    background: rgba(255,255,255,.09);
  }

  .main-chamra-kind span { display:block; color:rgba(255,255,255,.7); font-size:.72rem; }
  .main-chamra-kind strong { display:block; margin-top:.2rem; color:#fff; font-size:1.15rem; }

  .main-chamra-kpi {
    padding: 1rem;
    border: 1px solid var(--main-line);
    background: #fff;
    box-shadow: 0 8px 22px rgba(15,23,42,.045);
  }

  .main-chamra-kpi-label { color:var(--main-muted); font-size:.8rem; font-weight:700; }
  .main-chamra-kpi-value { margin-top:.3rem; font-size:1.55rem; font-weight:700; line-height:1.1; }
  .main-chamra-kpi-note { margin-top:.35rem; color:var(--main-muted); font-size:.74rem; }

  .main-chamra-stage-panel {
    padding: 1rem;
    border: 1px solid var(--main-line);
    background: #fff;
    box-shadow: 0 8px 22px rgba(15,23,42,.045);
  }

  .main-chamra-stage-list { display:grid; gap:.65rem; margin-top:.85rem; }
  .main-chamra-stage {
    display:grid;
    grid-template-columns:minmax(11rem,1.35fr) minmax(6rem,1fr) 3.5rem;
    align-items:center;
    gap:.75rem;
  }
  .main-chamra-stage-label { min-width:0; color:#344054; font-size:.8rem; font-weight:600; }
  .main-chamra-stage-label strong { color:var(--main-green); }
  .main-chamra-stage-bar { height:.52rem; overflow:hidden; border-radius:999px; background:#edf1f6; }
  .main-chamra-stage-bar-fill { width:var(--stage-width,0%); height:100%; border-radius:inherit; background:linear-gradient(90deg,#1b8f67,#4bc394); }
  .main-chamra-stage-count { text-align:right; color:var(--main-ink); font-size:.8rem; font-weight:700; }

  @media (max-width: 575.98px) {
    .main-chamra-stage { grid-template-columns:minmax(0,1fr) 3rem; gap:.4rem .65rem; }
    .main-chamra-stage-bar { grid-column:1 / -1; grid-row:2; }
    .main-chamra-stage-count { grid-column:2; grid-row:1; }
  }

  .main-strength-grade-list {
    display: grid;
    gap: .55rem;
    margin-top: .85rem;
  }

  .main-strength-grade-row {
    align-items: center;
    display: grid;
    gap: .65rem;
    grid-template-columns: 4.2rem minmax(0, 1fr) 3.3rem;
  }

  .main-strength-grade-label {
    color: var(--main-muted);
    font-size: .8rem;
    font-weight: 700;
  }

  .main-strength-bar {
    background: #edf1f6;
    border-radius: 999px;
    height: .48rem;
    overflow: hidden;
  }

  .main-strength-bar-fill {
    border-radius: inherit;
    height: 100%;
    width: var(--strength-width, 0%);
  }

  .main-strength-bar-fill.grade-1 { background: var(--main-green); }
  .main-strength-bar-fill.grade-2 { background: var(--main-amber); }
  .main-strength-bar-fill.grade-3 { background: var(--main-red); }

  .main-strength-grade-value {
    color: var(--main-ink);
    font-size: .9rem;
    font-weight: 700;
    text-align: right;
  }

  .main-institution-section {
    margin-top: 1.15rem;
  }

  .main-section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .85rem;
    padding: .15rem .1rem;
  }

  .main-section-title h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .main-institution-card {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    padding: 1.05rem;
    text-align: left;
    background: #fff;
    border: 1px solid var(--main-line);
    border-radius: 8px;
    box-shadow: var(--main-shadow-soft);
    transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
  }

  .main-institution-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: .22rem;
    background: var(--card-accent, var(--main-green));
  }

  .main-institution-card:hover {
    border-color: #a5dfe4;
    box-shadow: var(--main-shadow);
    transform: translateY(-1px);
  }

  .main-institution-card:focus-visible {
    outline: 3px solid rgba(34, 160, 107, .3);
    outline-offset: 2px;
  }

  .main-institution-label {
    color: var(--main-muted);
    font-size: .9rem;
    font-weight: 700;
  }

  .main-institution-count {
    color: var(--main-ink);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .main-institution-hint {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--card-accent, var(--main-green));
    font-size: .82rem;
    font-weight: 700;
  }

  .main-institution-card[data-institution-type="agri"] { --card-accent: var(--main-green); }
  .main-institution-card[data-institution-type="non_agri"] { --card-accent: var(--main-teal); }
  .main-institution-card[data-institution-type="farmer"] { --card-accent: var(--main-amber); }

  .main-institution-chart-card {
    height: 100%;
    min-height: 19rem;
    padding: 1.05rem;
    background: #fff;
    border: 1px solid var(--main-line);
    border-radius: 8px;
    box-shadow: var(--main-shadow-soft);
  }

  .main-chart-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .9rem;
  }

  .main-chart-title {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin: 0;
    color: var(--main-ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .main-chart-title i {
    color: var(--main-green);
  }

  .main-chart-canvas-wrap {
    position: relative;
    min-height: 13.5rem;
  }

  .main-chart-canvas-wrap.tall {
    min-height: 17rem;
  }

  .main-chart-canvas-wrap.compact {
    min-height: 12rem;
  }

  .main-chart-canvas-wrap canvas {
    width: 100% !important;
  }

  .main-chart-fallback {
    display: grid;
    gap: .55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-chart-fallback[hidden] {
    display: none;
  }

  .main-chart-fallback li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .62rem .75rem;
    border: 1px solid #edf1f6;
    border-radius: 8px;
    background: #f8fafc;
    color: var(--main-ink);
    font-size: .9rem;
    font-weight: 700;
  }

  .main-chart-fallback span {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
  }

  .main-chart-dot {
    width: .65rem;
    height: .65rem;
    border-radius: 999px;
    background: var(--dot-color, var(--main-green));
    flex: 0 0 auto;
  }

  .main-chart-kpi-grid {
    display: grid;
    gap: .6rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: .85rem;
  }

  .main-chart-kpi {
    border: 1px solid #edf1f6;
    border-radius: 8px;
    background: #f8fafc;
    padding: .65rem;
    min-width: 0;
  }

  .main-chart-kpi-label {
    color: var(--main-muted);
    font-size: .74rem;
    line-height: 1.25;
  }

  .main-chart-kpi-value {
    color: var(--main-ink);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.15;
    margin-top: .25rem;
    overflow-wrap: anywhere;
  }

  .main-pill {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    border: 1px solid var(--main-line);
    border-radius: 8px;
    background: #fff;
    color: var(--main-muted);
    padding: .35rem .55rem;
    font-size: .82rem;
    font-weight: 700;
  }

  .main-institution-modal-table {
    font-size: .92rem;
  }

  .main-institution-modal-table th {
    background: #f8fafc;
    color: var(--main-muted);
    font-weight: 700;
    white-space: nowrap;
  }

  .main-institution-modal-table td {
    vertical-align: middle;
  }

  .main-institution-name {
    min-width: 14rem;
    color: var(--main-ink);
    font-weight: 700;
  }

  .main-system-link {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .8rem .9rem;
    border: 1px solid var(--main-line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--main-ink);
    background: #fff;
    box-shadow: var(--main-shadow-soft);
    transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
  }

  .main-system-link:hover {
    color: var(--main-teal);
    border-color: #a5dfe4;
    box-shadow: 0 .55rem 1.2rem rgba(31, 42, 55, .08);
    transform: translateY(-1px);
  }

  .main-system-link i {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #eef5ff;
    color: var(--main-blue);
    flex: 0 0 auto;
  }

  .main-deadline-section {
    margin-top: 1.15rem;
  }

  .main-empty {
    border: 1px dashed #cbd5e1;
    border-radius: 8px;
    color: var(--main-muted);
    padding: 1rem;
    text-align: center;
    background: #f8fafc;
