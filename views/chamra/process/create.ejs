<%- include('../../partials/header.ejs') %>
<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 d-flex align-items-center gap-2">
            <span class="fs-5">🧩</span> เพิ่มความก้าวหน้าการชำระบัญชี
          </h5>
          <a href="/chamra/process" class="btn btn-sm btn-outline-light">← กลับ</a>
        </div>
        <form method="POST" action="/chamra/process/add">
          <div class="card-body">
            <% if (error) { %>
              <div class="alert alert-danger py-2 px-3"><%= error %></div>
            <% } %>
            <div class="mb-3">
              <label class="form-label fw-semibold">สถาบัน (รหัส) <span class="text-danger">*</span></label>
              <select name="pr_code" class="form-select form-select-sm" required>
                <option value="" disabled <%= !old.pr_code ? 'selected' : '' %>>-- เลือก --</option>
                <% coopList.forEach(c => { %>
                  <option value="<%= c.c_code %>" <%= old.pr_code === c.c_code ? 'selected' : '' %>><%= c.c_code %> - <%= c.c_name %></option>
                <% }) %>
              </select>
            </div>

            <div class="border rounded p-3 mb-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="small text-uppercase text-secondary">ขั้นตอน (ถ้าไม่มี ปล่อยว่าง)</strong>

              </div>
              <div class="row g-2">
                <% for (let i=1;i<=10;i++){ const k='pr_s'+i; %>
                  <div class="col-6 col-md-4 col-lg-3">
                    <label class="form-label small mb-1"><%= i %>. <%= ['ประกาศผู้ชำระบัญชี', 'รับมอบทรัพย์สิน', 'ส่งงบ ม.80', 'ผู้สอบบัญชีรับรองงบ', 'ประชุมใหญ่อนุมัติงบ', 'จัดการทรัพย์สิน/หนี้สิน', 'ส่งรายงานการชำระบัญชี', 'ผู้สอบบัญชีรับรองรายงาน', 'ถอนชื่อออกจากทะเบียน', 'ส่งมอบเอกสารหลักฐาน'][i-1] %></label>
                    <input type="date" name="pr_s<%= i %>" class="form-control form-control-sm" value="<%= old[k] || '' %>">
                  </div>
                <% } %>
              </div>
              <div class="form-text mt-2">ถ้าไม่ทราบวันที่ให้เว้นว่าง ระบบจะยังไม่นับว่าดำเนินการขั้นนั้นแล้ว</div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center gap-2">
                ✅ <span>บันทึก</span>
              </button>
              <a href="/chamra/process" class="btn btn-outline-secondary btn-sm">ยกเลิก</a>
            </div>
          </div>
        </form>
      </div>
      <div class="text-center small text-muted mt-3">Chamra Process Management</div>
    </div>
  </div>
</div>

<%- include('../../partials/footer.ejs') %>
