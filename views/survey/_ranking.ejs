<article class="survey-rank-card">
  <h3><%= title %></h3>
  <% if (!items.length) { %><p class="survey-muted">ยังไม่มีข้อมูล</p><% } %>
  <% items.forEach((item, index) => { %>
    <div class="survey-rank"><div><span class="survey-rank-no"><%= index + 1 %></span><strong><%= item.label %></strong><b><%= item.count %></b></div><span><i style="width:<%= total ? Math.round(item.count / total * 100) : 0 %>%"></i></span></div>
  <% }) %>
</article>
