<%- include('../partials/header.ejs', { title: title || 'ทะเบียนข้อสังเกต' }) %>
<%
  const summary = (dashboard && dashboard.summary) || {};
  const groupRows = (dashboard && dashboard.groupRows) || [];
  const categoryRows = (dashboard && dashboard.categoryRows) || [];
  const activeFiltersCount = [
    filters.search,
    filters.groupNo,
    filters.categoryId,
    filters.status,
    filters.severityCase,
    filters.auditType,
    filters.coopType,
    filters.fiscalYearEnd
  ].filter(Boolean).length;

  const fmtMoney = (value) => new Intl.NumberFormat('th-TH', { maximumFractionDigits: 2 }).format(Number(value || 0));
  const statusOptions = [
    { value: 'new', label: 'ใหม่' },
    { value: 'in_progress', label: 'กำลังดำเนินการ' },
    { value: 'monitoring', label: 'ติดตาม' },
    { value: 'resolved', label: 'ปิดแล้ว' },
    { value: 'closed', label: 'ยุติ' }
  ];
  const statusLabel = (value) => {
    return statusOptions.find((item) => item.value === value)?.label || '-';
  };
  const severityLabel = (value) => {
    if (value === 'serious_order') return 'ร้ายแรง';
    if (value === 'advice') return 'คำแนะนำ';
    if (value === 'fact_check') return 'ตรวจข้อเท็จจริง';
    return '-';
  };
  const severityBadge = (value) => {
    if (value === 'serious_order') return 'danger';
    if (value === 'advice') return 'warning';
    if (value === 'fact_check') return 'info';
    return 'secondary';
  };
  const typeLabel = (value) => (value === 'group_farmer' ? 'กลุ่มเกษตรกร' : 'สหกรณ์');
  const typeBadge = (value) => (value === 'group_farmer' ? 'secondary' : 'success');
  const isAdmin = user && [user.mClass, user.m_class, user.level].includes('admin');
  const safeFilters = {
    search: filters.search || '',
    groupNo: filters.groupNo || '',
    categoryId: filters.categoryId || '',
    status: filters.status || '',
    severityCase: filters.severityCase || '',
    auditType: filters.auditType || '',
    coopType: filters.coopType || '',
    fiscalYearEnd: filters.fiscalYearEnd || ''
  };
  const buildQuery = (overrides = {}) => {
    const params = new URLSearchParams();
    const merged = { ...safeFilters, ...overrides };
    Object.entries(merged).forEach(([key, value]) => {
      if (value !== null && value !== undefined && String(value).trim() !== '') {
        params.set(key, String(value));
      }
    });
    return `?${params.toString()}`;
  };
%>

<link rel="stylesheet" href="/css/sangket-index.css">
<link rel="stylesheet" href="/css/sangket.css">

<div class="sangket-page py-3 sangket-workspace">
  <div class="container">
    <%- include('navigation', { current: 'index', pageLabel: 'ทะเบียนสถาบัน' }) %>
    <% if (clearResult) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        ล้างข้อมูลทะเบียนข้อสังเกตเรียบร้อยแล้ว (<%= clearResult.deletedCount %> รายการ)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="ปิด"></button>
      </div>
    <% } %>
    <div class="sangket-hero mb-4">
      <div class="sangket-hero__surface p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
          <div class="flex-grow-1">

            <h1 class="hero-title mb-2">ทะเบียนข้อสังเกต</h1>
            <p class="hero-subtitle mb-0">
              เลือกสถาบันเพื่อดูข้อสังเกตและติดตามการดำเนินงาน
            </p>
          </div>

        </div>

        <div class="row g-3 mt-3">
          <div class="col-6 col-lg-3">
            <div class="metric-card">
              <div class="metric-label">สถาบันที่พบข้อสังเกต</div>
              <div class="metric-value"><%= cooperativeTotal || 0 %></div>
              <div class="metric-note">รายการที่ผ่านตัวกรองปัจจุบัน</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="metric-card">
              <div class="metric-label">ข้อสังเกตทั้งหมด</div>
              <div class="metric-value"><%= summary.total_observations || 0 %></div>
              <div class="metric-note">ข้อสังเกตที่เกี่ยวข้องกับรายการที่กรอง</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="metric-card">
              <div class="metric-label">รายการค้างดำเนินการ</div>
              <div class="metric-value"><%= summary.open_items || 0 %></div>
              <div class="metric-note">สถานะ <%= ['new', 'in_progress', 'monitoring'].map(statusLabel).join(' / ') %></div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="metric-card">
              <div class="metric-label">มูลค่าความเสียหายรวม</div>
              <div class="metric-value"><%= fmtMoney(summary.total_damage || 0) %></div>
              <div class="metric-note">บาท</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="sangket-panel mb-4 p-3 p-lg-4">
      <form class="row g-3 align-items-end" method="GET" action="/sangket">
        <% ['auditType', 'coopType', 'fiscalYearEnd'].forEach((key) => { if (safeFilters[key]) { %><input type="hidden" name="<%= key %>" value="<%= safeFilters[key] %>"><% } }); %>
        <div class="col-12 col-lg-4">
          <label class="form-label fw-semibold" for="sangket-index-field-1">ค้นหา</label>
          <input id="sangket-index-field-1" type="text" name="search" value="<%= filters.search || '' %>" class="form-control" placeholder="ชื่อสหกรณ์ / เลขหนังสือ / ข้อความข้อสังเกต">
        </div>
        <div class="col-6 col-lg-2">
          <label class="form-label fw-semibold" for="sangket-index-field-2">กสส.</label>
          <select name="groupNo" class="form-select" id="sangket-index-field-2">
            <option value="">ทั้งหมด</option>
            <% groups.forEach((group) => { %>
              <option value="<%= group.group_no %>" <%= String(filters.groupNo || '') === String(group.group_no) ? 'selected' : '' %>>
                กสส. <%= group.group_no %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-lg-2">
          <label class="form-label fw-semibold" for="sangket-index-field-3">หมวด</label>
          <select name="categoryId" class="form-select" id="sangket-index-field-3">
            <option value="">ทั้งหมด</option>
            <% categories.forEach((cat) => { %>
              <option value="<%= cat.id %>" <%= String(filters.categoryId || '') === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-lg-2">
          <label class="form-label fw-semibold" for="sangket-index-field-4">สถานะ</label>
          <select name="status" class="form-select" id="sangket-index-field-4">
            <option value="">ทั้งหมด</option>
            <% statusOptions.forEach((option) => { %>
              <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-lg-2">
          <label class="form-label fw-semibold" for="sangket-index-field-5">กรณี</label>
          <select name="severityCase" class="form-select" id="sangket-index-field-5">
            <option value="">ทั้งหมด</option>
            <option value="serious_order" <%= filters.severityCase === 'serious_order' ? 'selected' : '' %>>ร้ายแรง</option>
            <option value="advice" <%= filters.severityCase === 'advice' ? 'selected' : '' %>>คำแนะนำ</option>
            <option value="fact_check" <%= filters.severityCase === 'fact_check' ? 'selected' : '' %>>ตรวจข้อเท็จจริง</option>
          </select>
        </div>
        <div class="col-12 col-lg-2 d-grid">
          <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>ค้นหา</button>
        </div>
      </form>
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mt-3 pt-3 border-top">
        <div class="quick-filters"><a class="btn btn-sm btn-outline-secondary <%= !filters.status ? 'active' : '' %>" href="<%= buildQuery({ status: '' }) %>">ทุกสถานะ</a>
          <% statusOptions.forEach((option) => { %>
            <a class="btn btn-sm btn-outline-secondary <%= filters.status === option.value ? 'active' : '' %>" href="<%= buildQuery({ status: option.value }) %>"><%= option.label %></a>
          <% }) %>
        </div>
        <div class="small text-muted">
          <%= activeFiltersCount ? `${activeFiltersCount} ตัวกรองใช้งานอยู่` : 'ยังไม่ได้เลือกตัวกรอง' %>
        </div>
      </div>
    </div>

    <div class="sangket-panel mb-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 p-3 px-lg-4 pt-lg-4">
        <div>
          <h5 class="mb-1 fw-bold">รายการสถาบัน</h5>
          <div class="text-muted small">พบ <%= items.length %> สถาบันตามตัวกรอง</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/sangket" class="btn btn-outline-secondary btn-sm">ล้างตัวกรอง</a>
          <a href="/sangket/create" class="btn btn-primary btn-sm">บันทึกใหม่</a>
        </div>
      </div>

      <div class="table-responsive desktop-table">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>สถาบัน</th>
              <th>จำนวนประเด็นตามสถานะ</th>
              <th class="text-end">การทำงาน</th>
            </tr>
          </thead>
          <tbody>
            <% if (items && items.length) { %>
              <% items.forEach((row) => { %>
                <tr>
                  <td class="coop-cell">
                    <div class="coop-title"><%= row.cooperative_name %></div>
                    <div class="coop-meta">
                      <span class="badge text-bg-<%= typeBadge(row.coop_type) %> me-1"><%= typeLabel(row.coop_type) %></span>
                      <% if (row.cooperative_code) { %><span class="me-1">รหัส <%= row.cooperative_code %></span><% } %>
                      <% if (row.promotion_group_no) { %><span class="me-1">| กสส. <%= row.promotion_group_no %></span><% } %>
                      <% if (row.district) { %><span class="me-1">| <%= row.district %></span><% } %>
                    </div>
                  </td>
                  <td>
                    <div class="summary-grid">
                      <div class="summary-chip">
                        <div class="summary-chip__label">ทั้งหมด</div>
                        <div class="summary-chip__value"><%= row.observation_total || 0 %></div>
                      </div>
                      <div class="summary-chip">
                        <div class="summary-chip__label">แก้ไขแล้ว</div>
                        <div class="summary-chip__value text-success"><%= row.resolved_items || 0 %></div>
                      </div>
                      <div class="summary-chip">
                        <div class="summary-chip__label">ระหว่างดำเนินการ</div>
                        <div class="summary-chip__value text-primary"><%= row.in_progress_items || 0 %></div>
                      </div>
                      <div class="summary-chip">
                        <div class="summary-chip__label">ยังไม่แก้ไข</div>
                        <div class="summary-chip__value text-danger"><%= row.new_items || 0 %></div>
                      </div>
                    </div>
                  </td>
                  <td class="text-end">
                    <div class="action-icons justify-content-end">
                      <a href="/sangket/cooperatives/<%= row.cooperative_id %>" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-eye me-1" aria-hidden="true"></i>ดูข้อสังเกต
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3">
                  <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox display-6 d-block mb-2"></i>
                    ยังไม่มีข้อมูลสหกรณ์ที่ตรงกับตัวกรอง
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="mobile-cards px-3 pb-3">
        <% if (items && items.length) { %>
          <% items.forEach((row) => { %>
            <div class="mobile-card">
              <div class="mobile-card__top">
                <div class="flex-grow-1">
                  <div class="mobile-card__title"><%= row.cooperative_name %></div>
                  <div class="mobile-card__meta">
                    <span class="badge text-bg-<%= typeBadge(row.coop_type) %> me-1"><%= typeLabel(row.coop_type) %></span>
                    <% if (row.cooperative_code) { %><span>รหัส <%= row.cooperative_code %></span><% } %>
                  </div>
                </div>
                <span class="badge text-bg-success"><%= row.observation_total || 0 %> ข้อสังเกต</span>
              </div>
              <div class="mobile-card__text">
                <div class="text-success">แก้ไขแล้ว <strong><%= row.resolved_items || 0 %></strong> ประเด็น</div>
                <div class="text-primary">ระหว่างดำเนินการ <strong><%= row.in_progress_items || 0 %></strong> ประเด็น</div>
                <div class="text-danger">ยังไม่แก้ไข <strong><%= row.new_items || 0 %></strong> ประเด็น</div>
              </div>
              <div class="mobile-card__footer">
                <div class="text-muted small">ทั้งหมด <%= row.observation_total || 0 %> ประเด็น</div>
                <a href="/sangket/cooperatives/<%= row.cooperative_id %>" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-eye me-1" aria-hidden="true"></i>ดูข้อสังเกต
                </a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="px-3 pb-3 text-muted">ยังไม่มีข้อมูลสหกรณ์ที่ตรงกับตัวกรอง</div>
        <% } %>
      </div>
    </div>

    <details class="sangket-disclosure mb-3"><summary>ดูสรุปแยกตามกลุ่มส่งเสริมและหมวด</summary>
    <div class="row g-3 mb-4">
      <div class="col-lg-6">
        <div class="sangket-panel p-3 h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold">แยกตาม กสส.</h6>
          </div>
          <div class="list-group list-group-flush">
            <% groupRows.forEach((group) => { %>
              <a href="<%= buildQuery({ groupNo: group.group_no }) %>" class="list-group-item list-group-item-action filter-list-item d-flex justify-content-between align-items-center px-0 text-decoration-none">
                <span>กสส. <%= group.group_no || 0 %></span>
                <span class="badge text-bg-success"><%= group.total %></span>
              </a>
            <% }) %>
            <% if (!groupRows.length) { %>
              <div class="text-muted small">ยังไม่มีข้อมูล</div>
            <% } %>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="sangket-panel p-3 h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold">แยกตามหมวด</h6>
          </div>
          <div class="list-group list-group-flush">
            <% categoryRows.forEach((cat) => { %>
              <a href="<%= buildQuery({ categoryId: cat.id }) %>" class="list-group-item list-group-item-action filter-list-item d-flex justify-content-between align-items-center px-0 text-decoration-none">
                <span class="me-2"><%= cat.name %></span>
                <span class="badge text-bg-info"><%= cat.total %></span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    </details>
<% if (isAdmin) { %><details class="sangket-disclosure sangket-admin"><summary>จัดการข้อมูลสำหรับผู้ดูแล</summary>            <% if (isAdmin) { %>
              <form method="POST" action="/sangket/clear-all" class="d-inline" onsubmit="return confirmClearSangket(this);">
                <input type="hidden" name="confirmation" value="">
                <button type="submit" class="btn btn-outline-danger rounded-3">
                  <i class="bi bi-trash3 me-1"></i> ล้างข้อมูลทั้งหมด
                </button>
              </form>
            <% } %> </details><% } %>
  </div>
</div>

<script>
  function confirmClearSangket(form) {
    const requiredText = 'ล้างข้อมูลทั้งหมด';
    const confirmation = window.prompt(
      `การดำเนินการนี้จะลบข้อมูลทั้งหมดในทะเบียนข้อสังเกตและไม่สามารถเรียกคืนได้\n\nพิมพ์ "${requiredText}" เพื่อยืนยัน`
    );

    if (confirmation !== requiredText) {
      if (confirmation !== null) {
        window.alert('ข้อความยืนยันไม่ถูกต้อง ระบบยังไม่ได้ลบข้อมูล');
      }
      return false;
    }

    form.elements.confirmation.value = confirmation;
    return window.confirm('ยืนยันครั้งสุดท้ายว่าต้องการล้างข้อมูลทะเบียนข้อสังเกตทั้งหมดใช่หรือไม่?');
  }
</script>

<%- include('../partials/footer') %>
