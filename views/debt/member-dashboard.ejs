<%- include('partials/head') %>
<% const memberOutstanding=allLoans.reduce((sum,x)=>sum+Number(x.principal_balance||0),0); const memberUrgent=allLoans.filter(x=>x.urgent_no_recent_followup).length; const attentionLoans=allLoans.filter(x=>['RED','ORANGE'].includes(x.risk_color)); const visibleLoans=(query.view==='all'||query.risk||query.q)?loans:attentionLoans; %>
<section class="module-summary member mb-4"><div class="module-primary"><span class="domain-symbol"><i class="bi bi-people"></i></span><div><span class="section-kicker">MEMBER DEBT</span><h2>หนี้สมาชิก</h2><p>สหกรณ์เป็นเจ้าหนี้ สมาชิกเป็นลูกหนี้ <span class="demo-pill">DEMO</span></p></div></div><div class="module-money"><span>ยอดหนี้คงเหลือรวม</span><strong><%= debtMoney(memberOutstanding) %></strong><small>บาท</small></div><div class="module-alert"><span>ยังขาดการติดตาม</span><strong><%= debtNumber(memberUrgent) %></strong><small>รายการเร่งด่วน</small></div></section>
<nav class="risk-filter-bar mb-4" aria-label="กรองระดับความเสี่ยง"><a class="<%= !query.risk&&query.view!=='all'&&!query.q?'active':'' %>" href="/debt/member-debt"><span>ต้องติดตาม</span><strong><%= attentionLoans.length %></strong></a><a class="<%= query.view==='all'?'active':'' %>" href="/debt/member-debt?view=all"><span>ทั้งหมด</span><strong><%= allLoans.length %></strong></a><% ['RED','ORANGE','YELLOW','GREEN'].forEach((risk)=>{ %><a class="<%= risk.toLowerCase() %> <%= query.risk===risk?'active':'' %>" href="/debt/member-debt?risk=<%= risk %>"><span><%= debtRiskThai(risk) %></span><strong><%= allLoans.filter(x=>x.risk_color===risk).length %></strong></a><% }) %></nav>

<section class="panel"><div class="panel-head"><div><span class="section-kicker">MEMBER FOCUS</span><h2><%= query.view==='all'?'ลูกหนี้ทั้งหมด':query.risk?`ลูกหนี้ — ${debtRiskThai(query.risk)}`:query.q?'ผลการค้นหา':'ลูกหนี้ที่ต้องติดตามก่อน' %></h2><p>เรียงจากความเสี่ยงและยอดค้างชำระสูงสุด</p></div><form class="search-form" method="get"><input name="q" value="<%= query.q||'' %>" placeholder="ค้นหาสมาชิกหรือเลขสัญญา"><button aria-label="ค้นหา"><i class="bi bi-search"></i></button></form></div><div class="table-responsive"><table class="table debt-table focus-table"><thead><tr><th>ระดับ</th><th>สมาชิก / สัญญา</th><th>สหกรณ์</th><th class="text-end">คงเหลือ</th><th class="text-end">ยอดค้าง</th><th>เหตุผล</th><th></th></tr></thead><tbody><% visibleLoans.forEach((x)=>{ %><tr><td><%- include('partials/risk-badge',{risk:x.risk_color}) %></td><td><strong><%= x.display_name %> <span class="demo-pill">DEMO</span></strong><small><%= x.member_no %> • <%= x.loan_no %></small></td><td><%= x.c_name %></td><td class="text-end"><%= debtMoney(x.principal_balance) %></td><td class="text-end"><%= debtMoney(x.total_overdue) %></td><td><%= x.attention_reason %></td><td><a class="btn btn-sm btn-light" href="/debt/member-debt/loans/<%= x.loan_id %>">รายละเอียด</a></td></tr><% }) %></tbody></table></div></section>

<details class="panel disclosure-panel mt-4"><summary><div><span class="section-kicker">COOPERATIVE COMPARISON</span><h2>เปรียบเทียบรายสหกรณ์</h2><p>ดูยอดรวมและสัดส่วนความเสี่ยงของแต่ละสหกรณ์</p></div><span><strong><%= cooperatives.length %></strong> แห่ง <i class="bi bi-chevron-down"></i></span></summary><div class="table-responsive"><table class="table debt-table"><thead><tr><th>สหกรณ์</th><th class="text-end">สมาชิกผู้กู้</th><th class="text-end">ยอดหนี้คงเหลือ</th><th class="text-end">ยอดค้าง</th><th>ความเสี่ยง</th><th></th></tr></thead><tbody><% cooperatives.forEach((x)=>{ %><tr><td><strong><%= x.c_name %></strong><small><%= x.c_code %></small></td><td class="text-end"><%= debtNumber(x.borrower_members) %></td><td class="text-end"><%= debtMoney(x.total_principal_balance) %></td><td class="text-end"><%= debtMoney(x.total_overdue) %></td><td><span class="risk-count red"><%= x.red_loans %> แดง</span> <span class="risk-count orange"><%= x.orange_loans %> ส้ม</span></td><td><a class="btn btn-sm btn-light" href="/debt/member-debt/cooperatives/<%= x.coop_id %>">เปิด</a></td></tr><% }) %></tbody></table></div></details>
<%- include('partials/foot') %>
