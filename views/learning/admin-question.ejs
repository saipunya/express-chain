<fieldset class="learning-edit-row" data-editor-item>
  <legend data-editor-label>คำถาม</legend>
  <div class="learning-form">
    <label>คำถาม<input name="questions[<%= index %>][prompt]" value="<%= row.prompt || '' %>" maxlength="350"></label>
    <div class="learning-edit-choices">
      <% for (let choice = 0; choice < 3; choice += 1) { %>
        <label>ตัวเลือก <%= choice + 1 %><input name="questions[<%= index %>][choices][<%= choice %>]" value="<%= row.choices?.[choice] || '' %>" maxlength="250"></label>
      <% } %>
    </div>
    <label class="learning-short-field">คำตอบที่ถูก
      <select name="questions[<%= index %>][correct]">
        <option value="">เลือกคำตอบ</option>
        <% for (let choice = 0; choice < 3; choice += 1) { %>
          <option value="<%= choice %>" <%= row.correct === String(choice) ? 'selected' : '' %>>ตัวเลือก <%= choice + 1 %></option>
        <% } %>
      </select>
    </label>
  </div>
  <button class="learning-text-button" type="button" data-editor-remove>นำคำถามออก</button>
</fieldset>
