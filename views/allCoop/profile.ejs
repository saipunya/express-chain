        <a href="#strength-section" class="btn btn-sm btn-light"><i class="bi bi-graph-up-arrow"></i>ความเข้มแข็ง</a>
        <a href="#rules-section" class="btn btn-sm btn-light"><i class="bi bi-journal-text"></i>ข้อบังคับ</a>
        <a href="#rabiab-section" class="btn btn-sm btn-light"><i class="bi bi-file-earmark-text"></i>ระเบียบ</a>
        <a href="#vong-section" class="btn btn-sm btn-light"><i class="bi bi-piggy-bank"></i>วงเงิน</a>
        <a href="#finance-section" class="btn btn-sm btn-light"><i class="bi bi-cash-stack"></i>งบการเงิน</a>
        <a href="#business-section" class="btn btn-sm btn-light"><i class="bi bi-briefcase"></i>รายงานกิจการ</a>
        <a href="#turnover-section" class="btn btn-sm btn-light"><i class="bi bi-bar-chart"></i>ปริมาณธุรกิจ</a>
        <a href="#rq2-section" class="btn btn-sm btn-light"><i class="bi bi-collection"></i>RQ2</a>
        <a href="#assets-section" class="btn btn-sm btn-light"><i class="bi bi-gear-wide-connected"></i>ทรัพย์สิน</a>
      </div>

      <!-- Personnel and Fiscal Year Information Cards -->
      <div class="row g-3 mb-4 quick-stats">
        <div class="col-6 col-md-3">
          <div class="card stat-card--blue border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-person-badge fs-5 text-primary mt-1"></i>
                <div class="flex-grow-1">
                  <p class="text-muted small mb-1">เจ้าหน้าที่ส่งเสริมสหกรณ์ (1)</p>
                  <div class="fw-semibold"><%= data.coop.c_person || '-' %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card stat-card--cyan border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-person-badge fs-5 text-info mt-1"></i>
                <div class="flex-grow-1">
                  <p class="text-muted small mb-1">เจ้าหน้าที่ส่งเสริมสหกรณ์ (2)</p>
                  <div class="fw-semibold"><%= data.coop.c_person2 || '-' %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card stat-card--green border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-calendar-event fs-5 text-success mt-1"></i>
                <div class="flex-grow-1">
                  <p class="text-muted small mb-1">วันสิ้นปีบัญชี</p>
                  <div class="fw-semibold">
                    <% if (data.fiscalEndDateThai) { %>
                      <%= data.fiscalEndDateThai %>
                    <% } else { %>
                      ไม่ระบุ
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card stat-card--violet border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-check2-square fs-5 text-primary mt-1"></i>
                <div class="flex-grow-1">
                  <p class="text-muted small mb-1">วันที่ประชุมใหญ่ล่าสุด</p>
                  <div class="fw-semibold">
                    <% if (data.bigmeetDateThai) { %>
                      <%= data.bigmeetDateThai %>
                    <% } else { %>
                      ไม่มีข้อมูล
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row my-2">
        <div class="col-md-6">
          <section class="section-block" id="addmem-section">
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-transparent d-flex flex-wrap align-items-center justify-content-between py-2 gap-2">
                <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-people me-2 text-purple" style="color:#6f42c1;"></i>ข้อมูลสมาชิก</h5>
                <span class="badge rounded-pill" style="background-color:#e2d5f3; color:#6f42c1;">รวม <%= (data.addmem||[]).length %> รายการ</span>
              </div>
              <div class="card-body p-0">
                <% if (data.addmem && data.addmem.length) { %>
                  <div class="table-responsive">
                    <table class="table table-sm table-hover table-striped align-middle mb-0 responsive-table">
                      <thead class="table-light">
                        <tr>
                          <th style="width:120px">ปี (จากข้อมูล)</th>
                          <th style="width:160px">วันสิ้นปี + ปี</th>
                          <th style="width:120px">สามัญ</th>
                          <th style="width:120px">สมทบ</th>
                          <th style="width:100px">รวมทั้งหมด</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% data.addmem.forEach(a => { %>
                          <tr>
                            <td class="fw-medium" data-label="ปี">
                              <% if(!user) { %>
                                <span class="text-muted" title="เข้าสู่ระบบเพื่อดูข้อมูล"><i class="bi bi-lock-fill"></i></span>
                              <% } else { %>
                                <%= a.addmem_year || '-' %>
                              <% } %>
                            </td>
                            <td data-label="วันสิ้นปี + ปี">
                              <% if(!user) { %>
                                <span class="text-muted" title="เข้าสู่ระบบเพื่อดูข้อมูล"><i class="bi bi-lock-fill"></i></span>
                              <% } else { %>
                                <% if (a.calculated_date) { %>
                                  <%= new Date(a.calculated_date).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                <% } else { %>
                                  -
                                <% } %>
                              <% } %>
                            </td>
                            <td data-label="สามัญ">
                              <% if(!user) { %>
                                <span class="text-muted" title="เข้าสู่ระบบเพื่อดูข้อมูล"><i class="bi bi-lock-fill"></i></span>
                              <% } else { %>
                                <span class="badge bg-info-subtle text-info-emphasis">
                                  <%= (a.addmem_saman !== null && a.addmem_saman !== undefined && !isNaN(Number(a.addmem_saman))) ? Number(a.addmem_saman).toLocaleString('th-TH') : '-' %>
                                </span>
                              <% } %>
                            </td>
                            <td data-label="สมทบ">
                              <% if(!user) { %>
                                <span class="text-muted" title="เข้าสู่ระบบเพื่อดูข้อมูล"><i class="bi bi-lock-fill"></i></span>
                              <% } else { %>
                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                  <%= (a.addmem_somtob !== null && a.addmem_somtob !== undefined && !isNaN(Number(a.addmem_somtob))) ? Number(a.addmem_somtob).toLocaleString('th-TH') : '-' %>
                                </span>
                              <% } %>
                            </td>
                            <td data-label="รวมทั้งหมด" class="fw-bold">
                              <% if(!user) { %>
                                <span class="text-muted" title="เข้าสู่ระบบเพื่อดูข้อมูล"><i class="bi bi-lock-fill"></i></span>
                              <% } else { %>
                                <% const saman = Number(a.addmem_saman) || 0; const somtob = Number(a.addmem_somtob) || 0; const total = saman + somtob; %>
                                <span class="badge bg-success-subtle text-success-emphasis">
                                  <%= total.toLocaleString('th-TH') %>
                                </span>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <div class="p-4 text-center text-muted">ไม่มีข้อมูล</div>
                <% } %>
              </div>
            </div>
          </section>
        </div>
        <div class="col-md-6">
          <div class="card meeting-card border-0 shadow-sm mb-2">
            <div class="card-header bg-white">
              <h6 class="mb-0"><i class="bi bi-calendar-check me-2 text-primary"></i>ประวัติการประชุมใหญ่</h6>
            </div>
            <div class="card-body">
              <% if ((data.bigmeetDatesByYear || []).length) { %>
                <div class="row g-3">
                  <% data.bigmeetDatesByYear.forEach((entry) => { %>
                    <div class="col-md-6">
                      <div class="meeting-year border rounded-3 p-3 h-100">
                        <div class="fw-semibold mb-2">ปี <%= entry.year %></div>
                        <ul class="mb-0 ps-3">
                          <% entry.dates.forEach((d) => { %>
                            <li><%= d %></li>
                          <% }) %>
                        </ul>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-muted">ยังไม่มีข้อมูลการประชุมใหญ่</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

        <!-- Strength Section -->
      <section class="section-block" id="strength-section">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent d-flex flex-wrap align-items-center justify-content-between py-2 gap-2">
            <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-graph-up-arrow me-2 text-info"></i>ผลประเมินความเข้มแข็ง</h5>
            <span class="badge bg-info-subtle text-info-emphasis">รวม <%= (data.strength||[]).length %> แถว</span>
          </div>
          <div class="card-body p-0 mobile-scroll">
            <% if (data.strength && data.strength.length) { %>
              <div class="table-responsive mb-0">
                <table class="table table-sm table-hover table-striped align-middle mb-0 text-nowrap responsive-table">
                  <thead class="table-light">
                    <tr>
                      <th>ปี</th>
                      <th>สถาบัน</th>
                      <th class="small-hide">มิติที่ 1</th>
                      <th class="small-hide">มิติที่ 2</th>
                      <th class="small-hide">มิติที่ 3</th>
                      <th class="small-hide">มิติที่ 4</th>
                      <th>รวม</th>
                      <th>ระดับ</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.strength.forEach(s => { %>
                      <tr>
                        <td class="fw-medium" data-label="ปี"><%= s.st_year || '-' %></td>
                        <td data-label="สถาบัน"><%= s.st_fullname || '-' %></td>
                        <% if(!user) { %>
                          <td colspan="5" class="text-muted small">ข้อมูลไม่สามารถแสดงได้ กรุณาเข้าสู่ระบบ</td>
                        <% } else { %>
                          <td class="small-hide" data-label="มิติที่ 1"><%= s.st_no1 || '-' %></td>
                          <td class="small-hide" data-label="มิติที่ 2"><%= s.st_no2 || '-' %></td>
                          <td class="small-hide" data-label="มิติที่ 3"><%= s.st_no3 || '-' %></td>
                          <td class="small-hide" data-label="มิติที่ 4"><%= s.st_no4 || '-' %></td>
                          <td data-label="รวม"><%= (s.st_point !== null && s.st_point !== undefined && !isNaN(Number(s.st_point))) ? Number(s.st_point).toLocaleString('th-TH',{minimumFractionDigits:2}) : '-' %></td>
                        <% } %>
                        <td data-label="ระดับ">
                          <% if (s.st_grade) { %>
                            <span class="p-2 badge bg-<%= s.st_grade==='ชั้น1' ? 'success' : (s.st_grade==='ชั้น2' ? 'warning' : (s.st_grade==='ชั้น3' ? 'danger text-white' : 'secondary')) %>"><%= s.st_grade %></span>
                          <% } else { %>-<% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted">ไม่มีข้อมูล</div>
            <% } %>
          </div>
        </div>
      </section>
      
          <!-- Rules Section -->
      <section class="section-block" id="rules-section">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent d-flex flex-wrap align-items-center justify-content-between py-2 gap-2">
            <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-journal-text me-2 text-warning"></i>ข้อบังคับ</h5>
            <span class="badge bg-warning-subtle text-warning-emphasis">รวม <%= (data.rules||[]).length %> รายการ</span>
          </div>
          <div class="card-body p-0">
            <% if (data.rules && data.rules.length) { %>
              <div class="table-responsive">
                <table class="table table-sm table-hover table-striped align-middle mb-0 responsive-table">
                  <thead class="table-light">
                    <tr>
                      <th style="width:120px">ปี</th>
                      <th>ประเภท</th>
                      <th class="text-center" style="width:80px">ไฟล์</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.rules.forEach(r => { %>
                      <tr>
                        <td class="fw-medium" data-label="ปี"><%= r.rule_year || '-' %></td>
                        <td data-label="ประเภท">
                          <% if (r.rule_type === 'MR') { %>
                            <span class="badge bg-primary-subtle text-primary-emphasis">ข้อบังคับหลัก</span>
                          <% } else if (r.rule_type === 'ER') { %>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">แก้ไขเพิ่มเติม <%= r.er_no || '' %></span>
                          <% } %>
                        </td>
                        <td class="text-center row-actions" data-label="ไฟล์">
                          <% if (user) { %>
                            <% if (r.rule_id) { %>
                              <a class="btn btn-sm btn-outline-warning" href="/rule/<%= r.rule_id %>" target="_blank" aria-label="ดาวน์โหลดข้อบังคับปี <%= r.rule_year %>"><i class="bi bi-download"></i></a>
                            <% } else if (r.rule_file) { %>
                              <a class="btn btn-sm btn-outline-secondary" href="/uploads/rule/<%= r.rule_file %>" target="_blank" rel="noopener" aria-label="เปิดไฟล์ข้อบังคับปี <%= r.rule_year %>"><i class="bi bi-box-arrow-up-right"></i></a>
                            <% } else { %>-<% } %>
                          <% } else { %>
                            <span class="text-muted" title="เข้าสู่ระบบเพื่อดาวน์โหลด"><i class="bi bi-lock-fill"></i></span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted">ไม่มีข้อมูล</div>
            <% } %>
          </div>
        </div>
      </section>
    
      <!-- Rabiab Section -->
      <section class="section-block" id="rabiab-section">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent d-flex flex-wrap align-items-center justify-content-between py-2 gap-2">
            <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-file-earmark-medical me-2 text-secondary"></i>ระเบียบสหกรณ์</h5>
            <span class="badge bg-secondary-subtle text-secondary-emphasis">รวม <%= (data.rabiab||[]).length %> รายการ</span>
          </div>
          <div class="card-body p-0">
            <% if (data.rabiab && data.rabiab.length) { %>
              <div class="table-responsive">
                <table class="table table-sm table-hover table-striped align-middle mb-0 responsive-table">
                  <thead class="table-light">
                    <tr>
                      <th style="width:100px">ปี</th>
                      <th>ชื่อ</th>
                      <th>วันที่อนุมัติ</th>
                      <th class="text-center" style="width:80px">ไฟล์</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.rabiab.forEach(r => { %>
                      <tr>
                        <td class="fw-medium" data-label="ปี"><%= r.ra_year || '-' %></td>
                        <td data-label="ชื่อ"><%= r.ra_name || '-' %></td>
                        <td data-label="วันที่อนุมัติ"><%= r.ra_approvedate ? new Date(r.ra_approvedate).toLocaleDateString('th-TH') : '-' %></td>
                        <td class="text-center row-actions" data-label="ไฟล์">
                          <% if (user) { %>
                            <% if (r.ra_id) { %>
                              <a class="btn btn-sm btn-outline-secondary" href="/rabiab/download/<%= r.ra_id %>" target="_blank" aria-label="ดาวน์โหลดระเบียบปี <%= r.ra_year %>"><i class="bi bi-download"></i></a>
                            <% } else if (r.ra_filename) { %>
                              <a class="btn btn-sm btn-outline-secondary" href="/uploads/rabiab/<%= r.ra_filename %>" target="_blank" rel="noopener" aria-label="เปิดไฟล์ระเบียบปี <%= r.ra_year %>"><i class="bi bi-box-arrow-up-right"></i></a>
                            <% } else { %>-<% } %>
                          <% } else { %>
                            <span class="text-muted" title="เข้าสู่ระบบเพื่อดาวน์โหลด"><i class="bi bi-lock-fill"></i></span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
