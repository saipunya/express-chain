<%- include('partials/head') %>
<nav class="breadcrumb-line"><a href="/debt/cdf">หนี้ กพส.</a><i class="bi bi-chevron-right"></i><a href="/debt/cdf/cooperatives/<%= contract.coop_id %>"><%= contract.c_name %></a><i class="bi bi-chevron-right"></i><span><%= contract.contract_no %></span></nav>
<% if (query.saved) { %><div class="alert alert-success"><i class="bi bi-check-circle"></i> บันทึกการติดตามเรียบร้อยแล้ว</div><% } %>
<section class="profile-strip mb-4"><div><%- include('partials/risk-badge',{risk:contract.risk_color}) %><h2 class="mt-2">สัญญา <%= contract.contract_no %></h2><p><%= contract.c_name %> • <%= contract.purpose || 'ไม่ระบุวัตถุประสงค์' %></p></div><div class="officer-card"><small>เจ้าหน้าที่รับผิดชอบ</small><strong><%= contract.responsible_officer || '-' %></strong><span>สถานะสัญญา: <%= contract.lifecycle_status %></span></div></section>
<div class="detail-grid mb-4">
  <div class="metric"><span>วงเงินตามสัญญา</span><strong><%= debtMoney(contract.contract_amount) %></strong><small>บาท</small></div>
  <div class="metric"><span>เงินต้นคงเหลือ</span><strong><%= debtMoney(contract.latest_principal_balance) %></strong><small>บาท</small></div>
  <div class="metric"><span>ดอกเบี้ยค้าง</span><strong><%= debtMoney(contract.latest_interest_outstanding) %></strong><small>บาท</small></div>
  <div class="metric"><span>กำหนดชำระถัดไป</span><strong class="date-value"><%= debtDate(contract.next_due_date || contract.maturity_date) %></strong><small><%= contract.days_to_due == null ? '-' : `${contract.days_to_due} วัน` %></small></div>
</div>
<div class="row g-4">
  <div class="col-xl-7">
    <% if (issues.length) { %><section class="panel warning-panel mb-4"><div class="panel-head"><h2><i class="bi bi-exclamation-triangle"></i> ประเด็นคุณภาพข้อมูล</h2></div><ul class="quality-list"><% issues.forEach((x)=>{ %><li><span class="severity <%= x.severity.toLowerCase() %>"><%= x.severity %></span><div><strong><%= x.issue_code %></strong><p><%= x.issue_detail %></p></div></li><% }) %></ul></section><% } %>
    <section class="panel"><div class="panel-head"><h2>Timeline การติดตาม</h2></div><% if (!actions.length) { %><div class="empty-state"><i class="bi bi-clock-history"></i><p>ยังไม่มีประวัติการติดตาม</p></div><% } else { %><ol class="timeline"><% actions.forEach((x)=>{ %><li><div class="timeline-date"><%= debtDate(x.action_date || x.planned_date) %></div><div><strong><%= x.action_type %> · <%= x.action_status %></strong><p><%= x.result_note || 'ไม่มีบันทึกเพิ่มเติม' %></p><small>ติดตามครั้งถัดไป <%= debtDate(x.next_follow_up_date) %></small></div></li><% }) %></ol><% } %></section>
  </div>
  <div class="col-xl-5"><section class="panel sticky-panel"><div class="panel-head"><h2>บันทึกการติดตาม</h2></div><form method="post" action="/debt/cdf/contracts/<%= contract.contract_id %>/followups" class="followup-form"><input type="hidden" name="_csrf" value="<%= debtCsrfToken %>"><label>วันที่ดำเนินการ<input required type="date" name="action_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control"></label><label>ประเภท<select name="action_type" class="form-select"><option value="FOLLOW_UP">ติดตามทั่วไป</option><option value="PHONE">โทรศัพท์</option><option value="LETTER">หนังสือ</option><option value="FIELD_VISIT">ลงพื้นที่</option><option value="FUND_USE_INSPECTION">ตรวจการใช้เงินกู้</option><option value="DEBT_WARNING">แจ้งเตือนหนี้</option><option value="RESTRUCTURE">ปรับโครงสร้าง</option><option value="OTHER">อื่น ๆ</option></select></label><label>ผลการติดตาม<textarea name="result_note" rows="4" class="form-control" maxlength="4000"></textarea></label><label>ติดตามครั้งถัดไป<input type="date" name="next_follow_up_date" class="form-control"></label><input type="hidden" name="followup_status" value="COMPLETED"><button class="btn btn-navy w-100"><i class="bi bi-save"></i> บันทึกการติดตาม</button></form></section></div>
</div>
<section class="panel mt-4"><div class="panel-head"><h2>กำหนดชำระ</h2></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>วันที่</th><th>สถานะ</th><th class="text-end">เงินต้น</th><th class="text-end">ดอกเบี้ย</th><th class="text-end">ค่าปรับ</th></tr></thead><tbody><% schedules.forEach((x)=>{ %><tr><td><%= debtDate(x.due_date) %></td><td><%= x.schedule_status %></td><td class="text-end"><%= debtMoney(x.principal_due) %></td><td class="text-end"><%= debtMoney(x.interest_due) %></td><td class="text-end"><%= debtMoney(x.penalty_due) %></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/foot') %>
