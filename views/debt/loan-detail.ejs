<%- include('partials/head') %>
<nav class="breadcrumb-line"><a href="/debt/member-debt">หนี้สมาชิก</a><i class="bi bi-chevron-right"></i><a href="/debt/member-debt/cooperatives/<%= loan.coop_id %>"><%= loan.c_name %></a><i class="bi bi-chevron-right"></i><a href="/debt/member-debt/members/<%= loan.member_id %>"><%= loan.display_name %></a><i class="bi bi-chevron-right"></i><span><%= loan.loan_no %></span></nav>
<% if (query.saved) { %><div class="alert alert-success"><i class="bi bi-check-circle"></i> บันทึกการติดตามเรียบร้อยแล้ว</div><% } %>
<section class="profile-strip mb-4"><div><%- include('partials/risk-badge',{risk:loan.risk_color}) %> <span class="demo-pill"><%= loan.demo_flag ? 'DEMO' : '' %></span><h2 class="mt-2">สัญญา <%= loan.loan_no %></h2><p><%= loan.display_name %> (<%= loan.member_no %>) • <%= loan.loan_type || '-' %></p></div><div class="officer-card"><small>เหตุผลที่ต้องสนใจ</small><strong><%= loan.attention_reason %></strong><span>ติดตามล่าสุด: <%= debtDate(loan.last_followup_date) %></span></div></section>
<div class="detail-grid mb-4"><div class="metric"><span>เงินต้นคงเหลือ</span><strong><%= debtMoney(loan.principal_balance) %></strong><small>บาท</small></div><div class="metric"><span>ยอดค้างรวม</span><strong><%= debtMoney(loan.total_overdue) %></strong><small>บาท</small></div><div class="metric"><span>ค้างชำระ</span><strong><%= debtNumber(loan.days_past_due) %></strong><small>วัน / <%= loan.overdue_installments %> งวด</small></div><div class="metric"><span>กำหนดงวดถัดไป</span><strong class="date-value"><%= debtDate(loan.next_due_date) %></strong><small>ครบสัญญา <%= debtDate(loan.maturity_date) %></small></div></div>
<div class="row g-4"><div class="col-xl-7">
  <section class="panel mb-4"><div class="panel-head"><h2>Timeline การติดตาม</h2></div><% if(!followups.length){ %><div class="empty-state"><i class="bi bi-chat-left-text"></i><p>ยังไม่มีประวัติการติดตาม</p></div><% }else{ %><ol class="timeline"><% followups.forEach((x)=>{ %><li><div class="timeline-date"><%= debtDate(x.action_date) %></div><div><strong><%= x.action_type %> · <%= x.followup_status %></strong><p><%= x.result_note || 'ไม่มีบันทึกเพิ่มเติม' %></p><small><% if(x.promised_amount){ %>คำมั่นชำระ <%= debtMoney(x.promised_amount) %> บาท ภายใน <%= debtDate(x.promise_date) %> • <% } %>ติดตามครั้งถัดไป <%= debtDate(x.next_follow_up_date) %></small></div></li><% }) %></ol><% } %></section>
  <section class="panel"><div class="panel-head"><h2>ประวัติการชำระ</h2></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>วันที่</th><th>ใบเสร็จ</th><th class="text-end">เงินต้น</th><th class="text-end">ดอกเบี้ย</th><th class="text-end">ค่าปรับ</th></tr></thead><tbody><% payments.forEach((x)=>{ %><tr><td><%= debtDate(x.payment_date) %></td><td><%= x.receipt_no || '-' %></td><td class="text-end"><%= debtMoney(x.principal_paid) %></td><td class="text-end"><%= debtMoney(x.interest_paid) %></td><td class="text-end"><%= debtMoney(x.penalty_paid) %></td></tr><% }) %></tbody></table></div></section>
  </div><div class="col-xl-5"><section class="panel sticky-panel"><div class="panel-head"><h2>บันทึกการติดตามใหม่</h2></div><p class="small text-muted">ตรวจ Timeline เดิมทางซ้ายก่อนบันทึกรายการใหม่</p><form method="post" action="/debt/member-debt/loans/<%= loan.loan_id %>/followups" class="followup-form"><input type="hidden" name="_csrf" value="<%= debtCsrfToken %>"><label>วันที่ดำเนินการ<input required type="date" name="action_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control"></label><label>ประเภท<select name="action_type" class="form-select"><option value="PHONE">โทรศัพท์</option><option value="LETTER">หนังสือ</option><option value="FIELD_VISIT">ลงพื้นที่</option><option value="MEETING">ประชุม</option><option value="RESTRUCTURE">ปรับโครงสร้าง</option><option value="LEGAL">กฎหมาย</option><option value="OTHER">อื่น ๆ</option></select></label><label>ผลการติดตาม<textarea name="result_note" rows="4" maxlength="4000" class="form-control"></textarea></label><div class="row g-2"><div class="col-6"><label>วันที่สัญญาชำระ<input type="date" name="promise_date" class="form-control"></label></div><div class="col-6"><label>จำนวนเงิน<input type="number" min="0" step="0.01" name="promised_amount" class="form-control"></label></div></div><label>ติดตามครั้งถัดไป<input type="date" name="next_follow_up_date" class="form-control"></label><input type="hidden" name="followup_status" value="OPEN"><button class="btn btn-navy w-100"><i class="bi bi-save"></i> บันทึกการติดตาม</button></form></section></div></div>
<section class="panel mt-4"><div class="panel-head"><h2>ประวัติ Snapshot หนี้</h2></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>ข้อมูล ณ วันที่</th><th class="text-end">เงินต้นคงเหลือ</th><th class="text-end">ยอดค้างรวม</th><th class="text-end">จำนวนงวดค้าง</th><th class="text-end">วันค้างชำระ</th></tr></thead><tbody><% snapshots.forEach((x)=>{ const overdue=Number(x.overdue_principal)+Number(x.overdue_interest)+Number(x.overdue_penalty); %><tr><td><%= debtDate(x.snapshot_date) %></td><td class="text-end"><%= debtMoney(x.principal_balance) %></td><td class="text-end"><%= debtMoney(overdue) %></td><td class="text-end"><%= x.overdue_installments %></td><td class="text-end"><%= x.days_past_due %></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/foot') %>
