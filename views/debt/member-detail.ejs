<%- include('partials/head') %>
<nav class="breadcrumb-line"><a href="/debt/member-debt">หนี้สมาชิก</a><i class="bi bi-chevron-right"></i><a href="/debt/member-debt/cooperatives/<%= member.coop_id %>"><%= member.c_name %></a><i class="bi bi-chevron-right"></i><span><%= member.display_name %></span></nav>
<section class="profile-strip mb-4"><div><span class="demo-pill"><%= member.demo_flag ? 'DEMO DATA' : 'ข้อมูลจริง' %></span><h2><%= member.display_name %></h2><p>เลขสมาชิก <%= member.member_no %> • <%= member.member_group || 'ไม่ระบุกลุ่ม' %></p></div><div class="officer-card"><small>สหกรณ์เจ้าหนี้</small><strong><%= member.c_name %></strong><span>เจ้าหน้าที่รับผิดชอบ: <%= member.responsible_officer || '-' %></span></div></section>
<section class="panel"><div class="panel-head"><h2>สัญญาเงินกู้</h2><span class="text-muted"><%= loans.length %> สัญญา</span></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>ระดับ</th><th>เลขที่สัญญา</th><th>ประเภท</th><th class="text-end">ยอดคงเหลือ</th><th class="text-end">ยอดค้าง</th><th>ครบกำหนด</th><th></th></tr></thead><tbody><% loans.forEach((x)=>{ %><tr><td><%- include('partials/risk-badge',{risk:x.risk_color}) %></td><td><strong><%= x.loan_no %></strong></td><td><%= x.loan_type || '-' %></td><td class="text-end"><%= debtMoney(x.principal_balance) %></td><td class="text-end"><%= debtMoney(x.total_overdue) %></td><td><%= debtDate(x.maturity_date) %></td><td><a class="btn btn-sm btn-light" href="/debt/member-debt/loans/<%= x.loan_id %>">เปิดสัญญา</a></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/foot') %>
