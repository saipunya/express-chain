<%- include('../partials/header.ejs', { title: title || 'รายละเอียดข้อสังเกต' }) %>
<%
  const categoriesList = (item && item.categories) || [];
  const actions = (item && item.actions) || [];
  const categoryItems = categoriesList.map((cat) => {
    const name = String(cat.name || '').trim();
    const shortName = name.length > 30 ? `${name.slice(0, 30).trimEnd()}…` : name;
    return { id: cat.id, name, shortName };
  });
  const actionTypeLabel = (value) => {
    if (value === 'follow_up') return 'หนังสือติดตาม';
    if (value === 'order') return 'หนังสือสั่งการ';
    if (value === 'advice') return 'หนังสือคำแนะนำ';
    if (value === 'fact_check') return 'หนังสือตรวจข้อเท็จจริง';
    if (value === 'close') return 'หนังสือปิดเรื่อง';
    return value || '-';
  };
  const severityLabel = {
    serious_order: 'ร้ายแรง / คำสั่ง',
    advice: 'คำแนะนำ',
    fact_check: 'ตรวจข้อเท็จจริง'
  }[item?.severity_case] || '-';
  const observationTitle = item?.observation_title || (item?.observation_text ? item.observation_text.slice(0, 120) : '-');
  const statusLabel = ({new:'ใหม่', in_progress:'กำลังดำเนินการ', monitoring:'ติดตาม', resolved:'ปิดแล้ว', closed:'ยุติ'})[item?.status] || '-';
  const fmtMoney = (value) => new Intl.NumberFormat('th-TH', { maximumFractionDigits: 2 }).format(Number(value || 0));
%>

<link rel="stylesheet" href="/css/sangket-view.css">
<link rel="stylesheet" href="/css/sangket.css">

<div class="sangket-view-page py-3 sangket-workspace">
  <div class="container">
    <%- include('navigation', { current: 'view', pageLabel: 'รายละเอียดข้อสังเกต' }) %>
    <div class="view-shell">
      <div class="view-hero p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
          <div>

            <h1 class="h3 fw-bold mb-2"><%= item.cooperative_name %></h1>
            <div class="text-dark fw-semibold mb-2"><%= observationTitle %></div>
            <p class="text-muted mb-0">
              <i class="bi bi-hash me-1"></i><%= item.cooperative_code || '-' %> |
              <%= item.fiscal_year_end || '-' %> | หนังสือ <%= item.audit_office_letter_no || '-' %>
            </p>
          </div>
          <div class="d-flex flex-wrap gap-2 align-items-start">
            <a href="/sangket/edit/<%= item.observation_id %>" class="btn btn-warning rounded-3">
              <i class="bi bi-pencil-square me-1"></i> แก้ไข
            </a>
            <a href="/sangket/cooperatives/<%= item.cooperative_id %>" class="btn btn-outline-secondary rounded-3">
              <i class="bi bi-arrow-left-circle me-1"></i> ข้อสังเกตของสถาบัน
            </a>
          </div>
        </div>
      </div>

      <div class="p-3 p-lg-4">
        <div class="row g-3 mb-4">
          <div class="col-6 col-lg-3">
            <div class="detail-card">
              <div class="detail-label">ประเภท</div>
              <div class="detail-value"><%= item.coop_type === 'group_farmer' ? 'กลุ่มเกษตรกร' : 'สหกรณ์' %></div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="detail-card">
              <div class="detail-label">กสส.</div>
              <div class="detail-value"><%= item.promotion_group_no || '-' %></div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="detail-card">
              <div class="detail-label">กรณี</div>
              <div class="detail-value"><%= severityLabel %></div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="detail-card">
              <div class="detail-label">สถานะ</div>
              <div class="detail-value"><span class="badge text-bg-primary"><%= statusLabel %></span></div>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-lg-8">
            <div class="detail-card h-100">
              <div class="detail-label mb-2">หัวข้อข้อสังเกต</div>
              <div class="detail-value mb-3"><%= observationTitle %></div>
              <div class="detail-label mb-2">รายละเอียดข้อสังเกต</div>
              <div class="detail-value" style="white-space: pre-line; line-height: 1.7;"><%= item.observation_text || '-' %></div>
              <hr>
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="detail-label">มูลค่าความเสียหาย</div>
                  <div class="detail-value"><%= item.potential_damage_amount ? fmtMoney(item.potential_damage_amount) + ' บาท' : '-' %></div>
                </div>
                <div class="col-md-4">
                  <div class="detail-label">ลำดับข้อ</div>
                  <div class="detail-value"><%= item.observation_no || '-' %></div>
                </div>
                <div class="col-md-4">
                  <div class="detail-label">กำหนดติดตาม</div>
                  <div class="detail-value"><%= item.due_date || '-' %></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="detail-card h-100">
              <div class="detail-label mb-2">หมวดข้อสังเกต</div>
              <div class="category-grid mb-3">
                <% if (categoryItems.length) { %>
                  <% categoryItems.forEach((cat) => { %>
                    <span class="badge text-bg-light border badge-soft category-pill" title="<%= cat.name %>">
                      <span class="fw-semibold">#<%= cat.id %></span>
                      <span class="text-muted">-</span>
                      <%= cat.name || '-' %>
                    </span>
                  <% }) %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </div>
              <% if (categoryItems.length) { %>
                <div class="mini-note mt-2"></div>
              <% } %>
              <div class="mini-note">ผู้สอบบัญชี: <%= item.auditor_name || '-' %></div>
              <div class="mini-note">หนังสือรับ: <%= item.received_date || '-' %></div>
              <div class="mini-note">วันที่หนังสือ: <%= item.audit_office_letter_date || '-' %></div>
              <div class="mini-note">แหล่งข้อมูล: <%= item.source_sheet || '-' %> แถว <%= item.source_row || '-' %></div>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-lg-7">
            <div class="detail-card">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 fw-bold">หนังสือจากนายทะเบียนสหกรณ์</h5>
                <span class="badge text-bg-success"><%= actions.length %> รายการ</span>
              </div>
              <% if (actions.length) { %>
                <div class="d-grid gap-3">
                  <% actions.forEach((action) => { %>
                    <div class="timeline-item">
                      <div class="d-flex justify-content-between gap-3">
                        <div class="fw-semibold"><%= actionTypeLabel(action.action_type) %></div>
                        <div class="d-flex align-items-start gap-2">
                          <div class="text-muted small"><%= action.created_at ? new Date(action.created_at).toLocaleString('th-TH') : '' %></div>
                          <form method="POST" action="/sangket/view/<%= item.observation_id %>/actions/<%= action.id %>/delete" onsubmit="return confirm('ต้องการลบหนังสือรายการนี้ใช่ไหม');">
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="ลบหนังสือ" aria-label="ลบหนังสือ">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        </div>
                      </div>
                      <div class="small text-muted">
                        <i class="bi bi-journal-text me-1"></i>เลขที่ <%= action.letter_no || '-' %>
                        <% if (action.letter_date) { %> | <%= action.letter_date %><% } %>
                      </div>
                      <div class="mt-1" style="white-space: pre-line;"><%= action.action_detail || '-' %></div>
                      <% if (action.result) { %>
                        <div class="mt-1 text-success" style="white-space: pre-line;"><%= action.result %></div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-muted">ยังไม่มีการบันทึกหนังสือจากนายทะเบียนสหกรณ์</div>
              <% } %>
            </div>
          </div>

          <div class="col-lg-5">
            <details class="action-box sangket-disclosure p-3">
              <summary>เพิ่มหนังสือ / ผลการติดตาม</summary>
              <form method="POST" action="/sangket/view/<%= item.observation_id %>/actions" class="row g-3">
                <div class="col-12">
                  <label class="form-label" for="sangket-view-field-1">ประเภทหนังสือ</label>
                  <select name="action_type" class="form-select" id="sangket-view-field-1">
                    <option value="follow_up">หนังสือติดตาม</option>
                    <option value="order">หนังสือสั่งการ</option>
                    <option value="advice">หนังสือคำแนะนำ</option>
                    <option value="fact_check">หนังสือตรวจข้อเท็จจริง</option>
                    <option value="close">หนังสือปิดเรื่อง</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label" for="sangket-view-field-2">เลขที่หนังสือ</label>
                  <input type="text" name="letter_no" class="form-control" id="sangket-view-field-2">
                </div>
                <div class="col-12">
                  <label class="form-label" for="sangket-view-field-3">วันที่หนังสือ</label>
                  <input type="text" name="letter_date" class="form-control" placeholder="เช่น 30 เม.ย. 69" id="sangket-view-field-3">
                </div>
                <div class="col-12">
                  <label class="form-label" for="sangket-view-field-4">เรื่อง/สาระสำคัญที่เกี่ยวกับข้อสังเกตนี้</label>
                  <textarea name="action_detail" class="form-control" rows="4" id="sangket-view-field-4"></textarea>
                </div>
                <div class="col-12">
                  <label class="form-label" for="sangket-view-field-5">หมายเหตุ/ผลการดำเนินการ</label>
                  <textarea name="result" class="form-control" rows="3" id="sangket-view-field-5"></textarea>
                </div>
                <div class="col-12 d-grid">
                  <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send-check me-1"></i> บันทึกหนังสือ
                  </button>
                </div>
              </form>
            </details>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
