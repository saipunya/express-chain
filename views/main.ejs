<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'หน้าแรกระบบ CoopChain' %></title>
    <% if (typeof themeColor !== 'undefined' && themeColor) { %>
      <meta name="theme-color" content="<%= themeColor %>" />
    <% } %>
    <% if (typeof manifestPath !== 'undefined' && manifestPath) { %>
      <link rel="manifest" href="<%= manifestPath %>" />
      <link rel="icon" href="/icon/seal.svg" />
      <link rel="apple-touch-icon" href="/icon/seal.svg" />
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-title" content="CoopChain" />
      <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <% } %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@200;400;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  </head>
  <body class="main-dashboard-body d-flex flex-column min-vh-100 flex-grow-1">
    <main class="container-fluid main-dashboard-wrap py-3 py-lg-4 flex-grow-1">



<%
  const _unavailable = typeof mainUnavailable !== 'undefined' ? mainUnavailable : {};
  const _institutionSummary = (typeof institutionSummary !== 'undefined' && institutionSummary) ? institutionSummary : {
    agri: { key: 'agri', label: 'สหกรณ์ภาคการเกษตร', shortLabel: 'ภาคการเกษตร', icon: 'bi-flower1', tone: 'green', count: 0, rows: [] },
    non_agri: { key: 'non_agri', label: 'สหกรณ์นอกภาค', shortLabel: 'นอกภาค', icon: 'bi-buildings', tone: 'teal', count: 0, rows: [] },
    farmer: { key: 'farmer', label: 'กลุ่มเกษตรกร', shortLabel: 'กลุ่มเกษตรกร', icon: 'bi-people', tone: 'amber', count: 0, rows: [] }
  };
  const _institutionSummaryList = ['agri', 'non_agri', 'farmer'].map((key) => _institutionSummary[key]).filter(Boolean);
  const _institutionTotal = _institutionSummaryList.reduce((sum, item) => sum + Number(item.count || 0), 0);
  const _institutionDistrictSummary = (typeof institutionDistrictSummary !== 'undefined' && institutionDistrictSummary)
    ? institutionDistrictSummary : { rows: [], totals: { cooperatives: 0, farmerGroups: 0, total: 0 }, unknownTotal: 0 };
  const _institutionDistrictUnavailable = typeof institutionDistrictUnavailable !== 'undefined' && institutionDistrictUnavailable === true;
  const _mapSafeUrl = (value) => {
    try {
      const url = new URL(String(value || ''));
      return ['https:', 'http:'].includes(url.protocol) ? url.href : '';
    } catch (_) { return ''; }
  };
  const _cooperativeMapLocations = (typeof cooperativeMapLocations !== 'undefined' && Array.isArray(cooperativeMapLocations))
    ? cooperativeMapLocations.filter(Boolean).map((item) => ({
        code: String(item.code || item.c_code || ''),
        name: String(item.name || item.c_name || 'ไม่ระบุชื่อ'),
        type: ['agri', 'non_agri', 'farmer'].includes(String(item.type || '')) ? String(item.type) : 'agri',
        district: String(item.district || item.c_amp || '').trim(),
        address: String(item.address || item.address_text || ''),
        latitude: Number(item.latitude),
        longitude: Number(item.longitude),
        websiteUrl: _mapSafeUrl(item.websiteUrl || item.website_url),
        googleMapsUrl: _mapSafeUrl(item.googleMapsUrl || item.google_maps_url)
      })).filter((item) => Number.isFinite(item.latitude) && Number.isFinite(item.longitude)
        && item.latitude >= 14.8 && item.latitude <= 17 && item.longitude >= 101 && item.longitude <= 103)
    : [];
  const _cooperativeMapDistricts = [...new Set(_cooperativeMapLocations.map((item) => item.district).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'th'));
  const _cooperativeMapTypeLabels = { agri: 'สหกรณ์ภาคการเกษตร', non_agri: 'สหกรณ์นอกภาคการเกษตร', farmer: 'กลุ่มเกษตรกร' };
  const _cooperativeMapUnavailable = typeof cooperativeMapUnavailable !== 'undefined' && cooperativeMapUnavailable === true;
  const _cooperativeMapIsDemo = typeof cooperativeMapIsDemo !== 'undefined' && cooperativeMapIsDemo === true;
  const _cooperativeMapJson = JSON.stringify(_cooperativeMapLocations).replace(/</g, '\\u003c');
  const _onlineUsers = (typeof onlineUsers !== 'undefined' && Array.isArray(onlineUsers)) ? onlineUsers : [];
  const _onlineCount = Number((typeof onlineCount !== 'undefined' && onlineCount !== null) ? onlineCount : _onlineUsers.length);
  const _mainDownloads = (typeof mainDownloads !== 'undefined' && Array.isArray(mainDownloads)) ? mainDownloads : [];
  const _currentUser = (typeof user !== 'undefined' && user) ? user : null;
  const _currentUserGroup = String((_currentUser && (_currentUser.group || _currentUser.m_group)) || '').trim().toLowerCase();
  const _currentUserClass = String((_currentUser && (_currentUser.mClass || _currentUser.m_class)) || '').trim().toLowerCase();
  const _isInstitutionUser = ['coop', 'group'].includes(_currentUserGroup) || ['c', 'g'].includes(_currentUserClass);
  const _canManageCooperativeLocations = _currentUser && !_isInstitutionUser
    && [_currentUser.mClass, _currentUser.m_class, _currentUser.level].some((level) => ['admin', 'pbt'].includes(String(level || '').trim()));
  const _dashboardPath = _isInstitutionUser ? '/dashboard2' : '/dashboard';
  const _displayName = (_currentUser && (_currentUser.fullname || _currentUser.m_name || _currentUser.username || _currentUser.m_user)) || '';
  const _displayPosition = (_currentUser && (_currentUser.position || _currentUser.m_position)) || '';
  const _avatarLabel = _displayName ? _displayName.trim().slice(0, 2).toUpperCase() : 'CC';
  const _institutionChartData = _institutionSummaryList.map((item) => ({
    key: item.key,
    label: item.label,
    count: Number(item.count || 0),
    color: item.key === 'non_agri' ? '#147b83' : item.key === 'farmer' ? '#f0a020' : '#107f50'
  }));
  const _turnoverCategorySummary = (typeof turnoverCategorySummary !== 'undefined' && turnoverCategorySummary) ? turnoverCategorySummary : {
    latestBudYear: 0,
    latestBudYearThai: '',
    totalAmount: 0,
    list: []
  };
  const _turnoverCategoryList = Array.isArray(_turnoverCategorySummary.list) ? _turnoverCategorySummary.list : [];
  const _turnoverTotalAmount = Number(_turnoverCategorySummary.totalAmount || 0);
  const _formatTurnoverAmount = (value) => {
    const amount = Number(value || 0);
    if (amount >= 1000000) return `${(amount / 1000000).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ล้านบาท`;
    return `${amount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} บาท`;
  };
  const _strengthGradeSummary = (typeof strengthGradeSummary !== 'undefined' && strengthGradeSummary) ? strengthGradeSummary : {
    year: 0,
    list: [],
    totals: { total: 0, grade1: 0, grade2: 0, grade3: 0 }
  };
  const _strengthGradeList = Array.isArray(_strengthGradeSummary.list) ? _strengthGradeSummary.list : [];
  const _strengthGradeTotals = _strengthGradeSummary.totals || { total: 0, grade1: 0, grade2: 0, grade3: 0 };
  const _chamraSummary = (typeof chamraSummary !== 'undefined' && chamraSummary) ? chamraSummary : {
    total: 0,
    inProgress: 0,
    withdrawn: 0,
    noProcess: 0,
    completionPercent: 0,
    cooperativeCount: 0,
    farmerGroupCount: 0,
    latestUpdateThai: '',
    steps: []
  };
  const _chamraSteps = Array.isArray(_chamraSummary.steps) ? _chamraSummary.steps : [];
%>

<div class="main-dashboard-shell">
  <aside class="main-sidebar d-flex flex-column">
    <div class="main-brand">
      <img src="/icon/seal.svg" alt="CoopChain">
      <div>
        <p class="main-brand-title">CoopChain</p>
        <div class="main-brand-subtitle">สำนักงานสหกรณ์จังหวัดชัยภูมิ</div>
      </div>
    </div>

    <button class="btn btn-outline-success d-xl-none mt-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-expanded="false" aria-controls="mainNavigation">เมนูหลัก <i class="bi bi-list" aria-hidden="true"></i></button>
    <div class="collapse d-xl-block" id="mainNavigation"><nav class="main-nav" aria-label="เมนูหลัก">
      <a href="/main" class="main-nav-link active" aria-current="page">
        <i class="bi bi-grid-1x2-fill"></i>
        <span>หน้าแรก</span>
      </a>
      <a href="/loan-limit" class="main-nav-link">
        <i class="bi bi-calculator" aria-hidden="true"></i>
        <span>การคำนวณวงเงินกู้ยืมหรือค้ำประกัน</span>
      </a>
      <a href="https://script.google.com/macros/s/AKfycbwTSFIYJuOKzGlERx9xw0L6sBnvKbtjrGkyNldJrwJLhUh4IfEpuyib2hacXFMvTr06BQ/exec" class="main-nav-link" target="_blank" rel="noopener noreferrer">
        <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
        <span>ระบบลาออนไลน์<span class="visually-hidden"> (เปิดหน้าต่างใหม่)</span></span>
      </a>
      <a href="/chamra" class="main-nav-link">
        <i class="bi bi-circle-fill"></i>
        <span>งานชำระบัญชี</span>
      </a>


    </nav></div>
    <div class="main-header-actions">
      <% if (!_currentUser) { %>
      <button type="button" class="btn btn-success main-login-menu" data-bs-toggle="modal" data-bs-target="#mainLoginModal">
        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
        <span>เข้าสู่ระบบ</span>
      </button>
      <% } else { %>
      <a href="<%= _dashboardPath %>" class="btn btn-outline-success btn-sm">
        <i class="bi bi-speedometer2" aria-hidden="true"></i><span>ไปหน้าทำงาน</span>
      </a>
      <a href="/auth/logout" class="btn btn-outline-success btn-sm">
        <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>ออกจากระบบ</span>
      </a>
      <% } %>
    </div>

  </aside>

  <section class="main-content main-compact-layout">
    <div class="main-topbar">
      <div>
        <div class="text-muted small">หน้าหลัก CoopChain</div>
        <h1 class="h4 fw-bold mb-0">ระบบสารสนเทศและเครือข่ายสหกรณ์</h1>
      </div>
      <div class="d-flex align-items-center gap-3">
        <span class="main-pill d-none d-lg-inline-flex">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span><%= _currentUser ? 'อยู่ในระบบแล้ว' : (_unavailable.institutions ? 'ข้อมูลสถาบันไม่พร้อมใช้งาน' : `${_institutionTotal} สถาบัน`) %></span>
        </span>
        <div class="main-avatar"><%= _avatarLabel %></div>
      </div>
    </div>

    <section class="main-institution-section main-wide-section" id="cooperativeMapSection" aria-labelledby="cooperativeMapTitle" data-unavailable="<%= _cooperativeMapUnavailable %>">
      <div class="main-coop-map-card">
        <div class="main-coop-map-head">
          <div class="main-coop-map-title">
            <span class="main-coop-map-title-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
            <div>
              <h2 id="cooperativeMapTitle">แผนที่สหกรณ์และกลุ่มเกษตรกรในจังหวัดชัยภูมิ</h2>
              <div class="text-muted small">
                ค้นหาสถาบัน แล้วเลือกจุดบนแผนที่เพื่อดูที่ตั้งและเส้นทาง
                <% if (_cooperativeMapIsDemo) { %><span class="badge text-bg-warning ms-1">ข้อมูลตัวอย่าง</span><% } %>
              </div>
            </div>
          </div>
          <% if (_canManageCooperativeLocations) { %>
            <a href="/cooperative-locations" class="btn btn-outline-success btn-sm text-nowrap"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>จัดการพิกัด</a>
          <% } %>
        </div>
        <div class="main-coop-map-tools">
          <div class="main-coop-map-search">
            <label for="cooperativeMapSearch">ค้นหาสหกรณ์หรือกลุ่มเกษตรกร</label>
            <input id="cooperativeMapSearch" class="form-control" type="search" placeholder="ชื่อ รหัส หรือที่อยู่" maxlength="100" aria-controls="cooperativeMapList" disabled>
          </div>
          <div class="main-coop-map-district">
            <label for="cooperativeMapDistrict">อำเภอ</label>
            <select id="cooperativeMapDistrict" class="form-select" aria-controls="cooperativeMapList" disabled>
              <option value="">ทุกอำเภอ</option>
              <% _cooperativeMapDistricts.forEach(function(district) { %>
                <option value="<%= district %>"><%= district %></option>
              <% }); %>
            </select>
          </div>
          <button type="button" id="cooperativeMapReset" class="btn btn-outline-secondary" disabled><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>ดูทั้งหมด</button>
          <div class="main-coop-map-filters" role="group" aria-label="กรองประเภทสถาบัน">
            <button type="button" class="main-coop-map-filter active" data-map-filter="all" aria-pressed="true" disabled>ทั้งหมด</button>
            <% Object.entries(_cooperativeMapTypeLabels).forEach(function([type, label]) { %>
              <button type="button" class="main-coop-map-filter" data-map-filter="<%= type %>" aria-pressed="false" disabled><%= label %></button>
            <% }); %>
          </div>
        </div>
        <% if (_cooperativeMapUnavailable) { %>
          <div class="main-coop-map-notice" role="status">ไม่สามารถโหลดข้อมูลที่ตั้งได้ในขณะนี้ กรุณาลองใหม่ภายหลัง</div>
        <% } %>
        <div id="cooperativeMapTileError" class="main-coop-map-notice" role="status" hidden>โหลดภาพแผนที่ไม่สำเร็จ สามารถดูรายชื่อและเปิดเส้นทางผ่าน Google Maps ด้านล่างได้</div>
        <noscript><div class="main-coop-map-notice">เปิด JavaScript เพื่อใช้แผนที่และตัวกรอง หรือเปิด Google Maps จากรายชื่อด้านล่าง</div></noscript>
        <div class="main-coop-map-layout">
          <div class="main-coop-map-wrap" id="cooperativeMapWrap">
            <div class="main-coop-map-canvas" id="cooperativeMap" role="region" aria-label="แผนที่แสดงตำแหน่งสหกรณ์และกลุ่มเกษตรกรในจังหวัดชัยภูมิ"></div>
            <div class="main-coop-map-count">
              <i class="bi bi-geo-alt-fill text-success" aria-hidden="true"></i>
              <strong id="cooperativeMapCount"><%= _cooperativeMapLocations.length.toLocaleString('th-TH') %></strong>
              <span>จุดที่แสดง</span>
            </div>
            <div class="main-coop-map-error" role="status">
              <span><i class="bi bi-wifi-off d-block fs-3 mb-2" aria-hidden="true"></i>ไม่สามารถโหลดแผนที่ได้ในขณะนี้<br>เปิด Google Maps จากรายชื่อเพื่อดูที่ตั้งได้</span>
            </div>
          </div>
          <div class="main-coop-map-results">
            <h3 id="cooperativeMapResultCount" role="status" aria-live="polite">ที่ตั้งที่เผยแพร่ <%= _cooperativeMapLocations.length.toLocaleString('th-TH') %> แห่ง</h3>
            <div class="main-coop-map-result-scroll">
              <p class="main-coop-map-empty mb-0" id="cooperativeMapEmpty" <%= _cooperativeMapLocations.length ? 'hidden' : '' %>><%= _cooperativeMapUnavailable ? 'ข้อมูลที่ตั้งไม่พร้อมใช้งานชั่วคราว' : 'ยังไม่มีพิกัดที่เผยแพร่ เมื่อเจ้าหน้าที่ตรวจสอบและเผยแพร่ข้อมูลแล้ว จุดที่ตั้งจะแสดงบนแผนที่นี้' %></p>
              <ul class="main-coop-map-list" id="cooperativeMapList">
                <% _cooperativeMapLocations.forEach(function(item, index) { %>
                  <li class="main-coop-map-result" data-map-result="<%= index %>">
                    <strong class="main-coop-map-result-name"><%= item.name %></strong>
                    <div class="main-coop-map-result-detail"><%= _cooperativeMapTypeLabels[item.type] %><%= item.district ? ` · อำเภอ${item.district}` : '' %></div>
                    <% if (item.address) { %><div class="main-coop-map-result-detail"><%= item.address %></div><% } %>
                    <div class="main-coop-map-result-actions">
                      <button type="button" data-map-location="<%= index %>" aria-label="ดู <%= item.name %> บนแผนที่" hidden>ดูบนแผนที่</button>
                      <a href="<%= item.googleMapsUrl || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(item.latitude + ',' + item.longitude)) %>" target="_blank" rel="noopener noreferrer">Google Maps<span class="visually-hidden"> ของ <%= item.name %> (เปิดหน้าต่างใหม่)</span></a>
                      <% if (item.websiteUrl) { %><a href="<%= item.websiteUrl %>" target="_blank" rel="noopener noreferrer">เว็บไซต์<span class="visually-hidden"> ของ <%= item.name %> (เปิดหน้าต่างใหม่)</span></a><% } %>
                    </div>
                  </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
        <div class="main-coop-map-legend" aria-label="คำอธิบายสีบนแผนที่">
          <span><i class="main-coop-map-dot" style="--map-dot:#16845f"></i>สหกรณ์ภาคการเกษตร</span>
          <span><i class="main-coop-map-dot" style="--map-dot:#3478c7"></i>สหกรณ์นอกภาคการเกษตร</span>
          <span><i class="main-coop-map-dot" style="--map-dot:#bd7410"></i>กลุ่มเกษตรกร</span>
          <span class="ms-lg-auto"><i class="bi bi-shield-check" aria-hidden="true"></i>เฉพาะพิกัดที่ตรวจสอบและอนุญาตให้เผยแพร่</span>
        </div>
      </div>
      <script type="application/json" id="cooperativeMapData"><%- _cooperativeMapJson %></script>
    </section>

    <div class="row g-3 align-items-stretch">
      <div class="col-12">
        <div class="main-hero">
          <div>
            <span class="main-hero-kicker"><i class="bi bi-shield-check"></i> หน้าหลัก CoopChain</span>
            <h2 class="display-6 mb-0">ระบบสารสนเทศและเครือข่าย</h2>
            <p class="lead mb-0 mt-3">สหกรณ์และกลุ่มเกษตรกรในจังหวัดชัยภูมิ</p>
          </div>
          <% if (!_unavailable.institutions) { %>
          <dl class="main-overview-numbers mt-4" aria-label="ภาพรวมสถาบันที่ดำเนินการ">
            <% _institutionSummaryList.forEach(function(item) { %>
              <div><dt><%= item.label %></dt><dd><%= Number(item.count || 0).toLocaleString('th-TH') %> <small>แห่ง</small></dd></div>
            <% }); %>
          </dl>
          <% } else { %><p role="status">ข้อมูลภาพรวมสถาบันไม่พร้อมใช้งานชั่วคราว</p><% } %>
          <div class="main-hero-shortcuts mt-4">
            <a href="#institutionSummaryTitle" class="btn btn-success">ดูภาพรวมสถาบัน</a>
            <a href="#cooperativeMapSection" class="btn btn-outline-success">ค้นหาที่ตั้งสถาบัน</a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3 mt-1">
      <div class="col-12">
        <a href="/meetingroom" class="main-system-link h-100">
          <i class="bi bi-calendar2-check"></i>
          <span>
            <span class="d-block fw-semibold">จองห้องประชุม</span>
            <span class="small text-muted">ระบบจองใช้ห้อง</span>
          </span>
        </a>
      </div>
    </div>

        <section class="main-institution-section main-wide-section" aria-labelledby="institutionSummaryTitle">
      <% if (_unavailable.institutions) { %><div class="alert alert-warning" role="status">ไม่สามารถโหลดข้อมูลส่วนนี้ได้ กรุณาลองใหม่ภายหลัง</div><% } else { %>
      <div class="main-section-title">
        <div>
          <h2 id="institutionSummaryTitle">สรุปจำนวนสถาบันที่ดำเนินการ</h2>
          <div class="text-muted small">คลิกการ์ดเพื่อดูชื่อ สังกัด และปีบัญชีที่เปิดเผยได้</div>
        </div>
        <span class="badge text-bg-success"><%= _institutionTotal %> แห่ง</span>
      </div>

      <div class="row g-3 align-items-stretch">
        <div class="col-12 col-xl-6">
          <div class="main-institution-chart-card">
            <div class="main-chart-head">
              <div>
                <h3 class="main-chart-title">
                  <i class="bi bi-bar-chart-line"></i>
                  กราฟจำนวนสถาบัน
                </h3>
                <div class="text-muted small mt-1">แสดงเฉพาะจำนวนรวมตามประเภทสถาบัน</div>
              </div>
              <span class="main-pill">
                <i class="bi bi-database-check text-success"></i>
                <span><%= _institutionTotal %> แห่ง</span>
              </span>
            </div>

            <div class="main-chart-canvas-wrap">
              <canvas id="institutionSummaryChart" aria-label="กราฟจำนวนสถาบันตามประเภท" role="img"></canvas>
