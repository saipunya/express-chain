                <span class="main-pill">
                  <i class="bi bi-cash-coin text-primary"></i>
                  <span><%= _formatTurnoverAmount(_turnoverTotalAmount) %></span>
                </span>
              </div>
              <div class="main-chart-canvas-wrap tall">
                <canvas id="turnoverAmountChart" aria-label="กราฟปริมาณธุรกิจตามประเภทสถาบัน" role="img"></canvas>
                <ul class="main-chart-fallback" id="turnoverAmountChartFallback" hidden>
