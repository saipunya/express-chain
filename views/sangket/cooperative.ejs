<%- include('../partials/header.ejs', { title: title || 'ข้อสังเกตของสถาบัน' }) %>
<%
  const observationsCount = Array.isArray(observations) ? observations.length : 0;
  const typeLabel = cooperative?.coop_type === 'group_farmer' ? 'กลุ่มเกษตรกร' : 'สหกรณ์';
  const statusInfo = (value) => {
    if (value === 'resolved' || value === 'closed') return { label: 'แก้ไขแล้ว', color: 'success' };
    if (value === 'in_progress' || value === 'monitoring') return { label: 'ระหว่างดำเนินการ', color: 'primary' };
    return { label: 'ยังไม่แก้ไข', color: 'danger' };
  };
%>

<link rel="stylesheet" href="/css/sangket-cooperative.css">
<link rel="stylesheet" href="/css/sangket.css">

<div class="sangket-coop-page py-3 sangket-workspace">
  <div class="container">
    <%- include('navigation', { current: 'cooperative', pageLabel: 'ข้อสังเกตของสถาบัน' }) %>

    <main class="coop-shell">
      <header class="coop-hero p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
          <div>
            <h1 class="h4 fw-bold mb-2"><%= cooperative.cooperative_name %></h1>
            <div class="institution-meta">
              <span><%= typeLabel %></span>
              <% if (cooperative.cooperative_code) { %><span>รหัส <%= cooperative.cooperative_code %></span><% } %>
              <% if (cooperative.promotion_group_no) { %><span>กลุ่มส่งเสริม <%= cooperative.promotion_group_no %></span><% } %>
            </div>
          </div>
          <a href="/sangket" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>กลับหน้ารวม</a>
        </div>
      </header>

      <div class="p-3 p-lg-4">
        <section class="status-summary mb-4" aria-label="สรุปจำนวนประเด็น">
          <div class="status-stat status-stat-total"><span>ทั้งหมด</span><strong><%= summary.observation_total || 0 %></strong></div>
          <div class="status-stat status-stat-resolved"><span>แก้ไขแล้ว</span><strong><%= summary.resolved_items || 0 %></strong></div>
          <div class="status-stat status-stat-progress"><span>ระหว่างดำเนินการ</span><strong><%= summary.in_progress_items || 0 %></strong></div>
          <div class="status-stat status-stat-new"><span>ยังไม่แก้ไข</span><strong><%= summary.new_items || 0 %></strong></div>
        </section>

        <section aria-labelledby="issues-heading">
          <div class="section-heading mb-3">
            <div>
              <h2 id="issues-heading" class="h5 fw-bold mb-1">รายการประเด็นข้อสังเกต</h2>
              <p class="text-muted small mb-0">เลือกดูรายละเอียดเพื่อรายงานการแก้ไขและแนบหลักฐาน</p>
            </div>
            <a href="/sangket/create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>เพิ่มข้อสังเกต</a>
          </div>

          <% if (observationsCount) { %>
            <div class="issues-list">
              <% observations.forEach((row) => { const state = statusInfo(row.status); const latestAction = (row.actions || [])[0]; %>
                <article class="issue-row">
                  <div class="issue-main">
                    <div class="d-flex align-items-start gap-2 mb-2">
                      <span class="badge text-bg-<%= state.color %>"><%= state.label %></span>
                      <% if (row.observation_no) { %><span class="text-muted small">ประเด็นที่ <%= row.observation_no %></span><% } %>
                    </div>
                    <div class="issue-text"><%= row.observation_text || '-' %></div>
                  </div>

                  <div class="issue-owner">
                    <div class="issue-label">ผู้รับผิดชอบ</div>
                    <div><%= row.responsible_name || 'ยังไม่ระบุ' %></div>
                    <% if (row.remark) { %><div class="issue-note mt-2"><span>หมายเหตุ:</span> <%= row.remark %></div><% } %>
                  </div>

                  <div class="issue-correction">
                    <div class="issue-label">การแก้ไขล่าสุด</div>
                    <% if (latestAction) { %>
                      <div class="correction-text"><%= latestAction.action_detail || latestAction.result || '-' %></div>
                      <% if (latestAction.attachment_path) { %>
                        <a href="/sangket/view/<%= row.observation_id %>/actions/<%= latestAction.id %>/evidence" class="attachment-link" target="_blank" rel="noopener"><i class="bi bi-paperclip" aria-hidden="true"></i><%= latestAction.attachment_name || 'ไฟล์หลักฐาน' %></a>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted">ยังไม่มีรายงาน</span>
                    <% } %>
                  </div>

                  <div class="issue-actions">
                    <a href="/sangket/view/<%= row.observation_id %>" class="btn btn-sm btn-primary">ดูรายละเอียด</a>
                    <a href="/sangket/edit/<%= row.observation_id %>" class="btn btn-sm btn-outline-secondary" aria-label="แก้ไขข้อสังเกต"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-issues text-center py-5">
              <i class="bi bi-inbox fs-2 text-muted" aria-hidden="true"></i>
              <p class="text-muted mb-3 mt-2">ยังไม่มีข้อสังเกตของสถาบันนี้</p>
              <a href="/sangket/create" class="btn btn-sm btn-primary">เพิ่มข้อสังเกต</a>
            </div>
          <% } %>
        </section>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
