<%
  const manager = user && ['admin','kjs'].includes(user.mClass || user.m_class || user.level);
  const withdrawalTargets = managementData.targets.filter(row => row.target_type === 'withdrawal');
  const targetDate = new Intl.DateTimeFormat('th-TH', { dateStyle: 'medium', timeZone: 'Asia/Bangkok' });
%>
<div class="card shadow-sm mb-4"><div class="card-body">
  <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
    <% if (manager) { %><div class="ms-auto d-flex flex-wrap gap-2"><% [['indicators','ตัวชี้วัด'],['targets','เป้าหมาย'],['meetings','รายงานประชุม']].forEach(([key,label]) => { %><a class="btn btn-outline-primary" href="/chamra/manage/<%= key %>?year=<%= managementYear %>">จัดการ<%= label %></a><% }) %></div><% } %>
  </div>
  <h2 class="h5">ตัวชี้วัด ปีงบประมาณ <%= managementYear %></h2>
  <div class="table-responsive"><table class="table table-striped"><thead><tr><th>ตัวชี้วัด</th><th>เป้าหมาย</th><th>ผลดำเนินการ</th><th>ร้อยละ</th></tr></thead><tbody>
    <% if (!managementData.indicators.length) { %><tr><td colspan="4" class="text-muted">ยังไม่มีตัวชี้วัดสำหรับปีนี้</td></tr><% } %>
    <% managementData.indicators.forEach(row => { %><tr><td><%= row.title %><% if (row.note) { %><div class="small text-muted"><%= row.note %></div><% } %></td><td><%= row.target_value %> <%= row.unit %></td><td><%= row.actual_value %> <%= row.unit %></td><td><%= Number(row.target_value) > 0 ? (Number(row.actual_value)/Number(row.target_value)*100).toFixed(2)+'%' : '—' %></td></tr><% }) %>
  </tbody></table></div>
  <p class="small text-muted mb-0">ผลดำเนินการตัวชี้วัดเป็นข้อมูลที่ผู้รับผิดชอบบันทึก</p>
</div></div>
<div class="row g-4 mb-4">
  <div class="col-12">
    <section class="withdrawal-targets" aria-labelledby="withdrawal-targets-title">
      <div class="withdrawal-targets-header">
        <div class="withdrawal-targets-heading">
          <i class="bi bi-bullseye withdrawal-targets-emblem" aria-hidden="true"></i>
          <div>
            <h2 id="withdrawal-targets-title" class="h5 mb-1 fw-bold">เป้าหมายการชำระบัญชี ปี <%= managementYear %></h2>
            <p class="withdrawal-targets-caption mb-0">ขั้นตอนล่าสุด ณ <%= period.asOfLabel %></p>
          </div>
        </div>
        <div class="withdrawal-targets-total">
          <strong><%= withdrawalTargets.length.toLocaleString('th-TH') %></strong>
          <span>แห่งที่ตั้งเป้าถอนชื่อ</span>
        </div>
      </div>

      <% if (withdrawalTargets.length) { %>
        <ul class="withdrawal-target-list list-unstyled mb-0" role="list">
          <% withdrawalTargets.forEach(row => { %>
            <li class="withdrawal-target-row">
              <i class="bi bi-building withdrawal-target-icon" aria-hidden="true"></i>
              <div class="withdrawal-target-institution">
                <a class="withdrawal-target-link" href="/chamra/detail/<%= encodeURIComponent(row.c_code) %>"><%= row.c_name || row.c_code %> <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                <% if (row.responsible || row.due_date) { %>
                  <div class="withdrawal-target-meta">
                    <% if (row.responsible) { %>
                      <span><i class="bi bi-person" aria-hidden="true"></i><span>ผู้รับผิดชอบ <%= row.responsible %></span></span>
                    <% } %>
                    <% if (row.due_date) { %>
                      <span><i class="bi bi-calendar-event" aria-hidden="true"></i><span>ครบกำหนด <%= targetDate.format(new Date(row.due_date)) %></span></span>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <div class="withdrawal-target-progress">
                <% if (row.latestStep) { %>
                  <span class="withdrawal-target-status<%= row.latestStep >= 9 ? ' is-withdrawn' : '' %>">
                    <i class="bi <%= row.latestStep >= 9 ? 'bi-check-circle' : 'bi-arrow-right-circle' %>" aria-hidden="true"></i>
                    <span>ขั้นที่ <%= row.latestStep %> · <%= row.latestStepLabel %></span>
                  </span>
                  <% if (row.latestStepDate) { %><span class="withdrawal-target-date"><%= targetDate.format(new Date(row.latestStepDate)) %></span><% } %>
                <% } else { %>
                  <span class="withdrawal-target-status is-pending"><i class="bi bi-dash-circle" aria-hidden="true"></i><span>ยังไม่มีข้อมูลขั้นตอน</span></span>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="withdrawal-target-empty mb-0">ยังไม่มีเป้าหมายถอนชื่อสำหรับปีนี้</p>
      <% } %>
    </section>
  </div>
  <div class="col-12"><div class="card shadow-sm h-100"><div class="card-body">
    <h2 class="h5">รายงานการประชุม ปี <%= managementYear %></h2>
    <% if (!managementData.meetings.length) { %><p class="text-muted">ยังไม่มีการประชุมสำหรับปีนี้</p><% } %>
    <ul class="list-group list-group-flush"><% managementData.meetings.forEach(row => { %><li class="list-group-item px-0"><div><%= row.title %> ครั้งที่ <%= row.meeting_no %>/<%= row.fiscal_year %></div><div class="small text-muted"><%= new Intl.DateTimeFormat('th-TH',{dateStyle:'medium',timeZone:'Asia/Bangkok'}).format(new Date(row.meeting_date)) %></div><% if (row.report_path) { %><a href="<%= row.report_path %>" target="_blank" rel="noopener noreferrer">เปิดรายงาน PDF</a> <a class="btn btn-outline-primary btn-sm ms-2" href="<%= row.report_path %>" download="รายงานการประชุม-<%= row.meeting_no %>-<%= row.fiscal_year %>.pdf"><i class="bi bi-download me-1"></i>ดาวน์โหลด</a><% } else { %><span class="small text-muted">ยังไม่แนบรายงาน</span><% } %></li><% }) %></ul>
  </div></div></div>
</div>
