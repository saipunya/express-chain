<%- include('partials/member-head') %>
<nav class="breadcrumb-line"><a href="/debt/member/overview">ข้อมูลหนี้ของฉัน</a><i class="bi bi-chevron-right"></i><span><%= loan.loan_no %></span></nav>
<section class="member-welcome loan"><div><span class="risk-badge risk-<%= loan.risk_color.toLowerCase() %>"><span class="risk-dot"></span><%= debtRiskThai(loan.risk_color) %></span><h1>สัญญา <%= loan.loan_no %></h1><p><%= loan.loan_type || '-' %> • วันที่ทำสัญญา <%= debtDate(loan.contract_date) %></p></div><div class="member-asof"><small>ครบกำหนดสัญญา</small><strong><%= debtDate(loan.maturity_date) %></strong></div></section>
<div class="member-summary-grid four"><div><span>เงินต้นคงเหลือ</span><strong><%= debtMoney(loan.principal_balance) %></strong><small>บาท</small></div><div><span>ยอดค้างรวม</span><strong><%= debtMoney(loan.total_overdue) %></strong><small>บาท</small></div><div><span>จำนวนงวดค้าง</span><strong><%= debtNumber(loan.overdue_installments) %></strong><small>งวด</small></div><div><span>กำหนดงวดถัดไป</span><strong class="small-date"><%= debtDate(loan.next_due_date) %></strong><small><%= debtMoney(loan.installment_amount) %> บาท/งวด</small></div></div>
<div class="row g-4"><div class="col-lg-7"><section class="panel"><div class="panel-head"><h2>ประวัติการชำระ</h2></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>วันที่</th><th>เลขที่ใบเสร็จ</th><th class="text-end">เงินต้น</th><th class="text-end">ดอกเบี้ย</th><th class="text-end">ค่าปรับ</th></tr></thead><tbody><% payments.forEach((x)=>{ %><tr><td><%= debtDate(x.payment_date) %></td><td><%= x.receipt_no || '-' %></td><td class="text-end"><%= debtMoney(x.principal_paid) %></td><td class="text-end"><%= debtMoney(x.interest_paid) %></td><td class="text-end"><%= debtMoney(x.penalty_paid) %></td></tr><% }) %></tbody></table></div></section></div><div class="col-lg-5"><section class="panel"><div class="panel-head"><h2>สถานะหนี้ล่าสุด</h2></div><dl class="loan-status-list"><div><dt>เงินต้นค้าง</dt><dd><%= debtMoney(loan.overdue_principal) %> บาท</dd></div><div><dt>ดอกเบี้ยค้าง</dt><dd><%= debtMoney(loan.overdue_interest) %> บาท</dd></div><div><dt>ค่าปรับค้าง</dt><dd><%= debtMoney(loan.overdue_penalty) %> บาท</dd></div><div><dt>วันที่รับชำระล่าสุด</dt><dd><%= debtDate(loan.last_payment_date) %></dd></div></dl></section></div></div>
<section class="panel mt-4"><div class="panel-head"><h2>ประวัติยอดหนี้</h2></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>ข้อมูล ณ วันที่</th><th class="text-end">เงินต้นคงเหลือ</th><th class="text-end">ค้างชำระ</th><th class="text-end">จำนวนวันค้าง</th></tr></thead><tbody><% snapshots.forEach((x)=>{ const overdue=Number(x.overdue_principal)+Number(x.overdue_interest)+Number(x.overdue_penalty); %><tr><td><%= debtDate(x.snapshot_date) %></td><td class="text-end"><%= debtMoney(x.principal_balance) %></td><td class="text-end"><%= debtMoney(overdue) %></td><td class="text-end"><%= debtNumber(x.days_past_due) %> วัน</td></tr><% }) %></tbody></table></div></section>
<%- include('partials/member-foot') %>
