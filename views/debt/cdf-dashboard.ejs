<%- include('partials/head') %>
<% const cdfOutstanding=allContracts.reduce((sum,x)=>sum+Number(x.latest_principal_balance||0),0); const cdfUrgent=allContracts.filter(x=>x.risk_color==='RED').length; const attentionContracts=allContracts.filter(x=>['RED','ORANGE'].includes(x.risk_color)); const visibleContracts=(query.view==='all'||query.risk)?contracts:attentionContracts; %>
<section class="module-summary mb-4"><div class="module-primary"><span class="domain-symbol"><i class="bi bi-building"></i></span><div><span class="section-kicker">CDF MONITORING</span><h2>หนี้ กพส.</h2><p>สหกรณ์เป็นลูกหนี้กองทุนพัฒนาสหกรณ์</p></div></div><div class="module-money"><span>เงินต้นคงเหลือรวม</span><strong><%= debtMoney(cdfOutstanding) %></strong><small>บาท</small></div><div class="module-alert"><span>ต้องดูทันที</span><strong><%= debtNumber(cdfUrgent) %></strong><small>สัญญา RED</small></div></section>
<nav class="risk-filter-bar mb-4" aria-label="กรองระดับความเสี่ยง"><a class="<%= !query.risk&&query.view!=='all'?'active':'' %>" href="/debt/cdf"><span>ต้องติดตาม</span><strong><%= attentionContracts.length %></strong></a><a class="<%= query.view==='all'?'active':'' %>" href="/debt/cdf?view=all"><span>ทั้งหมด</span><strong><%= allContracts.length %></strong></a><% ['RED','ORANGE','YELLOW','GREEN'].forEach((risk)=>{ %><a class="<%= risk.toLowerCase() %> <%= query.risk===risk?'active':'' %>" href="/debt/cdf?risk=<%= risk %>"><span><%= debtRiskThai(risk) %></span><strong><%= allContracts.filter(x=>x.risk_color===risk).length %></strong></a><% }) %></nav>

<section class="panel"><div class="panel-head"><div><span class="section-kicker">CONTRACT FOCUS</span><h2><%= query.view==='all'?'สัญญาทั้งหมด':query.risk?`สัญญา — ${debtRiskThai(query.risk)}`:'สัญญาที่ต้องติดตามก่อน' %></h2><p>เรียงจากระดับความเสี่ยงและวันครบกำหนด</p></div><span class="result-count"><strong><%= visibleContracts.length %></strong> รายการ</span></div><div class="table-responsive"><table class="table debt-table focus-table"><thead><tr><th>ระดับ</th><th>เลขที่สัญญา / สหกรณ์</th><th class="text-end">ยอดคงเหลือ</th><th>ครบกำหนด</th><th>ติดตามล่าสุด</th><th></th></tr></thead><tbody>
<% visibleContracts.forEach((row)=>{ %><tr><td><%- include('partials/risk-badge',{risk:row.risk_color}) %></td><td><strong><%= row.contract_no %></strong><small><%= row.c_name %></small></td><td class="text-end"><%= debtMoney(row.latest_principal_balance) %></td><td><%= debtDate(row.next_due_date||row.maturity_date) %><small><%= row.days_to_due==null?'':`${row.days_to_due} วัน` %></small></td><td><%= debtDate(row.last_follow_up_date) %></td><td><a href="/debt/cdf/contracts/<%= row.contract_id %>" class="btn btn-sm btn-light">รายละเอียด</a></td></tr><% }) %>
</tbody></table></div></section>

<details class="panel disclosure-panel mt-4"><summary><div><span class="section-kicker">COOPERATIVE OVERVIEW</span><h2>ภาพรวมรายสหกรณ์</h2><p>ใช้สำหรับเปรียบเทียบและค้นต่อ ไม่ใช่คิวงานเร่งด่วน</p></div><span><strong><%= cooperatives.length %></strong> แห่ง <i class="bi bi-chevron-down"></i></span></summary><div class="table-responsive"><table class="table debt-table"><thead><tr><th>สหกรณ์</th><th>เจ้าหน้าที่รับผิดชอบ</th><th class="text-end">สัญญา</th><th class="text-end">วงเงินรวม</th><th>ความเสี่ยง</th><th></th></tr></thead><tbody><% cooperatives.forEach((coop)=>{ %><tr><td><strong><%= coop.c_name %></strong><small><%= coop.c_code %> • <%= coop.c_group||'-' %></small></td><td><%= coop.responsible_officer||'-' %></td><td class="text-end"><%= debtNumber(coop.contract_count) %></td><td class="text-end"><%= debtMoney(coop.total_contract_amount) %></td><td><span class="risk-count red"><%= coop.red_contracts %> แดง</span> <span class="risk-count orange"><%= coop.orange_contracts %> ส้ม</span></td><td><a href="/debt/cdf/cooperatives/<%= coop.coop_id %>" class="btn btn-sm btn-light">เปิด</a></td></tr><% }) %></tbody></table></div></details>
<%- include('partials/foot') %>
