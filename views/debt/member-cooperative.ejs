<%- include('partials/head') %>
<nav class="breadcrumb-line"><a href="/debt/member-debt">หนี้สมาชิก</a><i class="bi bi-chevron-right"></i><span><%= cooperative.c_name %></span></nav>
<section class="profile-strip mb-4"><div><span class="demo-pill">DEMO DATA</span><h2><%= cooperative.c_name %></h2><p><%= cooperative.c_code %> • <%= cooperative.c_group || '-' %></p></div><div class="officer-card"><small>เจ้าหน้าที่รับผิดชอบ</small><strong><%= cooperative.c_person || '-' %></strong><span><%= cooperative.c_person2 ? `ผู้ช่วย: ${cooperative.c_person2}` : '' %></span></div></section>
<div class="kpi-grid compact mb-4"><div class="kpi-card"><span>สมาชิกผู้กู้</span><strong><%= new Set(loans.map(x=>x.member_id)).size %></strong></div><% ['RED','ORANGE','YELLOW','GREEN'].forEach((risk)=>{ %><a class="kpi-card risk-card <%= risk.toLowerCase() %>" href="?risk=<%= risk %>"><span><%= debtRiskThai(risk) %></span><strong><%= loans.filter(x=>x.risk_color===risk).length %></strong></a><% }) %></div>
<section class="panel"><div class="panel-head"><h2>รายการสมาชิกและสัญญา</h2><form class="search-form" method="get"><% if(query.risk){ %><input type="hidden" name="risk" value="<%= query.risk %>"><% } %><input name="q" value="<%= query.q||'' %>" placeholder="ค้นหา"><button><i class="bi bi-search"></i></button></form></div><div class="table-responsive"><table class="table debt-table"><thead><tr><th>ระดับ</th><th>สมาชิก</th><th>สัญญา</th><th class="text-end">ยอดคงเหลือ</th><th class="text-end">ยอดค้าง</th><th>ติดตามล่าสุด</th><th></th></tr></thead><tbody><% loans.forEach((x)=>{ %><tr><td><%- include('partials/risk-badge',{risk:x.risk_color}) %></td><td><a class="cell-link" href="/debt/member-debt/members/<%= x.member_id %>"><strong><%= x.display_name %></strong><small><%= x.member_no %> • DEMO</small></a></td><td><%= x.loan_no %><small><%= x.loan_type || '-' %></small></td><td class="text-end"><%= debtMoney(x.principal_balance) %></td><td class="text-end"><%= debtMoney(x.total_overdue) %></td><td><%= debtDate(x.last_followup_date) %></td><td><a class="btn btn-sm btn-light" href="/debt/member-debt/loans/<%= x.loan_id %>">รายละเอียด</a></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/foot') %>
