    .coop-profile-page .profile-meta { width: 100%; max-width: none; }
    .coop-profile-page .profile-meta .d-flex { justify-content: flex-start !important; }
    .coop-profile-page .section-nav { top: .35rem; }
    .coop-profile-page .quick-stats > [class*="col-"] { width: 50%; }
