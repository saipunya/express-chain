<%- include('../partials/header',{title : 'สรุปขั้นตอนการชำระบัญชี'}) %>

<style>
  :root{
    --fs-base:15px;
    --fs-table:14px;
    --fs-badge:12px;
  }
  body{font-size:var(--fs-base);}
  table{font-size:var(--fs-table);}
  .badge{font-size:var(--fs-badge);font-weight:600;}
  thead th{position:sticky;top:0;z-index:5;}
  
  .page-wrap {
    background: #f5f7fb;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .summary-hero {
    border: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background: linear-gradient(135deg, #1e3a5f 0%, #29527f 100%);
    color: #fff;
  }
  
  .summary-hero .summary-subtitle {
    color: rgba(255, 255, 255, 0.85);
  }
  
  .summary-stat {
    min-width: 190px;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    backdrop-filter: blur(6px);
  }
  
  .summary-stat-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: #fff;
    color: #1e3a5f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex: 0 0 auto;
  }
  
  .sticky-header {
    flex: 1;
    overflow: auto;
  }
  
  .table thead th {
    background-color: #212529;
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 10;
    font-size: 0.8rem;
    padding: 10px 6px;
    white-space: nowrap;
    min-width: 70px;
  }
  
  .table thead th.institution-col {
    min-width: 200px;
    text-align: left;
  }
  
  .table tbody td {
    padding: 8px 6px;
    vertical-align: middle;
    text-align: center;
  }
  
  .table tbody th {
    background-color: #f8f9fa;
    position: sticky;
    left: 0;
    z-index: 5;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
    padding: 10px 12px;
  }
  
  .institution-name {
    font-size: 0.85rem;
  }
  
  .step-info {
    font-size: 0.7rem;
    margin-top: 2px;
  }
  
  .month-col-header {
    background-color: #212529 !important;
  }
  
  .badge-date {
    display: inline-flex;
    align-items: center;
    padding: 4px 6px;
    font-size: 0.7rem;
  }
</style>

<div class="page-wrap container-fluid py-3">

  <!-- Header -->
  <div class="card summary-hero shadow-sm mb-3">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
        <div>
          <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <span class="badge rounded-pill bg-white text-primary border border-white">สรุปขั้นตอน</span>
            <span class="badge rounded-pill bg-warning text-dark">ปีงบประมาณ <%= year %></span>
          </div>
          <h5 class="mb-1 fw-bold">ตารางความเคลื่อนไหวการชำระบัญชี</h5>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <div class="summary-stat d-inline-flex align-items-center gap-3 px-3 py-2 shadow-sm">
            <span class="summary-stat-icon"><i class="bi bi-building"></i></span>
            <div>
              <div class="small" style="color:rgba(255,255,255,0.75)">สหกรณ์ที่แสดง</div>
              <div class="fw-bold"><%= data ? data.length : 0 %></div>
            </div>
          </div>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-light" onclick="adjFont(-1)">A-</button>
            <button type="button" class="btn btn-light" onclick="adjFont(1)">A+</button>
            <button type="button" class="btn btn-outline-light" onclick="resetFont()">รีเซ็ต</button>
          </div>
          <a href="/chamra?year=<%= year %>" class="btn btn-light btn-sm rounded-pill px-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> กลับ
          </a>
        </div>
      </div>
    </div>
  </div>

  <%- include('manage/fiscal-filter') %>

  <!-- Legend -->
  <div class="d-flex gap-3 small mb-2">
    <span class="d-inline-flex align-items-center gap-1">
      <span class="badge bg-success"> </span> มีวันที่บันทึก
    </span>
    <span class="d-inline-flex align-items-center gap-1">
      <span class="badge bg-secondary"> </span> ยังไม่มีกิจกรรม
    </span>
  </div>

  <% 
    const fiscalMonths = period.months;

    const isEmptyDate = (v) => {
      if (!v) return true;
      if (typeof v === 'string') {
        if (v === '0000-00-00') return true;
        if (/^1899-11-30/.test(v)) return true;
      }
      if (v instanceof Date) {
        const y = v.getFullYear();
        if (y < 1950) return true;
      }
      return false;
    };
    
    const formatThai = (v) => {
      if (isEmptyDate(v)) return null;
      const d = v instanceof Date ? v : new Date(v);
      if (isNaN(d.getTime()) || d.getFullYear() < 1950) return null;
      const months = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
      return new Intl.DateTimeFormat('th-TH', { day:'numeric', month:'short', year:'numeric', timeZone:'Asia/Bangkok' }).format(d);
    };
  %>

  <div class="sticky-header table-responsive">
    <table class="table table-bordered table-md align-middle">
      <thead class="text-center">
        <tr>
          <th class="institution-col">สถาบัน</th>
          <% fiscalMonths.forEach(month => { %>
            <th class="month-col-header"><%= month.label %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody class="table-group-divider">
        <% data.forEach((item, idx) => { %>
          <tr>
            <th>
              <div class="institution-name">
                <%= (item.institution_name || '-').substring(0, 35) %><%= (item.institution_name || '').length > 35 ? '...' : '' %>
              </div>
              <div class="step-info">
                <small class="text-muted">ก่อนเริ่มปี (<%= period.baselineLabel %>):</small><br>
                <% if (item.oct1_step && Number(item.oct1_step) > 0) { %>
                  <span class="badge bg-info"><%= item.oct1_step_label || `ขั้นที่ ${item.oct1_step}` %></span><br>
                <% } else { %>
                  <span class="badge bg-secondary">ยังไม่เริ่ม</span>
                <% } %>
                <small class="text-muted ms-2">ณ <%= period.asOfLabel %>:</small><br>
                <% if (item.current_max_step && Number(item.current_max_step) > 0) { %>
                  <span class="badge bg-success"><%= item.current_max_step_label || `ขั้นที่ ${item.current_max_step}` %></span><br>
                <% } else { %>
                  <span class="badge bg-secondary">ยังไม่เริ่ม</span>
                <% } %>
              </div>
            </th>
            <% fiscalMonths.forEach(month => {
              const activities = (item.activities || []).filter(activity => activity.date.slice(0, 7) === month.key);
            %>
              <td>
                <% if (activities.length) { %>
                  <% activities.forEach(activity => { %>
                    <span class="badge bg-success badge-date mb-1" title="<%= activity.label %>">ขั้น <%= activity.step %> • <%= formatThai(activity.date) %></span>
                  <% }) %>
                <% } else { %><span class="text-muted">—</span><% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (!data || data.length === 0) { %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-inbox fs-2 d-block mb-2"></i>
      ไม่พบข้อมูลในช่วงปีงบประมาณที่กำหนด
    </div>
  <% } %>

</div>

<script>
const fsState = {
  base: 15,
  table: 14,
  badge: 12
};
function applyFS(){
  document.documentElement.style.setProperty('--fs-base', fsState.base + 'px');
  document.documentElement.style.setProperty('--fs-table', fsState.table + 'px');
  document.documentElement.style.setProperty('--fs-badge', fsState.badge + 'px');
  localStorage.setItem('chamraSummaryFS', JSON.stringify(fsState));
}
function adjFont(delta){
  fsState.base = Math.min(20, Math.max(12, fsState.base + delta));
  fsState.table = Math.min(19, Math.max(11, fsState.table + delta));
  fsState.badge = Math.min(17, Math.max(10, fsState.badge + delta));
  applyFS();
}
function resetFont(){
  fsState.base = 15; fsState.table = 14; fsState.badge = 12;
  applyFS();
}
(function initFS(){
  const saved = localStorage.getItem('chamraSummaryFS');
  if(saved){
    try{
      const obj = JSON.parse(saved);
      Object.assign(fsState, obj);
    }catch(e){}
  }
  applyFS();
})();
</script>

<%- include('../partials/footer') %>
