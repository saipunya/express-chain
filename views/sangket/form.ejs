<%- include('../partials/header.ejs', { title: title || 'บันทึกข้อสังเกต' }) %>
<%
  const isEdit = Boolean(item && item.id);
  const actionUrl = isEdit ? `/sangket/edit/${item.id}` : '/sangket/create';
  const statusNames = { new: 'ใหม่', in_progress: 'กำลังดำเนินการ', monitoring: 'ติดตาม', resolved: 'ปิดแล้ว', closed: 'ยุติ' };
  const currentStatus = (item && item.status) || 'new';
  const initialCooperativeCode = item?.cooperative_code || item?.c_code || '';
  const initialCooperativeName = item?.cooperative_name || item?.sang_name || '';
  const initialCoopType = item?.coop_type || '';
  const initialPromotionGroupNo = item?.promotion_group_no || '';
  const initialResponsible = item?.responsible_name || '';
%>

<link rel="stylesheet" href="/css/sangket-form.css">
<link rel="stylesheet" href="/css/sangket.css">

<div class="sangket-form-page py-3 sangket-workspace">
  <div class="container">
    <%- include('navigation', { current: isEdit ? 'edit' : 'form', pageLabel: isEdit ? 'แก้ไขข้อสังเกต' : 'เพิ่มข้อสังเกต' }) %>
    <div class="form-shell">
      <div class="form-hero p-3 p-lg-4">
        <h1 class="form-hero__title mb-2"><%= isEdit ? 'แก้ไขข้อสังเกต' : 'บันทึกข้อสังเกตใหม่' %></h1>
        <p class="form-hero__subtitle mb-0">บันทึกเฉพาะข้อมูลที่จำเป็น แล้วให้เจ้าหน้าที่ส่งรายงานการแก้ไขพร้อมหลักฐานในหน้ารายละเอียด</p>
      </div>

      <form action="<%= actionUrl %>" method="POST" class="p-3 p-lg-4">
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

        <input type="hidden" name="cooperative_name" id="cooperative_name" value="<%= initialCooperativeName %>">
        <input type="hidden" name="c_code" id="cooperative_code" value="<%= initialCooperativeCode %>">
        <input type="hidden" name="coop_type" id="coop_type" value="<%= initialCoopType %>">
        <input type="hidden" name="promotion_group_no" id="promotion_group_no" value="<%= initialPromotionGroupNo %>">

        <div class="sangket-form-sections">
          <fieldset class="sangket-form-section sangket-form-section-wide">
            <legend>1. สถาบันและผู้รับผิดชอบ</legend>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label" for="coop_group_select">ประเภทสถาบัน</label>
                <select id="coop_group_select" class="form-select" required>
                  <option value="">เลือกประเภท</option>
                  <% (activeCoopHierarchy || []).forEach((group) => { %><option value="<%= group.coop_group %>"><%= group.coop_group %></option><% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="c_group_select">กลุ่มส่งเสริมสหกรณ์</label>
                <select id="c_group_select" class="form-select" disabled required><option value="">เลือกกลุ่มส่งเสริม</option></select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="c_name_select">สถาบัน <span class="text-danger">*</span></label>
                <select id="c_name_select" class="form-select" disabled required><option value="">เลือกสถาบัน</option></select>
              </div>
              <div class="col-md-8">
                <label class="form-label" for="responsible_name">ผู้รับผิดชอบ</label>
                <input type="text" id="responsible_name" name="responsible_name" class="form-control" maxlength="255" value="<%= initialResponsible %>" placeholder="ชื่อเจ้าหน้าที่ผู้รับผิดชอบ" required>
                <div class="form-text">ระบบเติมจากเจ้าหน้าที่ประจำสถาบันให้อัตโนมัติ และสามารถแก้ไขได้</div>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="selected_coop_code">รหัสสถาบัน</label>
                <input type="text" id="selected_coop_code" class="form-control" readonly value="<%= initialCooperativeCode %>" placeholder="-">
              </div>
            </div>
          </fieldset>

          <fieldset class="sangket-form-section sangket-form-section-wide">
            <legend>2. ข้อสังเกต</legend>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label" for="observation_text">รายละเอียดข้อสังเกต <span class="text-danger">*</span></label>
                <textarea id="observation_text" name="observation_text" class="form-control" rows="6" maxlength="10000" required placeholder="ระบุรายละเอียดข้อสังเกตให้ชัดเจน"><%= item?.observation_text || '' %></textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="status">สถานะของข้อสังเกต</label>
                <select id="status" name="status" class="form-select">
                  <% Object.entries(statusNames).forEach(([value, label]) => { %><option value="<%= value %>" <%= currentStatus === value ? 'selected' : '' %>><%= label %></option><% }) %>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label" for="remark">หมายเหตุอื่น ๆ</label>
                <textarea id="remark" name="remark" class="form-control" rows="3" maxlength="5000" placeholder="ข้อมูลเพิ่มเติม (ถ้ามี)"><%= item?.remark || '' %></textarea>
              </div>
            </div>
          </fieldset>

          <div class="sangket-form-section-wide sangket-savebar d-flex flex-wrap gap-2 justify-content-end">
            <a href="<%= isEdit ? `/sangket/view/${item.id}` : '/sangket' %>" class="btn btn-outline-secondary px-4">ยกเลิก</a>
            <button type="submit" class="btn btn-primary px-4"><%= isEdit ? 'บันทึกการแก้ไข' : 'บันทึกข้อสังเกต' %></button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    const hierarchy = <%- JSON.stringify(activeCoopHierarchy || []).replace(/</g, '\\u003c') %>;
    const initialCode = <%- JSON.stringify(initialCooperativeCode).replace(/</g, '\\u003c') %>;
    const initialName = <%- JSON.stringify(initialCooperativeName).replace(/</g, '\\u003c') %>;
    const initialResponsible = <%- JSON.stringify(initialResponsible).replace(/</g, '\\u003c') %>;
    const typeSelect = document.getElementById('coop_group_select');
    const groupSelect = document.getElementById('c_group_select');
    const coopSelect = document.getElementById('c_name_select');
    const hiddenName = document.getElementById('cooperative_name');
    const hiddenCode = document.getElementById('cooperative_code');
    const hiddenType = document.getElementById('coop_type');
    const hiddenGroup = document.getElementById('promotion_group_no');
    const responsible = document.getElementById('responsible_name');
    const codePreview = document.getElementById('selected_coop_code');
    const clean = (value) => String(value || '').trim();
    const groupNumber = (value) => (clean(value).match(/(\d+)/) || [])[1] || '';
    const coopType = (value) => clean(value) === 'กลุ่มเกษตรกร' ? 'group_farmer' : 'cooperative';

    function options(select, rows, placeholder, selected = '') {
      select.innerHTML = `<option value="">${placeholder}</option>`;
      rows.forEach((row) => {
        const option = document.createElement('option');
        option.value = row.value;
        option.textContent = row.label;
        option.selected = String(row.value) === String(selected);
        select.appendChild(option);
      });
      select.disabled = rows.length === 0;
    }
    function findByCode(code) {
      for (const type of hierarchy) for (const group of type.c_groups || []) {
        const item = (group.items || []).find((row) => clean(row.c_code) === clean(code));
        if (item) return { type, group, item };
      }
      return null;
    }
    function typeNode(value) { return hierarchy.find((row) => clean(row.coop_group) === clean(value)); }
    function groupNode(type, value) { return (type?.c_groups || []).find((row) => clean(row.c_group) === clean(value)); }
    function showGroups(typeValue, selected = '') {
      const type = typeNode(typeValue);
      options(groupSelect, (type?.c_groups || []).map((row) => ({ value: row.c_group, label: row.c_group })), 'เลือกกลุ่มส่งเสริม', selected);
    }
    function showInstitutions(typeValue, groupValue, selected = '') {
      const group = groupNode(typeNode(typeValue), groupValue);
      options(coopSelect, (group?.items || []).map((row) => ({ value: row.c_code, label: row.c_name })), 'เลือกสถาบัน', selected);
    }
    function applyItem(item, replaceResponsible = true) {
      hiddenName.value = clean(item?.c_name);
      hiddenCode.value = clean(item?.c_code);
      hiddenType.value = coopType(item?.coop_group);
      hiddenGroup.value = groupNumber(item?.c_group);
      codePreview.value = clean(item?.c_code);
      if (replaceResponsible || !clean(responsible.value)) responsible.value = clean(item?.c_person);
    }
    function clearInstitution() {
      hiddenName.value = '';
      hiddenCode.value = '';
      hiddenGroup.value = '';
      codePreview.value = '';
    }

    typeSelect.addEventListener('change', () => {
      showGroups(typeSelect.value);
      options(coopSelect, [], 'เลือกสถาบัน');
      hiddenType.value = coopType(typeSelect.value);
      clearInstitution();
    });
    groupSelect.addEventListener('change', () => {
      showInstitutions(typeSelect.value, groupSelect.value);
      clearInstitution();
      hiddenGroup.value = groupNumber(groupSelect.value);
    });
    coopSelect.addEventListener('change', () => {
      const found = findByCode(coopSelect.value);
      if (found) applyItem(found.item, true); else clearInstitution();
    });

    if (initialCode || initialName) {
      const found = findByCode(initialCode) || hierarchy.flatMap((type) => (type.c_groups || []).flatMap((group) => (group.items || []).map((item) => ({ type, group, item })))).find((row) => clean(row.item.c_name) === clean(initialName));
      if (found) {
        typeSelect.value = found.type.coop_group;
        showGroups(found.type.coop_group, found.group.c_group);
        groupSelect.value = found.group.c_group;
        showInstitutions(found.type.coop_group, found.group.c_group, found.item.c_code);
        coopSelect.value = found.item.c_code;
        applyItem(found.item, !initialResponsible);
      }
    }
  })();
</script>

<%- include('../partials/footer') %>
