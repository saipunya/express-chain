      <% if (_strengthGradeList.length && Number(_strengthGradeTotals.total || 0) > 0) { %>
        <div class="row g-3 align-items-stretch">
          <% _strengthGradeList.forEach(function(item, itemIndex) { %>
            <% const total = Number(item.total || 0); %>
            <% const gradeRows = [
              { label: 'ชั้น 1', value: Number(item.grade1 || 0), className: 'grade-1' },
              { label: 'ชั้น 2', value: Number(item.grade2 || 0), className: 'grade-2' },
              { label: 'ชั้น 3', value: Number(item.grade3 || 0), className: 'grade-3' }
            ]; %>
            <div class="col-12">
              <article class="main-strength-feature-card <%= item.tone %>">
                <div class="main-strength-feature-top">
                  <span class="main-strength-feature-index"><%= String(itemIndex + 1).padStart(3, '0') %></span>
                  <span class="main-strength-feature-tag">ชั้น 1 · <%= total > 0 ? Number(item.grade1Percent || 0).toFixed(1) : '0.0' %>%</span>
                </div>
                <div class="main-strength-feature-visual" aria-hidden="true">
                  <span class="main-strength-feature-icon"><i class="bi <%= item.icon %>"></i></span>
                </div>
                <div class="main-strength-feature-content">
                  <div class="main-strength-feature-title"><%= item.label %></div>
                  <div class="main-strength-feature-total">
                    <strong><%= Number(total).toLocaleString('th-TH') %></strong>
                    <span>แห่ง</span>
                  </div>
                  <div class="main-strength-grade-list" aria-label="จำนวนสถาบันแยกตามชั้น">
                    <% gradeRows.forEach(function(row) { %>
                      <% const width = total > 0 ? Math.max(0, Math.min(100, (row.value / total) * 100)) : 0; %>
                      <div class="main-strength-grade-row">
                        <div class="main-strength-grade-label"><%= row.label %></div>
                        <div class="main-strength-bar" aria-hidden="true">
                          <div class="main-strength-bar-fill <%= row.className %>" style="--strength-width: <%= width %>%;"></div>
                        </div>
                        <div class="main-strength-grade-value"><%= row.value.toLocaleString('th-TH') %></div>
                      </div>
                    <% }); %>
                  </div>
                </div>
              </article>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="main-empty">ยังไม่มีข้อมูลความเข้มแข็งประจำปี <%= _strengthGradeSummary.year || '—' %></div>
      <% } %>

      <% } %>
