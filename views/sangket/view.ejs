<%- include('../partials/header.ejs', { title: title || 'รายละเอียดข้อสังเกต' }) %>
<%
  const actions = (item && item.actions) || [];
  const observationTitle = item?.observation_title || (item?.observation_text ? item.observation_text.slice(0, 120) : 'ข้อสังเกต');
  const statusLabel = ({new:'ใหม่', in_progress:'กำลังดำเนินการ', monitoring:'ติดตาม', resolved:'ปิดแล้ว', closed:'ยุติ'})[item?.status] || '-';
%>

<link rel="stylesheet" href="/css/sangket-view.css">
<link rel="stylesheet" href="/css/sangket.css">

<div class="sangket-view-page py-3 sangket-workspace">
  <div class="container">
    <%- include('navigation', { current: 'view', pageLabel: 'รายละเอียดข้อสังเกต' }) %>
    <div class="view-shell">
      <div class="view-hero p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
          <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
              <span class="badge text-bg-primary"><%= statusLabel %></span>
              <span class="text-muted small">กสส. <%= item.promotion_group_no || '-' %></span>
            </div>
            <h1 class="h3 fw-bold mb-1"><%= item.cooperative_name %></h1>
            <p class="text-muted mb-0"><%= item.cooperative_code || '-' %> · <%= item.fiscal_year_end || '-' %></p>
          </div>
          <div class="d-flex flex-wrap gap-2 align-items-start">
            <a href="/sangket/edit/<%= item.observation_id %>" class="btn btn-outline-secondary"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i> แก้ไขข้อสังเกต</a>
            <a href="/sangket/cooperatives/<%= item.cooperative_id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> กลับ</a>
          </div>
        </div>
      </div>

      <div class="p-3 p-lg-4">
        <div class="simple-workflow-grid mb-4">
          <section class="detail-card observation-card" aria-labelledby="observation-heading">
            <div class="step-label mb-2"><span>1</span> รายละเอียดข้อสังเกต</div>
            <h2 id="observation-heading" class="h5 fw-bold mb-3"><%= observationTitle %></h2>
            <div class="observation-text"><%= item.observation_text || '-' %></div>
            <dl class="observation-meta row g-3 mt-3 mb-0">
              <div class="col-md-6"><dt>กลุ่มส่งเสริมสหกรณ์</dt><dd><%= item.promotion_group_no ? `กลุ่ม ${item.promotion_group_no}` : '-' %></dd></div>
              <div class="col-md-6"><dt>ผู้รับผิดชอบ</dt><dd><%= item.responsible_name || '-' %></dd></div>
              <div class="col-12"><dt>หมายเหตุอื่น ๆ</dt><dd class="mb-0"><%= item.remark || '-' %></dd></div>
            </dl>
          </section>

          <section class="detail-card report-card-simple" aria-labelledby="report-heading">
            <div class="step-label mb-2"><span>2</span> รายงานการแก้ไข</div>
            <h2 id="report-heading" class="h5 fw-bold mb-1">ส่งรายงานผลพร้อมหลักฐาน</h2>
            <p class="text-muted small mb-3">สำหรับเจ้าหน้าที่ส่งเสริม กรุณากรอกผลการดำเนินงานและแนบไฟล์หลักฐาน</p>
            <form method="POST" action="/sangket/view/<%= item.observation_id %>/actions" enctype="multipart/form-data" class="row g-3">
              <div class="col-12">
                <label class="form-label" for="sangket-report-detail">รายงานผลการแก้ไข <span class="text-danger">*</span></label>
                <textarea name="action_detail" class="form-control" rows="6" id="sangket-report-detail" maxlength="5000" placeholder="ระบุสิ่งที่ดำเนินการ ผลการแก้ไข และข้อมูลที่เกี่ยวข้อง" required></textarea>
              </div>
              <div class="col-12">
                <label class="form-label" for="sangket-status">สถานะของข้อสังเกต</label>
                <select name="status" class="form-select" id="sangket-status">
                  <% Object.entries({new:'ใหม่', in_progress:'กำลังดำเนินการ', monitoring:'ติดตาม', resolved:'ปิดแล้ว', closed:'ยุติ'}).forEach(([value, label]) => { %>
                    <option value="<%= value %>" <%= item.status === value ? 'selected' : '' %>><%= label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label" for="sangket-evidence">ไฟล์หลักฐาน <span class="text-danger">*</span></label>
                <input type="file" name="evidence" class="form-control" id="sangket-evidence" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" required>
                <div class="form-text">รองรับ PDF, Word, Excel และรูปภาพ ขนาดไม่เกิน 10 MB</div>
              </div>
              <div class="col-12 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i> ส่งรายงานและหลักฐาน</button>
              </div>
            </form>
          </section>
        </div>

        <section class="detail-card" aria-labelledby="history-heading">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 id="history-heading" class="h5 fw-bold mb-0">ประวัติรายงานการแก้ไข</h2>
            <span class="badge text-bg-light border"><%= actions.length %> รายการ</span>
          </div>
          <% if (actions.length) { %>
            <div class="d-grid gap-3">
              <% actions.forEach((action) => { %>
                <article class="timeline-item">
                  <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                    <div>
                      <div class="fw-semibold"><%= action.created_by || 'เจ้าหน้าที่ส่งเสริม' %></div>
                      <div class="text-muted small"><%= action.created_at ? new Date(action.created_at).toLocaleString('th-TH') : '' %></div>
                    </div>
                    <form method="POST" action="/sangket/view/<%= item.observation_id %>/actions/<%= action.id %>/delete" onsubmit="return confirm('ต้องการลบรายงานรายการนี้ใช่ไหม');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="ลบรายงาน"><i class="bi bi-trash" aria-hidden="true"></i></button>
                    </form>
                  </div>
                  <div class="report-detail mt-2"><%= action.action_detail || action.result || '-' %></div>
                  <% if (action.attachment_path) { %>
                    <a class="btn btn-sm btn-outline-primary mt-3" href="/sangket/view/<%= item.observation_id %>/actions/<%= action.id %>/evidence" target="_blank" rel="noopener"><i class="bi bi-paperclip me-1" aria-hidden="true"></i><%= action.attachment_name || 'เปิดไฟล์หลักฐาน' %></a>
                  <% } %>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-report text-center py-4">
              <i class="bi bi-file-earmark-check fs-2 text-muted" aria-hidden="true"></i>
              <p class="text-muted mb-0 mt-2">ยังไม่มีรายงานการแก้ไข</p>
            </div>
          <% } %>
        </section>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
