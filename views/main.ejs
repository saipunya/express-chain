          <div class="main-online-summary">
            <div>
              <div class="text-muted small">บุคคลทั่วไปออนไลน์ขณะนี้</div>
              <div class="main-online-count" id="onlineCountSummary" aria-live="polite"><%= _onlineCount %></div>
            </div>
            <span class="main-pill">
              <i class="bi bi-circle-fill main-online-dot"></i>
              <span>อัปเดตแบบเรียลไทม์</span>
            </span>
          </div>

          <% if (_onlineUsers.length) { %>
            <div class="main-online-list">
              <% _onlineUsers.forEach(function(user) { %>
                <div class="main-online-user">
                  <img src="<%= user.m_img || '/images/default-avatar.png' %>" alt="Avatar" class="main-online-avatar" loading="lazy" decoding="async">
                  <div class="min-w-0">
                    <div class="main-online-name"><%= user.on_name %></div>
                    <div class="main-online-position"><%= user.m_position || 'ผู้ใช้งาน' %></div>
                  </div>
                  <span class="badge text-bg-success ms-auto">
                    <i class="bi bi-circle-fill main-online-dot"></i>
                  </span>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="main-empty">ไม่มีสมาชิกออนไลน์ในขณะนี้</div>
          <% } %>
        </div>
      </div>

      <% } %>
    </section>

  </section>
</div>

<script src="/socket.io/socket.io.js"></script>

<script>
  (function() {
    var countEls = [
      document.getElementById('onlineCountValue'),
      document.getElementById('onlineCountSummary')
    ].filter(Boolean);

    if (!countEls.length || typeof io === 'undefined') return;

    try {
      var socket = io();
      socket.on('onlineUsers', function(count) {
        if (typeof count !== 'number') return;
        countEls.forEach(function(el) {
          el.textContent = count;
        });
      });
    } catch (error) {
      console.warn('Socket init failed:', error);
    }
  })();
</script>

<script>
  (function() {
    var institutionSummary = <%- JSON.stringify(_institutionSummary).replace(/</g, '\\u003c') %>;
    var institutionChartData = <%- JSON.stringify(_institutionChartData).replace(/</g, '\\u003c') %>;
    var turnoverChartData = <%- JSON.stringify(_turnoverCategoryList.map((item) => ({
      label: item.label,
      totalAmount: Number(item.totalAmount || 0),
      institutionCount: Number(item.institutionCount || 0),
      color: item.tone === 'teal' ? '#116c7a' : item.tone === 'amber' ? '#c98312' : '#137a57'
    }))).replace(/</g, '\\u003c') %>;
    var turnoverTotalAmount = <%- JSON.stringify(_turnoverTotalAmount).replace(/</g, '\\u003c') %>;
    window.mainDashboardData = { institutionSummary, institutionChartData, turnoverChartData, turnoverTotalAmount };
  })();
</script>


