<%- include('partials/head') %>
<div class="section-heading"><div><span class="section-kicker">TODAY'S WORK</span><h2>คิวงานที่ต้องดำเนินการ</h2><p>RED ที่ยังไม่ติดตามมาก่อน ตามด้วยรายการเกิน 30 วัน และรายการใกล้ครบกำหนด</p></div></div>
<section class="panel"><div class="panel-head"><h2>รายการตามลำดับความสำคัญ</h2><span class="text-muted"><%= tasks.length %> รายการ</span></div><% if(!tasks.length){ %><div class="empty-state"><i class="bi bi-check2-circle"></i><p>ไม่มีงานเร่งด่วน</p></div><% }else{ %><div class="table-responsive"><table class="table debt-table"><thead><tr><th>#</th><th>ประเภท</th><th>ระดับ</th><th>สหกรณ์ / รายการ</th><th>เหตุผล</th><th>กำหนด</th><th></th></tr></thead><tbody><% tasks.forEach((x,i)=>{ %><tr><td class="queue-no"><%= i+1 %></td><td><span class="domain-pill"><%= x.domain_name==='CDF'?'กพส.':'สมาชิก' %></span></td><td><%- include('partials/risk-badge',{risk:x.risk_color}) %></td><td><strong><%= x.c_name %></strong><small><%= x.display_name || x.item_no %></small></td><td><%= x.reason %></td><td><%= debtDate(x.due_date) %></td><td><a class="btn btn-sm btn-light" href="<%= x.domain_name==='CDF'?`/debt/cdf/contracts/${x.item_id}`:`/debt/member-debt/loans/${x.item_id}` %>">ดำเนินการ</a></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include('partials/foot') %>
