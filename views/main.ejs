            <p class="lead mb-0 mt-3">สหกรณ์และกลุ่มเกษตรกรในจังหวัดชัยภูมิ</p>
          </div>
          <section class="main-district-summary" aria-labelledby="institutionDistrictTitle">
            <% if (!_institutionDistrictUnavailable) { %>
              <dl class="main-district-totals" aria-label="จำนวนสถาบันที่ดำเนินการ">
                <div class="main-district-total"><dt>สหกรณ์</dt><dd><%= _institutionDistrictSummary.totals.cooperatives.toLocaleString('th-TH') %> <small>แห่ง</small></dd></div>
                <div class="main-district-total"><dt>กลุ่มเกษตรกร</dt><dd><%= _institutionDistrictSummary.totals.farmerGroups.toLocaleString('th-TH') %> <small>แห่ง</small></dd></div>
                <div class="main-district-total"><dt>รวมทั้งหมด</dt><dd><%= _institutionDistrictSummary.totals.total.toLocaleString('th-TH') %> <small>แห่ง</small></dd></div>
              </dl>
            <% } %>
            <div class="main-district-head">
              <h3 id="institutionDistrictTitle">จำนวนแยกตามอำเภอ</h3>
              <span>เฉพาะสถานะดำเนินการ · หน่วย: แห่ง</span>
            </div>
            <% if (_institutionDistrictUnavailable) { %>
              <div class="main-empty" role="status">ไม่สามารถโหลดจำนวนรายอำเภอได้ในขณะนี้ กรุณาลองใหม่ภายหลัง</div>
            <% } else if (_institutionDistrictSummary.rows.length) { %>
              <div class="main-district-table-wrap" tabindex="0" role="region" aria-labelledby="institutionDistrictTitle">
                <table class="main-district-table">
                  <caption class="visually-hidden">จำนวนสหกรณ์และกลุ่มเกษตรกรที่ดำเนินการในจังหวัดชัยภูมิ แยกตามอำเภอ</caption>
                  <thead><tr><th scope="col">อำเภอ</th><th scope="col">สหกรณ์</th><th scope="col">กลุ่มเกษตรกร</th><th scope="col">รวม</th></tr></thead>
                  <tbody>
                    <% _institutionDistrictSummary.rows.forEach(function(item) { %>
                      <tr class="<%= item.isUnknown ? 'main-district-unknown' : '' %>">
                        <th scope="row"><%= item.district %></th>
                        <td><%= item.cooperatives.toLocaleString('th-TH') %></td>
                        <td><%= item.farmerGroups.toLocaleString('th-TH') %></td>
                        <td><%= item.total.toLocaleString('th-TH') %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                  <tfoot><tr><th scope="row">รวมทั้งหมด</th><td><%= _institutionDistrictSummary.totals.cooperatives.toLocaleString('th-TH') %></td><td><%= _institutionDistrictSummary.totals.farmerGroups.toLocaleString('th-TH') %></td><td><%= _institutionDistrictSummary.totals.total.toLocaleString('th-TH') %></td></tr></tfoot>
                </table>
              </div>
              <p class="main-district-note">เลื่อนตารางเพื่อดูทุกอำเภอ<% if (_institutionDistrictSummary.unknownTotal) { %> · ยังไม่ระบุอำเภอ <%= _institutionDistrictSummary.unknownTotal.toLocaleString('th-TH') %> แห่ง<% } %></p>
            <% } else { %>
              <div class="main-empty">ยังไม่มีข้อมูลสหกรณ์และกลุ่มเกษตรกรที่ดำเนินการ</div>
            <% } %>
          </section>
        </div>
      </div>
    </div>

