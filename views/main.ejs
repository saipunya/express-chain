              <div class="d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="main-chamra-overview-label">สถาบันทั้งหมด</div>
                  <div class="main-chamra-overview-value"><%= Number(_chamraSummary.total || 0).toLocaleString('th-TH') %></div>
                  <div class="small text-white-50 mt-2">แห่งที่อยู่ในทะเบียนชำระบัญชี</div>
                </div>
                <div class="main-chamra-progress-ring" style="--chamra-progress:<%= Math.max(0, Math.min(100, Number(_chamraSummary.completionPercent || 0))) %>%" aria-label="ถอนชื่อแล้ว <%= Number(_chamraSummary.completionPercent || 0).toFixed(1) %> เปอร์เซ็นต์">
                  <span class="main-chamra-progress-value"><%= Number(_chamraSummary.completionPercent || 0).toFixed(1) %>%</span>
                </div>
              </div>
              <div class="main-chamra-kind-list">
                <div class="main-chamra-kind">
                  <span><i class="bi bi-building me-1"></i>สหกรณ์</span>
                  <strong><%= Number(_chamraSummary.cooperativeCount || 0).toLocaleString('th-TH') %> แห่ง</strong>
                </div>
                <div class="main-chamra-kind">
                  <span><i class="bi bi-people me-1"></i>กลุ่มเกษตรกร</span>
                  <strong><%= Number(_chamraSummary.farmerGroupCount || 0).toLocaleString('th-TH') %> แห่ง</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-8">
            <div class="row g-3 mb-3">
              <div class="col-4">
                <div class="main-chamra-kpi">
                  <div class="main-chamra-kpi-label">กำลังดำเนินการ</div>
                  <div class="main-chamra-kpi-value text-primary"><%= Number(_chamraSummary.inProgress || 0).toLocaleString('th-TH') %></div>
                  <div class="main-chamra-kpi-note">ขั้นที่ 1–8</div>
                </div>
              </div>
              <div class="col-4">
                <div class="main-chamra-kpi">
                  <div class="main-chamra-kpi-label">ถอนชื่อแล้ว</div>
                  <div class="main-chamra-kpi-value text-success"><%= Number(_chamraSummary.withdrawn || 0).toLocaleString('th-TH') %></div>
                  <div class="main-chamra-kpi-note">ขั้นที่ 9–10</div>
                </div>
              </div>
              <div class="col-4">
                <div class="main-chamra-kpi">
                  <div class="main-chamra-kpi-label">ยังไม่มีขั้นตอน</div>
                  <div class="main-chamra-kpi-value text-secondary"><%= Number(_chamraSummary.noProcess || 0).toLocaleString('th-TH') %></div>
                  <div class="main-chamra-kpi-note">รอบันทึกข้อมูล</div>
                </div>
              </div>
            </div>

            <div class="main-chamra-stage-panel">
              <div class="d-flex align-items-center justify-content-between gap-3">
                <div class="fw-bold"><i class="bi bi-diagram-3 text-success me-2"></i>จำนวนตามขั้นตอนล่าสุด</div>
                <span class="small text-muted"><%= _chamraSteps.length %> ขั้นที่มีข้อมูล</span>
              </div>
              <div class="main-chamra-stage-list">
                <% _chamraSteps.forEach(function(item) { %>
                  <div class="main-chamra-stage">
                    <div class="main-chamra-stage-label"><strong>ขั้นที่ <%= item.step %></strong> · <%= item.label %></div>
                    <div class="main-chamra-stage-bar" aria-hidden="true">
