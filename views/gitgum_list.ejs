<%- include('partials/header') %>

<% const totalRecords = (pagination && pagination.total) || data.length; %>
<% const currentPage = (pagination && pagination.page) || 1; %>
<% const totalPages = (pagination && pagination.totalPages) || 1; %>
<% const pageSize = (pagination && pagination.pageSize) || data.length || 0; %>
<%
  const formatThaiDate = (value) => {
    let result = '-';
    if (value) {
      const date = value instanceof Date ? value : new Date(value);
      if (!Number.isNaN(date.getTime())) {
        result = date.toLocaleDateString('th-TH', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'Asia/Bangkok'
        });
      } else {
        result = String(value).slice(0, 10);
      }
    }
    return result;
  };
%>

<div class="gitgum-page">
  <header class="gitgum-toolbar">
    <div>
      <h1 class="gitgum-page-title">ปฏิทินงานและกิจกรรม</h1>
      <p class="text-muted small mb-0">กำหนดการที่กำลังจะมาถึง · ทั้งหมด <%= totalRecords.toLocaleString('th-TH') %> รายการ</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/gitgum/calendar" class="btn btn-outline-success btn-sm"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>ดูปฏิทิน</a>
      <% if (user) { %>
        <a href="/gitgum/add" class="btn btn-success btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>เพิ่มกิจกรรม</a>
      <% } %>
    </div>
  </header>

  <div class="card shadow-sm border-0 gitgum-list-shell">
    <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
      <h2 class="h6 mb-0 fw-semibold">รายการกิจกรรม</h2>
      <span class="text-muted small">แสดง <%= data.length %> รายการ · หน้า <%= currentPage %>/<%= totalPages %></span>
    </div>
    <div class="card-body p-0">
      <% if (data && data.length) { %>
        <div class="gitgum-event-list">
          <% data.forEach(gitgum => { %>
            <article class="gitgum-list-item">
              <div class="row g-0 align-items-stretch">
                <div class="<%= user ? 'col-lg-10' : 'col-12' %>">
                  <div class="gitgum-list-content">
                    <div class="gitgum-schedule-layout">
                      <div class="gitgum-date-card">
                        <span class="gitgum-date-icon"><i class="bi bi-calendar-event"></i></span>
                        <div>

                          <div class="gitgum-date-value"><%= gitgum.git_date_label || formatThaiDate(gitgum.git_date) %></div>
                          <div class="gitgum-time-value"><i class="bi bi-clock me-1"></i><%= gitgum.git_time || 'ไม่ระบุเวลา' %></div>
                        </div>
                      </div>

                      <div class="gitgum-activity-content">
                        <% if (gitgum.sourceLabel) { %>
                          <span class="gitgum-source-badge"><i class="bi bi-bookmark me-1"></i><%= gitgum.sourceLabel %></span>
                        <% } %>
                        <h3 class="gitgum-activity-title"><%= gitgum.git_act || '-' %></h3>
                        <div class="gitgum-meta-grid">
                          <div class="gitgum-meta-item">
                            <i class="bi bi-geo-alt"></i>
                            <div><span>สถานที่</span><strong><%= gitgum.git_place || '-' %></strong></div>
                          </div>
                          <div class="gitgum-meta-item">
                            <i class="bi bi-person-badge"></i>
                            <div><span>ผู้รับผิดชอบ</span><strong><%= gitgum.git_respon || gitgum.git_goto || '-' %></strong></div>
                          </div>
                          <% if (gitgum.git_goto && gitgum.git_goto !== '-' && gitgum.git_goto !== gitgum.git_respon) { %>
                            <div class="gitgum-meta-item">
                              <i class="bi bi-people"></i>
                              <div><span>ผู้เกี่ยวข้อง</span><strong><%= gitgum.git_goto %></strong></div>
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <% if(user){ %>
                <div class="col-lg-2">
                  <div class="gitgum-actions-panel h-100">

                    <div class="d-flex flex-wrap gap-2 gitgum-action-buttons">
                      <button type="button"
                        class="btn btn-soft-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#gitgumDetailModal"
                        data-gitgum-title="<%= gitgum.git_act || '-' %>"
                        data-gitgum-date="<%= gitgum.git_date_label || formatThaiDate(gitgum.git_date) %>"
                        data-gitgum-time="<%= gitgum.git_time || '-' %>"
                        data-gitgum-act="<%= gitgum.git_act || '-' %>"
                        data-gitgum-place="<%= gitgum.git_place || '-' %>"
                        data-gitgum-respon="<%= gitgum.git_respon || '-' %>"
                        data-gitgum-goto="<%= gitgum.git_goto || '-' %>"
                        data-gitgum-group="<%= gitgum.git_group || '-' %>"
                        data-gitgum-maihed="<%= gitgum.git_maihed || '-' %>"
                        data-gitgum-saveby="<%= gitgum.git_saveby || '-' %>"
                        data-gitgum-savedate="<%= formatThaiDate(gitgum.git_savedate) %>"
                        data-gitgum-view-url="<%= gitgum.detailUrl || '#' %>"
                        data-gitgum-edit-url="<%= gitgum.editUrl || '' %>"
                        data-gitgum-delete-url="<%= gitgum.deleteUrl || '' %>">
                        <i class="bi bi-eye me-1" aria-hidden="true"></i> รายละเอียด
                      </button>
                      <% if (gitgum.canManage) { %>
                        <a href="<%= gitgum.editUrl %>" class="btn btn-soft-warning btn-sm">
                          <i class="bi bi-pencil-square me-1"></i> แก้ไข
                        </a>
                        <a href="<%= gitgum.deleteUrl %>" class="btn btn-soft-danger btn-sm" onclick="return confirm('ลบข้อมูล?')">
                          <i class="bi bi-trash me-1"></i> ลบ
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <div class="gitgum-empty-icon mb-3">
            <i class="bi bi-calendar-x"></i>
          </div>
          <h5 class="fw-bold mb-2">ยังไม่มีรายการกิจกรรม</h5>
          <p class="text-muted mb-3">เริ่มต้นด้วยการเพิ่มกิจกรรมใหม่ เพื่อให้รายการแสดงอยู่ที่นี่</p>
          <% if(user){ %>
            <a href="/gitgum/add" class="btn btn-success">
              <i class="bi bi-plus-circle me-1"></i> เพิ่มรายการแรก
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <% if (pagination && pagination.totalPages > 1) { %>
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mt-4">
      <div class="text-muted small">
        หน้า <span class="fw-semibold"><%= pagination.page %></span> จาก <span class="fw-semibold"><%= pagination.totalPages %></span>
        · ทั้งหมด <span class="fw-semibold"><%= pagination.total %></span> รายการ
      </div>

      <nav aria-label="Gitgum pagination">
        <ul class="pagination pagination-sm mb-0 flex-wrap justify-content-center justify-content-md-end">
          <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
            <a class="page-link" href="<%= pagination.hasPrev ? `/gitgum/list?page=${pagination.page - 1}&pageSize=${pagination.pageSize}` : '#' %>" aria-label="ก่อนหน้า">
              <i class="bi bi-chevron-left me-1"></i> ก่อนหน้า
            </a>
          </li>

          <% let previousPage = 0;
             for (let p = 1; p <= pagination.totalPages; p++) {
               if (p !== 1 && p !== pagination.totalPages && Math.abs(p - currentPage) > 1) continue;
               if (previousPage && p - previousPage > 1) { %>
                 <li class="page-item disabled"><span class="page-link">…</span></li>
               <% } previousPage = p; %>
            <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
              <a class="page-link" <%- p === currentPage ? 'aria-current="page"' : '' %> href="/gitgum/list?page=<%= p %>&pageSize=<%= pagination.pageSize %>"><%= p %></a>
            </li>
          <% } %>

          <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
            <a class="page-link" href="<%= pagination.hasNext ? `/gitgum/list?page=${pagination.page + 1}&pageSize=${pagination.pageSize}` : '#' %>" aria-label="ถัดไป">
              ถัดไป <i class="bi bi-chevron-right ms-1"></i>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<div class="modal fade" id="gitgumDetailModal" tabindex="-1" aria-labelledby="gitgumDetailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-gradient-success text-white border-0">
        <div>
          <p class="small text-white-50 text-uppercase fw-semibold mb-1">รายละเอียดกิจกรรม</p>
          <h5 class="modal-title fw-bold mb-0" id="gitgumDetailModalLabel">-</h5>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body bg-white">
        <div class="p-3 p-md-4 rounded-4 bg-light border mb-4">
          <div class="d-flex align-items-start gap-3">
            <div class="gitgum-hero-icon flex-shrink-0">
              <i class="bi bi-calendar2-event"></i>
            </div>
            <div class="min-w-0">
              <div class="text-muted small mb-1">กิจกรรม</div>
              <div class="fw-bold fs-5 text-dark text-truncate" data-modal-field="activityTitle">-</div>
              <div class="text-muted small mt-1">
                <span class="me-3"><i class="bi bi-calendar-event me-1"></i><span data-modal-field="date">-</span></span>
                <span><i class="bi bi-clock me-1"></i><span data-modal-field="time">-</span></span>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-geo-alt-fill me-1"></i> สถานที่</div>
              <div class="fw-semibold text-dark" data-modal-field="place">-</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-person-badge me-1"></i> ผู้รับผิดชอบ</div>
              <div class="fw-semibold text-dark" data-modal-field="respon">-</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-person-check me-1"></i> ผู้ไป/ผู้เกี่ยวข้อง</div>
              <div class="fw-semibold text-dark" data-modal-field="goto">-</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-people me-1"></i> กลุ่ม/หน่วยงาน</div>
              <div class="fw-semibold text-dark" data-modal-field="group">-</div>
            </div>
          </div>
          <div class="col-12">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-journal-text me-1"></i> หมายเหตุ</div>
              <div class="fw-semibold text-dark" data-modal-field="maihed">-</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-pencil-square me-1"></i> บันทึกโดย</div>
              <div class="fw-semibold text-dark" data-modal-field="saveby">-</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded-4 border h-100">
              <div class="text-muted small fw-semibold mb-1"><i class="bi bi-calendar-check me-1"></i> วันที่บันทึก</div>
              <div class="fw-semibold text-dark" data-modal-field="savedate">-</div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer bg-light border-0">
        <a href="#" class="btn btn-outline-primary" data-modal-action="view-full" target="_blank" rel="noopener">
          <i class="bi bi-box-arrow-up-right me-1"></i> เปิดหน้ารายละเอียดเต็ม
        </a>
        <% if(user){ %>
          <a href="#" class="btn btn-warning text-white" data-modal-action="edit">
            <i class="bi bi-pencil-square me-1"></i> แก้ไข
          </a>
          <a href="#" class="btn btn-danger" data-modal-action="delete" onclick="return confirm('ลบข้อมูล?')">
            <i class="bi bi-trash me-1"></i> ลบ
          </a>
        <% } %>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
      </div>
    </div>
  </div>
</div>

<style>
  .gitgum-page { color: #24352e; }
  .gitgum-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .gitgum-page-title { font-size: 1.5rem; font-weight: 700; margin: 0 0 .35rem; }
  .gitgum-list-shell { border: 1px solid #dfe7e2 !important; border-radius: 12px; overflow: hidden; box-shadow: none !important; }
  .gitgum-list-shell > .card-header { padding: .8rem 1rem; border-bottom: 1px solid #dfe7e2; }
  .gitgum-list-item { background: #fff; border: 0; border-radius: 0; transition: none; }
  .gitgum-list-item + .gitgum-list-item { border-top: 1px solid #e7ece9; }
  .gitgum-list-item:hover { background: #f8fbf9; transform: none; box-shadow: none; }
  .gitgum-list-content { padding: 1rem; }
  .gitgum-schedule-layout { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 1rem; }
  .gitgum-date-card { display: flex; gap: .5rem; align-items: flex-start; }
  .gitgum-date-icon { color: #198754; }
  .gitgum-date-value { font-size: .85rem; font-weight: 600; }
  .gitgum-time-value { color: #66756c; font-size: .8rem; margin-top: .25rem; }
  .gitgum-activity-content { min-width: 0; overflow-wrap: anywhere; }
  .gitgum-source-badge { display: inline-block; color: #53665c; font-size: .7rem; margin-bottom: .25rem; }
  .gitgum-activity-title { font-size: .98rem; line-height: 1.5; font-weight: 600; margin: 0 0 .4rem; }
  .gitgum-meta-grid { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  .gitgum-meta-item { display: flex; align-items: baseline; gap: .3rem; min-width: 0; font-size: .8rem; color: #67776d; }
  .gitgum-meta-item > div { min-width: 0; }
  .gitgum-meta-item span { margin-right: .3rem; }
  .gitgum-meta-item strong { color: #536359; font-weight: 400; overflow-wrap: anywhere; }
  .gitgum-actions-panel { background: transparent; border: 0; flex-direction: row; display: flex; align-items: center; justify-content: flex-end; padding: 1rem 1rem 1rem 0; }
  .gitgum-action-buttons { justify-content: flex-end; }
  .gitgum-actions-panel .btn { font-size: .75rem; white-space: nowrap; }
  .gitgum-empty-icon { color: #198754; font-size: 2rem; }
  #gitgumDetailModal .modal-content { border-radius: 12px; overflow: hidden; }
  #gitgumDetailModal [data-modal-field] { overflow-wrap: anywhere; white-space: normal; }
  @media (max-width: 991.98px) {
    .gitgum-actions-panel { padding: 0 1rem .8rem; }
    .gitgum-action-buttons { justify-content: flex-start; }
  }
  @media (max-width: 575.98px) {
    .gitgum-toolbar { align-items: flex-start; flex-direction: column; gap: .75rem; }
    .gitgum-page-title { font-size: 1.25rem; }
    .gitgum-schedule-layout { grid-template-columns: minmax(0, 1fr); gap: .6rem; }
    .gitgum-date-card { align-items: baseline; }
    .gitgum-date-card > div { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; }
    .gitgum-time-value { margin: 0; }
    .gitgum-meta-grid { flex-direction: column; }
    .gitgum-list-content { padding: .85rem; }
    .gitgum-actions-panel { padding: 0 .85rem .85rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('gitgumDetailModal');
    if (!modal) return;

    modal.addEventListener('show.bs.modal', function (event) {
      var button = event.relatedTarget;
      if (!button) return;

      var title = button.getAttribute('data-gitgum-title') || '-';
      var fields = {
        activityTitle: button.getAttribute('data-gitgum-act') || '-',
        date: button.getAttribute('data-gitgum-date') || '-',
        time: button.getAttribute('data-gitgum-time') || '-',
        place: button.getAttribute('data-gitgum-place') || '-',
        respon: button.getAttribute('data-gitgum-respon') || '-',
        goto: button.getAttribute('data-gitgum-goto') || '-',
        group: button.getAttribute('data-gitgum-group') || '-',
        maihed: button.getAttribute('data-gitgum-maihed') || '-',
        saveby: button.getAttribute('data-gitgum-saveby') || '-',
        savedate: button.getAttribute('data-gitgum-savedate') || '-'
      };

      var titleEl = modal.querySelector('#gitgumDetailModalLabel');
      if (titleEl) titleEl.textContent = title;

      Object.keys(fields).forEach(function (key) {
        var el = modal.querySelector('[data-modal-field="' + key + '"]');
        if (el) el.textContent = fields[key];
      });

      var viewUrl = button.getAttribute('data-gitgum-view-url') || '#';
      var editUrl = button.getAttribute('data-gitgum-edit-url') || '#';
      var deleteUrl = button.getAttribute('data-gitgum-delete-url') || '#';

      var viewLink = modal.querySelector('[data-modal-action="view-full"]');
      if (viewLink) viewLink.setAttribute('href', viewUrl);

      var editLink = modal.querySelector('[data-modal-action="edit"]');
      if (editLink) {
        editLink.setAttribute('href', editUrl || '#');
        editLink.classList.toggle('d-none', !editUrl || editUrl === '#');
      }

      var deleteLink = modal.querySelector('[data-modal-action="delete"]');
      if (deleteLink) {
        deleteLink.setAttribute('href', deleteUrl || '#');
        deleteLink.classList.toggle('d-none', !deleteUrl || deleteUrl === '#');
      }
    });
  });
</script>

<%- include('partials/footer') %>
