              <canvas id="institutionSummaryChart" aria-label="กราฟจำนวนสถาบันตามประเภท" role="img"></canvas>
              <ul class="main-chart-fallback" id="institutionSummaryChartFallback" hidden>
                <% _institutionChartData.forEach(function(item) { %>
                  <li>
                    <span><span class="main-chart-dot" style="--dot-color: <%= item.color %>"></span><%= item.label %></span>
                    <strong><%= item.count %> แห่ง</strong>
                  </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-4">
          <div class="main-institution-chart-card">
            <div class="main-chart-head">
              <div>
                <h3 class="main-chart-title">
                  <i class="bi bi-pie-chart"></i>
                  สัดส่วนตามประเภท
                </h3>
                <div class="text-muted small mt-1">เทียบสัดส่วนจำนวนสถาบันทั้งหมด</div>
              </div>
            </div>

            <div class="main-chart-canvas-wrap compact">
              <canvas id="institutionShareChart" aria-label="กราฟสัดส่วนจำนวนสถาบันตามประเภท" role="img"></canvas>
              <ul class="main-chart-fallback" id="institutionShareChartFallback" hidden>
                <% _institutionChartData.forEach(function(item) { %>
                  <li>
                    <span><span class="main-chart-dot" style="--dot-color: <%= item.color %>"></span><%= item.label %></span>
                    <strong><%= _institutionTotal ? Math.round((Number(item.count || 0) / _institutionTotal) * 100) : 0 %>%</strong>
                  </li>
                <% }); %>
              </ul>
            </div>
            <div class="main-chart-kpi-grid">
              <% _institutionChartData.forEach(function(item) { %>
                <div class="main-chart-kpi">
                  <div class="main-chart-kpi-label"><%= item.label %></div>
                  <div class="main-chart-kpi-value"><%= _institutionTotal ? Math.round((Number(item.count || 0) / _institutionTotal) * 100) : 0 %>%</div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-4">
          <div class="row g-3 h-100">
            <% _institutionSummaryList.forEach(function(item) { %>
              <div class="col-md-4 col-xl-12">
                <button
                  type="button"
                  class="main-institution-card"
                  data-institution-type="<%= item.key %>"
                  data-bs-toggle="modal"
                  data-bs-target="#institutionSummaryModal">
                  <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                      <div class="main-institution-label"><%= item.label %></div>
                      <div class="main-institution-count mt-2"><%= item.count || 0 %></div>
                      <div class="main-institution-hint mt-2">
                        <span>ดูรายชื่อ</span>
                        <i class="bi bi-arrow-right-short"></i>
                      </div>
                    </div>
                    <div class="main-stat-icon <%= item.tone %>">
                      <i class="bi <%= item.icon %>"></i>
                    </div>
                  </div>
                </button>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>

    <section class="main-institution-section" id="cooperativeMapSection" aria-labelledby="cooperativeMapTitle" data-unavailable="<%= _cooperativeMapUnavailable %>">
      <div class="main-coop-map-card">
        <div class="main-coop-map-head">
          <div class="main-coop-map-title">
            <span class="main-coop-map-title-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
            <div>
              <h2 id="cooperativeMapTitle">แผนที่สหกรณ์และกลุ่มเกษตรกรในจังหวัดชัยภูมิ</h2>
              <div class="text-muted small">
                ค้นหาสถาบัน แล้วเลือกจุดบนแผนที่เพื่อดูที่ตั้งและเส้นทาง
                <% if (_cooperativeMapIsDemo) { %><span class="badge text-bg-warning ms-1">ข้อมูลตัวอย่าง</span><% } %>
              </div>
            </div>
          </div>
          <% if (_canManageCooperativeLocations) { %>
            <a href="/cooperative-locations" class="btn btn-outline-success btn-sm text-nowrap"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>จัดการพิกัด</a>
          <% } %>
        </div>
        <div class="main-coop-map-tools">
          <div class="main-coop-map-search">
            <label for="cooperativeMapSearch">ค้นหาสหกรณ์หรือกลุ่มเกษตรกร</label>
            <input id="cooperativeMapSearch" class="form-control" type="search" placeholder="ชื่อ รหัส หรือที่อยู่" maxlength="100" aria-controls="cooperativeMapList" disabled>
          </div>
          <div class="main-coop-map-district">
            <label for="cooperativeMapDistrict">อำเภอ</label>
            <select id="cooperativeMapDistrict" class="form-select" aria-controls="cooperativeMapList" disabled>
              <option value="">ทุกอำเภอ</option>
              <% _cooperativeMapDistricts.forEach(function(district) { %>
                <option value="<%= district %>"><%= district %></option>
              <% }); %>
            </select>
          </div>
          <button type="button" id="cooperativeMapReset" class="btn btn-outline-secondary" disabled><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>ดูทั้งหมด</button>
          <div class="main-coop-map-filters" role="group" aria-label="กรองประเภทสถาบัน">
            <button type="button" class="main-coop-map-filter active" data-map-filter="all" aria-pressed="true" disabled>ทั้งหมด</button>
            <% Object.entries(_cooperativeMapTypeLabels).forEach(function([type, label]) { %>
              <button type="button" class="main-coop-map-filter" data-map-filter="<%= type %>" aria-pressed="false" disabled><%= label %></button>
            <% }); %>
          </div>
        </div>
        <% if (_cooperativeMapUnavailable) { %>
          <div class="main-coop-map-notice" role="status">ไม่สามารถโหลดข้อมูลที่ตั้งได้ในขณะนี้ กรุณาลองใหม่ภายหลัง</div>
        <% } %>
        <div id="cooperativeMapTileError" class="main-coop-map-notice" role="status" hidden>โหลดภาพแผนที่ไม่สำเร็จ สามารถดูรายชื่อและเปิดเส้นทางผ่าน Google Maps ด้านล่างได้</div>
        <noscript><div class="main-coop-map-notice">เปิด JavaScript เพื่อใช้แผนที่และตัวกรอง หรือเปิด Google Maps จากรายชื่อด้านล่าง</div></noscript>
        <div class="main-coop-map-layout">
          <div class="main-coop-map-wrap" id="cooperativeMapWrap">
            <div class="main-coop-map-canvas" id="cooperativeMap" role="region" aria-label="แผนที่แสดงตำแหน่งสหกรณ์และกลุ่มเกษตรกรในจังหวัดชัยภูมิ"></div>
            <div class="main-coop-map-count">
              <i class="bi bi-geo-alt-fill text-success" aria-hidden="true"></i>
              <strong id="cooperativeMapCount"><%= _cooperativeMapLocations.length.toLocaleString('th-TH') %></strong>
              <span>จุดที่แสดง</span>
            </div>
            <div class="main-coop-map-error" role="status">
              <span><i class="bi bi-wifi-off d-block fs-3 mb-2" aria-hidden="true"></i>ไม่สามารถโหลดแผนที่ได้ในขณะนี้<br>เปิด Google Maps จากรายชื่อเพื่อดูที่ตั้งได้</span>
            </div>
          </div>
          <div class="main-coop-map-results">
            <h3 id="cooperativeMapResultCount" role="status" aria-live="polite">ที่ตั้งที่เผยแพร่ <%= _cooperativeMapLocations.length.toLocaleString('th-TH') %> แห่ง</h3>
            <div class="main-coop-map-result-scroll">
              <p class="main-coop-map-empty mb-0" id="cooperativeMapEmpty" <%= _cooperativeMapLocations.length ? 'hidden' : '' %>><%= _cooperativeMapUnavailable ? 'ข้อมูลที่ตั้งไม่พร้อมใช้งานชั่วคราว' : 'ยังไม่มีพิกัดที่เผยแพร่ เมื่อเจ้าหน้าที่ตรวจสอบและเผยแพร่ข้อมูลแล้ว จุดที่ตั้งจะแสดงบนแผนที่นี้' %></p>
              <ul class="main-coop-map-list" id="cooperativeMapList">
                <% _cooperativeMapLocations.forEach(function(item, index) { %>
                  <li class="main-coop-map-result" data-map-result="<%= index %>">
                    <strong class="main-coop-map-result-name"><%= item.name %></strong>
                    <div class="main-coop-map-result-detail"><%= _cooperativeMapTypeLabels[item.type] %><%= item.district ? ` · อำเภอ${item.district}` : '' %></div>
                    <% if (item.address) { %><div class="main-coop-map-result-detail"><%= item.address %></div><% } %>
                    <div class="main-coop-map-result-actions">
                      <button type="button" data-map-location="<%= index %>" aria-label="ดู <%= item.name %> บนแผนที่" hidden>ดูบนแผนที่</button>
                      <a href="<%= item.googleMapsUrl || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(item.latitude + ',' + item.longitude)) %>" target="_blank" rel="noopener noreferrer">Google Maps<span class="visually-hidden"> ของ <%= item.name %> (เปิดหน้าต่างใหม่)</span></a>
                      <% if (item.websiteUrl) { %><a href="<%= item.websiteUrl %>" target="_blank" rel="noopener noreferrer">เว็บไซต์<span class="visually-hidden"> ของ <%= item.name %> (เปิดหน้าต่างใหม่)</span></a><% } %>
                    </div>
                  </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
        <div class="main-coop-map-legend" aria-label="คำอธิบายสีบนแผนที่">
          <span><i class="main-coop-map-dot" style="--map-dot:#16845f"></i>สหกรณ์ภาคการเกษตร</span>
          <span><i class="main-coop-map-dot" style="--map-dot:#3478c7"></i>สหกรณ์นอกภาคการเกษตร</span>
          <span><i class="main-coop-map-dot" style="--map-dot:#bd7410"></i>กลุ่มเกษตรกร</span>
          <span class="ms-lg-auto"><i class="bi bi-shield-check" aria-hidden="true"></i>เฉพาะพิกัดที่ตรวจสอบและอนุญาตให้เผยแพร่</span>
        </div>
      </div>
      <script type="application/json" id="cooperativeMapData"><%- _cooperativeMapJson %></script>
    </section>
