  .main-coop-map-result-scroll { height: 24.5rem; overflow-y: auto; }
  .main-coop-map-list { list-style: none; margin: 0; padding: 0; }
  .main-coop-map-result { padding: 1rem; border-bottom: 1px solid var(--main-line); overflow-wrap: anywhere; }
