<%- include('../partials/header') %>
<%
  const monthMap = {
    '1': 'มกราคม',
    '2': 'กุมภาพันธ์',
    '3': 'มีนาคม',
    '4': 'เมษายน',
    '5': 'พฤษภาคม',
    '6': 'มิถุนายน',
    '7': 'กรกฎาคม',
    '8': 'สิงหาคม',
    '9': 'กันยายน',
    '10': 'ตุลาคม',
    '11': 'พฤศจิกายน',
    '12': 'ธันวาคม'
  };
  const toThaiMonth = (val) => {
    const key = val == null ? '' : String(val).trim();
    return monthMap[key] || key;
  };
  const toThaiYear = (val) => {
    const num = Number(val);
    if (Number.isFinite(num) && num > 0 && num < 2400) return num + 543;
    return val || '';
  };
  const profileRecordTotal = [
    data && data.addmem,
    data && data.strength,
    data && data.rules,
    data && data.rabiab,
    data && data.vong,
    data && data.finance,
    data && data.business,
    data && data.turnoverMonthly,
    data && data.turnoverYearly,
    data && data.rq2,
    data && data.assets
  ].reduce((sum, rows) => sum + (Array.isArray(rows) ? rows.length : 0), 0);
%>
<style>
  <% if (typeof embedded !== 'undefined' && embedded) { %>
  body > nav.navbar,
  body > footer,
  #a2hs-banner,
  #ios-install-banner {
    display: none !important;
  }

  body > main.container {
    max-width: none;
    padding: 0 !important;
  }
  <% } %>

  .coop-profile-page{
    --cp-bg:#f6f8fb;
    --cp-text:#172033;
    --cp-muted:#64748b;
    --cp-line:#e6ebf2;
    --cp-primary:#2563eb;
    --cp-soft:#eef4ff;
    --cp-radius:1.15rem;
    --cp-shadow:0 10px 28px rgba(15,23,42,.07);

    background:linear-gradient(180deg,#f8fbff 0%,var(--cp-bg) 100%);
    color:var(--cp-text);
    min-height:100vh;
    padding-block:1rem;
  }

  <% if (typeof embedded !== 'undefined' && embedded) { %>
  .coop-profile-page {
    min-height: 0;
    padding-block: 0;
  }
  <% } %>

  .coop-profile-page .container.py-4{
    max-width:1180px;
  }

  .coop-profile-page .profile-header-card,
  .coop-profile-page .card{
    border:1px solid var(--cp-line) !important;
    border-radius:var(--cp-radius) !important;
    box-shadow:var(--cp-shadow) !important;
    overflow:hidden;
    background:#fff;
  }

  .coop-profile-page .profile-header-card{
    background:linear-gradient(135deg,#fff 0%,#f2f7ff 100%) !important;
  }

  .coop-profile-page .coop-logo{
    flex:0 0 auto;
    width:64px !important;
    height:64px !important;
    border-radius:20px !important;
    background:var(--cp-soft) !important;
  }

  .coop-profile-page .profile-header-card h1{
    line-height:1.45;
    word-break:break-word;
    overflow-wrap:anywhere;
  }

  .coop-profile-page .section-nav{
    position:sticky;
    top:.5rem;
    z-index:20;
    display:flex;
    flex-wrap:nowrap !important;
    gap:.45rem;
    overflow-x:auto;
    padding:.55rem;
    border-radius:1rem;
    background:rgba(246,248,251,.9);
    backdrop-filter:blur(12px);
    border:1px solid var(--cp-line);
    box-shadow:var(--cp-shadow);
    -webkit-overflow-scrolling:touch;
  }

  .coop-profile-page .section-nav a{
    flex:0 0 auto;
    white-space:nowrap;
    border:0;
    border-radius:999px;
    background:#fff;
    color:#334155;
    font-weight:700;
  }

  .coop-profile-page .quick-stats .card-body{
    padding:1rem !important;
  }

  .coop-profile-page .quick-stats i{
    flex:0 0 auto;
    width:38px;
    height:38px;
    border-radius:14px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:var(--cp-soft);
  }

  .coop-profile-page .quick-stats .fw-semibold{
    overflow-wrap:anywhere;
    word-break:break-word;
  }

  .coop-profile-page .card-header{
    background:#f8fafc !important;
    border-bottom:1px solid var(--cp-line) !important;
    padding:.95rem 1rem !important;
  }

  .coop-profile-page .card-header h5,
  .coop-profile-page .card-header h6{
    font-weight:800 !important;
    color:#0f172a;
    line-height:1.45;
  }

  .coop-profile-page .badge{
    border-radius:999px;
    font-weight:700;
    white-space:normal;
    line-height:1.35;
  }

  .coop-profile-page .table{
    margin-bottom:0;
    font-size:.9rem;
  }

  .coop-profile-page .table thead th{
    background:#f8fafc !important;
    color:#475569;
    font-weight:800;
    border-bottom:1px solid var(--cp-line);
    padding:.8rem;
  }

  .coop-profile-page .table tbody td{
    padding:.8rem;
    vertical-align:middle;
    border-color:#edf2f7;
  }

  .coop-profile-page .btn{
    border-radius:.8rem;
    font-weight:700;
  }

  .coop-profile-page .section-block{
    scroll-margin-top:95px;
  }

  .coop-profile-page .mobile-scroll,
  .coop-profile-page .table-responsive{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
  }

  @media (max-width: 767.98px){
    .coop-profile-page{
      padding-block:.5rem;
    }

    .coop-profile-page .container.py-4{
      padding-left:.75rem;
      padding-right:.75rem;
    }

    .coop-profile-page .profile-header-card .card-body{
      align-items:flex-start !important;
      text-align:left;
      padding:1rem !important;
    }

    .coop-profile-page .profile-header-card .d-flex.align-items-center.gap-3{
      width:100%;
      align-items:flex-start !important;
    }

    .coop-profile-page .profile-header-card .text-md-end{
      width:100%;
    }

    .coop-profile-page .profile-header-card .text-md-end .d-flex{
      flex-wrap:wrap;
      justify-content:flex-start;
    }

    .coop-profile-page .coop-logo{
      width:52px !important;
      height:52px !important;
      border-radius:17px !important;
    }

    .coop-profile-page .profile-header-card h1{
      font-size:1rem;
    }

    .coop-profile-page .copy-code{
      display:inline-flex;
      margin-top:.35rem;
      margin-left:0 !important;
    }

    .coop-profile-page .section-nav{
      margin-left:-.15rem;
      margin-right:-.15rem;
      top:.25rem;
    }

    .coop-profile-page .section-nav a{
      font-size:.78rem;
      padding:.42rem .65rem;
    }

    .coop-profile-page .quick-stats > [class*="col-"],
    .coop-profile-page .row.my-2 > [class*="col-"]{
      width:100%;
    }

    .coop-profile-page .quick-stats .card-body{
      padding:.85rem !important;
    }

    .coop-profile-page .card-header{
      align-items:flex-start !important;
    }

    .coop-profile-page .card-header h5,
    .coop-profile-page .card-header h6{
      font-size:.95rem;
      width:100%;
    }

    .coop-profile-page .responsive-table thead{
      display:none;
    }

    .coop-profile-page .responsive-table tbody,
    .coop-profile-page .responsive-table tr,
    .coop-profile-page .responsive-table td{
      display:block;
      width:100%;
    }

    .coop-profile-page .responsive-table tbody tr{
      padding:.8rem .9rem;
      border-bottom:1px solid var(--cp-line);
      background:#fff;
    }

    .coop-profile-page .responsive-table tbody td{
      border:0 !important;
      padding:.38rem 0;
      text-align:left !important;
      white-space:normal !important;
      overflow-wrap:anywhere;
      word-break:break-word;
    }

    .coop-profile-page .responsive-table tbody td::before{
      content:attr(data-label);
      display:block;
      margin-bottom:.15rem;
      color:var(--cp-muted);
      font-size:.72rem;
      font-weight:800;
    }

    .coop-profile-page .responsive-table tbody td.row-actions .btn,
    .coop-profile-page .responsive-table tbody td .btn{
      width:100%;
      margin-top:.25rem;
    }

    .coop-profile-page .small-hide{
      display:none !important;
    }

    .coop-profile-page .text-nowrap{
      white-space:normal !important;
    }

    /* 1. ขอบนอกสุด (กันชิดจอเกินไป) */
    .coop-profile-page .container.py-4{
      padding-left:1rem !important;
      padding-right:1rem !important;
    }

    /* 2. card หลัก */
    .coop-profile-page .card{
      padding:0 !important; /* reset ก่อน */
      border-radius:1rem !important;
    }

    /* 3. เนื้อด้านใน card */
    .coop-profile-page .card-body{
      padding:1.1rem !important;
    }

    /* 4. header */
    .coop-profile-page .card-header{
      padding:1rem 1.1rem !important;
    }

    /* 5. table → card block */
    .coop-profile-page .responsive-table tbody tr{
      margin-bottom:.75rem;
      padding:1rem 1rem !important;
      border-radius:.9rem;
      background:#fff;
      box-shadow:0 4px 10px rgba(0,0,0,.04);
    }

    /* 6. spacing ข้อมูลในแต่ละแถว */
    .coop-profile-page .responsive-table tbody td{
      padding:.5rem 0 !important;
    }

    /* 7. label (คำว่า ปี / ชื่อ / วันที่) */
    .coop-profile-page .responsive-table tbody td::before{
      margin-bottom:.25rem;
    }

    /* 8. ปุ่ม download */
    .coop-profile-page .responsive-table td.row-actions .btn{
      width:100%;
      border-radius:.7rem;
      padding:.55rem;
    }

  }

  <% if (typeof embedded !== 'undefined' && embedded) { %>
  @media (max-width: 575.98px) {
    body {
      background: #f8fbff;
    }

    .coop-profile-page > .container.py-4 {
      padding: 1rem !important;
    }

    .coop-profile-page .profile-header-card,
    .coop-profile-page .section-nav,
    .coop-profile-page .section-block .card,
    .coop-profile-page .quick-stats .card {
      border-radius: 1rem !important;
    }

    .coop-profile-page .profile-header-card .card-body,
    .coop-profile-page .quick-stats .card-body {
      padding: 1rem 1.1rem !important;
    }

    .coop-profile-page .quick-stats {
      --bs-gutter-x: 0;
      --bs-gutter-y: .85rem;
      margin-left: 0;
      margin-right: 0;
    }

    .coop-profile-page .quick-stats > [class*="col-"] {
      padding-left: 0;
      padding-right: 0;
    }

    .coop-profile-page .section-block .card-header {
      padding: 1rem 1.15rem !important;
    }

    .coop-profile-page .section-block .card-body {
      padding: .75rem !important;
    }

    .coop-profile-page .section-block .responsive-table tbody tr {
      border: 1px solid var(--cp-line);
      padding: .8rem .9rem !important;
      background: #fff !important;
      box-shadow: 0 3px 10px rgba(15, 23, 42, .05);
    }

    .coop-profile-page .section-block .responsive-table tbody tr:last-child {
      margin-bottom: 0;
    }

    /* Mobile table: วางหัวข้อและค่าในแถวเดียว ลดความสูงของแต่ละรายการ */
    .coop-profile-page .section-block .responsive-table tbody td[data-label] {
      display: grid !important;
      grid-template-columns: minmax(5.5rem, 32%) minmax(0, 1fr);
      align-items: center;
      gap: .65rem;
      min-height: 2.35rem;
      padding: .42rem 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .coop-profile-page .section-block .responsive-table tbody td[data-label]::before {
      margin: 0;
      color: #64748b;
      font-size: .76rem;
      line-height: 1.35;
    }

    .coop-profile-page .section-block .responsive-table tbody td[data-label="สถาบัน"] {
      align-items: start;
    }

    .coop-profile-page .section-block .responsive-table tbody td.small-hide {
      display: none !important;
    }

    .coop-profile-page .section-block .responsive-table tbody td.row-actions .btn {
      justify-self: start;
      width: auto;
      min-width: 7rem;
      margin-top: 0;
    }

    #strength-section .card-body {
      background: #f8fafc;
    }

    #strength-section .responsive-table tbody tr {
      display: grid !important;
      grid-template-columns: .8fr 1fr 1fr;
      gap: .7rem;
      padding: 1rem !important;
    }

    #strength-section .responsive-table tbody td[data-label] {
      display: grid !important;
      grid-template-columns: 1fr;
      align-content: start;
      gap: .2rem;
      min-height: 0;
      padding: 0 !important;
    }

    #strength-section .responsive-table tbody td[data-label="สถาบัน"] {
      grid-column: 1 / -1;
      grid-row: 1;
      padding-bottom: .75rem !important;
      border-bottom: 1px solid var(--cp-line) !important;
    }

    #strength-section .responsive-table tbody td[data-label="ปี"] {
      grid-column: 1;
      grid-row: 2;
    }

    #strength-section .responsive-table tbody td[data-label="รวม"] {
      grid-column: 2;
      grid-row: 2;
    }

    #strength-section .responsive-table tbody td[data-label="ระดับ"] {
      grid-column: 3;
      grid-row: 2;
    }

    #strength-section .responsive-table tbody td[data-label="รวม"] {
      color: #0f766e;
      font-weight: 800;
    }

    #strength-section .responsive-table tbody td[data-label="ระดับ"] .badge {
      justify-self: start;
      padding: .45rem .7rem !important;
    }
  }
  <% } %>

  /* Profile visual refresh */
  .coop-profile-page {
    --cp-primary: #087f5b;
    --cp-primary-strong: #06664a;
    --cp-secondary: #0f766e;
    --cp-surface: rgba(255,255,255,.94);
    --cp-line: #dfe9e5;
    --cp-shadow: 0 14px 38px rgba(15, 118, 110, .08);
    background:
      radial-gradient(circle at 8% 4%, rgba(16,185,129,.12), transparent 25rem),
      radial-gradient(circle at 92% 13%, rgba(14,165,233,.09), transparent 24rem),
      linear-gradient(180deg,#f8fcfa 0%,#f3f7f6 100%);
  }

  .coop-profile-page .profile-header-card {
    position: relative;
    isolation: isolate;
    min-height: 190px;
    color: #fff;
    border: 0 !important;
    background:
      linear-gradient(125deg, rgba(4,86,64,.97), rgba(8,127,91,.94) 54%, rgba(13,148,136,.88)) !important;
    box-shadow: 0 22px 52px rgba(6,102,74,.2) !important;
  }

  .coop-profile-page .profile-header-card::before,
  .coop-profile-page .profile-header-card::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.13);
  }

  .coop-profile-page .profile-header-card::before {
    width: 260px;
    height: 260px;
    right: -70px;
    top: -155px;
    box-shadow: 0 0 0 38px rgba(255,255,255,.035), 0 0 0 76px rgba(255,255,255,.025);
  }

  .coop-profile-page .profile-header-card::after {
    width: 145px;
    height: 145px;
    right: 25%;
    bottom: -115px;
  }

  .coop-profile-page .profile-header-card .card-body {
    padding: 2rem 2.15rem !important;
  }

  .coop-profile-page .profile-eyebrow {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin-bottom: .6rem;
    color: rgba(255,255,255,.72);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .coop-profile-page .profile-eyebrow::before {
    content: '';
    width: 1.8rem;
    height: 2px;
    border-radius: 2px;
    background: #6ee7b7;
  }

  .coop-profile-page .profile-header-card h1 {
    max-width: 760px;
    margin-bottom: .65rem !important;
    color: #fff !important;
    font-size: clamp(1.3rem, 2.4vw, 2rem) !important;
    letter-spacing: -.02em;
  }

  .coop-profile-page .coop-logo {
    width: 78px !important;
    height: 78px !important;
    border: 1px solid rgba(255,255,255,.28);
    color: #fff !important;
    background: rgba(255,255,255,.14) !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 12px 28px rgba(0,0,0,.12);
    backdrop-filter: blur(10px);
  }

  .coop-profile-page .coop-logo i { font-size: 1.75rem; }

  .coop-profile-page .profile-code {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: rgba(255,255,255,.78);
  }

  .coop-profile-page .profile-code strong {
    padding: .3rem .7rem;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: .55rem;
    color: #fff !important;
    background: rgba(0,0,0,.12);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
  }

  .coop-profile-page .profile-header-card .copy-code {
    color: #fff;
    border-color: rgba(255,255,255,.4);
    background: rgba(255,255,255,.08);
  }

  .coop-profile-page .profile-header-card .copy-code:hover {
    color: var(--cp-primary-strong);
    border-color: #fff;
    background: #fff;
  }

  .coop-profile-page .profile-meta {
    max-width: 330px;
    padding: 1rem;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 1rem;
    background: rgba(0,0,0,.1);
    backdrop-filter: blur(12px);
  }

  .coop-profile-page .profile-meta-label {
    color: rgba(255,255,255,.66);
    font-size: .74rem;
    font-weight: 700;
  }

  .coop-profile-page .profile-record-count {
    color: #fff;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .coop-profile-page .profile-meta .badge {
    padding: .45rem .7rem;
    color: #fff !important;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.12) !important;
  }

  .coop-profile-page .section-nav {
    top: .75rem;
    padding: .65rem;
    background: rgba(255,255,255,.88);
    border-color: rgba(205,220,214,.86);
    box-shadow: 0 12px 30px rgba(15,23,42,.08);
  }

  .coop-profile-page .section-nav a {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .5rem .75rem;
    color: #52635d;
    background: transparent;
    transition: color .2s ease, background-color .2s ease, transform .2s ease;
  }

  .coop-profile-page .section-nav a:hover,
  .coop-profile-page .section-nav a.active {
    color: #fff;
    background: linear-gradient(135deg,var(--cp-primary-strong),var(--cp-secondary));
    transform: translateY(-1px);
  }

  .coop-profile-page .quick-stats .card {
    position: relative;
    overflow: hidden;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .coop-profile-page .quick-stats .card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--stat-accent,#10b981);
  }

  .coop-profile-page .quick-stats .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px rgba(15,23,42,.1) !important;
  }

  .coop-profile-page .stat-card--blue { --stat-accent:#3b82f6; }
  .coop-profile-page .stat-card--cyan { --stat-accent:#06b6d4; }
  .coop-profile-page .stat-card--green { --stat-accent:#10b981; }
  .coop-profile-page .stat-card--violet { --stat-accent:#8b5cf6; }

  .coop-profile-page .quick-stats i {
    color: var(--stat-accent,#10b981) !important;
    background: color-mix(in srgb, var(--stat-accent,#10b981) 11%, white);
  }

  .coop-profile-page .section-block > .card,
  .coop-profile-page .row.my-2 .card {
    border-color: #e3ece8 !important;
    background: var(--cp-surface);
    transition: box-shadow .22s ease, border-color .22s ease;
  }

  .coop-profile-page .section-block > .card:hover,
  .coop-profile-page .row.my-2 .card:hover {
    border-color: #c8ddd5 !important;
    box-shadow: 0 18px 42px rgba(15,118,110,.1) !important;
  }

  .coop-profile-page .section-block .card-header,
  .coop-profile-page .row.my-2 .card-header {
    position: relative;
    min-height: 62px;
    padding: 1rem 1.15rem !important;
    background: linear-gradient(180deg,#fff,#fbfdfc) !important;
  }

  .coop-profile-page .section-block .card-header::before,
  .coop-profile-page .row.my-2 .card-header::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 4px;
    border-radius: 0 6px 6px 0;
    background: var(--section-accent,#10b981);
  }

  #addmem-section { --section-accent:#7c3aed; }
  #strength-section { --section-accent:#0891b2; }
  #rules-section { --section-accent:#d97706; }
  #rabiab-section { --section-accent:#64748b; }
  #vong-section { --section-accent:#e11d48; }
  #finance-section { --section-accent:#2563eb; }
  #business-section { --section-accent:#059669; }
  #turnover-section { --section-accent:#0f766e; }
  #rq2-section { --section-accent:#0284c7; }
  #assets-section { --section-accent:#475569; }

  .coop-profile-page .card-header h5 > i,
  .coop-profile-page .card-header h6 > i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-right: .6rem !important;
    border-radius: .65rem;
