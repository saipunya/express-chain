  .main-coop-map-result-actions button { color: var(--main-green); border: 1px solid #cce7da; border-radius: 6px; background: #eef7f2; padding: .2rem .5rem; }
  .main-coop-map-empty { padding: 1.5rem 1rem; color: var(--main-muted); font-size: .85rem; }
  .main-coop-map-notice { padding: .75rem 1.2rem; background: #fff5df; color: #805711; font-size: .85rem; }
  .main-coop-map-filter:focus-visible, .main-coop-map-result-actions button:focus-visible { outline: 3px solid #147957; outline-offset: 3px; }

  .main-coop-map-title {
    align-items: center;
    display: flex;
    gap: .65rem;
  }

  .main-coop-map-title-icon {
    align-items: center;
    background: #e9f7ef;
    border-radius: 12px;
    color: var(--main-green);
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 1.15rem;
    height: 2.65rem;
    justify-content: center;
    width: 2.65rem;
  }

  .main-coop-map-title h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }

  .main-coop-map-filters {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    justify-content: flex-end;
  }

  .main-coop-map-filter {
    background: #f6f8f7;
    border: 1px solid #e0e7e3;
    border-radius: 999px;
    color: #52635c;
    font-size: .78rem;
    font-weight: 700;
    padding: .42rem .7rem;
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  }

  .main-coop-map-filter:hover,
  .main-coop-map-filter.active {
    background: #e9f7ef;
    border-color: #9dd3bc;
    color: var(--main-green);
  }

  .main-coop-map-wrap {
    background: #e8eeeb;
    height: 28rem;
    position: relative;
    isolation: isolate;
  }

  .main-coop-map-canvas {
    height: 100%;
    width: 100%;
  }

  .main-coop-map-count {
    align-items: center;
    background: rgba(255, 255, 255, .94);
    border: 1px solid rgba(221, 229, 238, .95);
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(24, 34, 48, .1);
    display: flex;
    gap: .5rem;
    right: 1rem;
    padding: .55rem .75rem;
    pointer-events: none;
    position: absolute;
    top: 1rem;
    z-index: 500;
  }

  .main-coop-map-count strong {
    color: var(--main-green);
    font-size: 1.05rem;
  }

  .main-coop-map-count span {
    color: var(--main-muted);
    font-size: .75rem;
  }

  .main-coop-map-legend {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    padding: .8rem 1.2rem;
  }

  .main-coop-map-legend span {
    align-items: center;
    color: var(--main-muted);
    display: inline-flex;
    font-size: .75rem;
    gap: .4rem;
  }

  .main-coop-map-dot {
    background: var(--map-dot, var(--main-green));
    border: 2px solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--map-dot, var(--main-green));
    display: inline-block;
    height: .68rem;
    width: .68rem;
  }

  .main-coop-map-popup {
    min-width: 12rem;
  }

  .main-coop-map-popup strong,
  .main-coop-map-popup span {
    display: block;
  }

  .main-coop-map-popup strong {
    color: var(--main-ink);
    font-family: 'Sarabun', sans-serif;
    font-size: .88rem;
    line-height: 1.45;
  }

  .main-coop-map-popup span {
    color: var(--main-muted);
    font-family: 'Sarabun', sans-serif;
    font-size: .74rem;
    margin-top: .2rem;
  }

  .main-coop-map-popup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: .65rem;
  }

  .main-coop-map-popup-link {
    align-items: center;
    background: #eef7f2;
    border: 1px solid #cce7da;
    border-radius: 999px;
    color: #0c704c !important;
    display: inline-flex !important;
    font-family: 'Sarabun', sans-serif;
    font-size: .7rem;
    font-weight: 700;
    gap: .25rem;
    padding: .3rem .55rem;
    text-decoration: none;
  }

  .main-coop-map-popup-link:hover {
    background: #daf0e5;
    color: #07583b !important;
  }

  .main-coop-map-error {
    align-items: center;
    color: var(--main-muted);
    display: none;
    inset: 0;
    justify-content: center;
    padding: 2rem;
    position: absolute;
    text-align: center;
  }

  .main-coop-map-wrap.map-error .main-coop-map-error { display: flex; }
  .main-coop-map-wrap.map-error .main-coop-map-canvas { visibility: hidden; }

  .main-district-summary { margin-top: 1.25rem; }
  .main-district-totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; margin-bottom: 1rem; }
  .main-district-total { background: #fff; border: 1px solid #d8e5dc; border-radius: 12px; padding: .7rem .85rem; }
  .main-district-total dt { color: #52635c; font-size: .8rem; font-weight: 600; }
  .main-district-total dd { color: var(--main-green); font-size: 1.65rem; font-weight: 700; line-height: 1.3; margin: .2rem 0 0; }
  .main-district-total dd small { color: #69786e; font-size: .75rem; font-weight: 400; }
  .main-district-total:last-child { background: #e0eee5; }
  .main-district-head { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; margin-bottom: .5rem; }
  .main-district-head h3 { font-size: .95rem; font-weight: 700; margin: 0; }
  .main-district-head span { color: #52635c; font-size: .75rem; }
  .main-district-table-wrap { max-height: 18rem; overflow: auto; border: 1px solid #d8e5dc; border-radius: 12px; background: #fff; scrollbar-color: #aabeb0 #f2f7f3; scrollbar-width: thin; }
  .main-district-table { border-collapse: separate; border-spacing: 0; font-size: .84rem; width: 100%; }
  .main-district-table th, .main-district-table td { padding: .55rem .7rem; border-bottom: 1px solid #e7eee9; text-align: right; font-variant-numeric: tabular-nums; }
  .main-district-table th:first-child { text-align: left; }
  .main-district-table thead th { background: #f3f8f4; color: #52635c; font-weight: 600; position: sticky; top: 0; z-index: 1; }
  .main-district-table tbody th { font-weight: 400; }
  .main-district-table tbody tr:hover { background: #f7faf8; }
  .main-district-table tr > :last-child { color: var(--main-green); font-weight: 700; padding-right: 1rem; }
  .main-district-table tfoot th, .main-district-table tfoot td { background: #edf5ef; border-bottom: 0; font-weight: 700; }
  .main-district-table .main-district-unknown { background: #fff9ec; }
  .main-hero .main-district-note { color: #68776e; font-size: .75rem; margin: .65rem 0 0; }
  .main-district-table-wrap:focus-visible { outline: 3px solid var(--main-green); outline-offset: 3px; }

  @media (max-width: 575.98px) {
    .main-district-totals { gap: .4rem; }
    .main-district-total { padding: .65rem .5rem; }
    .main-district-total dt { font-size: .72rem; }
    .main-district-total dd { font-size: 1.4rem; }
    .main-district-table { font-size: .75rem; }
    .main-district-table th, .main-district-table td { padding: .5rem .4rem; }
    .main-district-head { align-items: flex-start; flex-direction: column; gap: .25rem; }
  }

  @media (max-width: 991.98px) {
    .main-coop-map-layout { grid-template-columns: 1fr; }
    .main-coop-map-results { border-left: 0; border-top: 1px solid var(--main-line); }
    .main-coop-map-result-scroll { height: auto; max-height: 20rem; }
  }

  @media (max-width: 767.98px) {
    .main-strength-heading {
      align-items: flex-start;
    }

    .main-strength-actions {
      justify-content: flex-start;
      width: 100%;
    }

    .main-strength-self-assess {
      justify-content: center;
      width: 100%;
    }

    .main-strength-feature-card {
      height: 22.5rem;
    }

    .main-coop-map-head {
      align-items: stretch;
      flex-direction: column;
    }

    .main-coop-map-filters {
      justify-content: flex-start;
    }

    .main-coop-map-filter {
      flex: 0 0 auto;
    }

    .main-coop-map-district { flex-grow: 1; }

    .main-coop-map-wrap {
      height: 23rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-strength-feature-card,
    .main-strength-feature-icon,
    .main-strength-self-assess {
      transition: none;
    }

    .main-strength-feature-card:hover,
    .main-strength-feature-card:hover .main-strength-feature-icon,
    .main-strength-self-assess:hover {
      transform: none;
    }
  }
</style>

<%
  const _institutionSummary = (typeof institutionSummary !== 'undefined' && institutionSummary) ? institutionSummary : {
    agri: { key: 'agri', label: 'สหกรณ์ภาคการเกษตร', shortLabel: 'ภาคการเกษตร', icon: 'bi-flower1', tone: 'green', count: 0, rows: [] },
    non_agri: { key: 'non_agri', label: 'สหกรณ์นอกภาค', shortLabel: 'นอกภาค', icon: 'bi-buildings', tone: 'teal', count: 0, rows: [] },
    farmer: { key: 'farmer', label: 'กลุ่มเกษตรกร', shortLabel: 'กลุ่มเกษตรกร', icon: 'bi-people', tone: 'amber', count: 0, rows: [] }
  };
  const _institutionSummaryList = ['agri', 'non_agri', 'farmer'].map((key) => _institutionSummary[key]).filter(Boolean);
  const _institutionTotal = _institutionSummaryList.reduce((sum, item) => sum + Number(item.count || 0), 0);
  const _institutionDistrictSummary = (typeof institutionDistrictSummary !== 'undefined' && institutionDistrictSummary)
    ? institutionDistrictSummary : { rows: [], totals: { cooperatives: 0, farmerGroups: 0, total: 0 }, unknownTotal: 0 };
  const _institutionDistrictUnavailable = typeof institutionDistrictUnavailable !== 'undefined' && institutionDistrictUnavailable === true;
  const _mapSafeUrl = (value) => {
    try {
      const url = new URL(String(value || ''));
      return ['https:', 'http:'].includes(url.protocol) ? url.href : '';
    } catch (_) { return ''; }
  };
  const _cooperativeMapLocations = (typeof cooperativeMapLocations !== 'undefined' && Array.isArray(cooperativeMapLocations))
    ? cooperativeMapLocations.filter(Boolean).map((item) => ({
        code: String(item.code || item.c_code || ''),
        name: String(item.name || item.c_name || 'ไม่ระบุชื่อ'),
        type: ['agri', 'non_agri', 'farmer'].includes(String(item.type || '')) ? String(item.type) : 'agri',
        district: String(item.district || item.c_amp || '').trim(),
        address: String(item.address || item.address_text || ''),
        latitude: Number(item.latitude),
        longitude: Number(item.longitude),
        websiteUrl: _mapSafeUrl(item.websiteUrl || item.website_url),
        googleMapsUrl: _mapSafeUrl(item.googleMapsUrl || item.google_maps_url)
      })).filter((item) => Number.isFinite(item.latitude) && Number.isFinite(item.longitude)
        && item.latitude >= 14.8 && item.latitude <= 17 && item.longitude >= 101 && item.longitude <= 103)
    : [];
  const _cooperativeMapDistricts = [...new Set(_cooperativeMapLocations.map((item) => item.district).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'th'));
  const _cooperativeMapTypeLabels = { agri: 'สหกรณ์ภาคการเกษตร', non_agri: 'สหกรณ์นอกภาคการเกษตร', farmer: 'กลุ่มเกษตรกร' };
  const _cooperativeMapUnavailable = typeof cooperativeMapUnavailable !== 'undefined' && cooperativeMapUnavailable === true;
  const _cooperativeMapIsDemo = typeof cooperativeMapIsDemo !== 'undefined' && cooperativeMapIsDemo === true;
  const _cooperativeMapJson = JSON.stringify(_cooperativeMapLocations).replace(/</g, '\\u003c');
  const _onlineUsers = (typeof onlineUsers !== 'undefined' && Array.isArray(onlineUsers)) ? onlineUsers : [];
  const _onlineCount = Number((typeof onlineCount !== 'undefined' && onlineCount !== null) ? onlineCount : _onlineUsers.length);
  const _mainDownloads = (typeof mainDownloads !== 'undefined' && Array.isArray(mainDownloads)) ? mainDownloads : [];
  const _currentUser = (typeof user !== 'undefined' && user) ? user : null;
  const _currentUserGroup = String((_currentUser && (_currentUser.group || _currentUser.m_group)) || '').trim().toLowerCase();
  const _currentUserClass = String((_currentUser && (_currentUser.mClass || _currentUser.m_class)) || '').trim().toLowerCase();
  const _isInstitutionUser = ['coop', 'group'].includes(_currentUserGroup) || ['c', 'g'].includes(_currentUserClass);
  const _canManageCooperativeLocations = _currentUser && !_isInstitutionUser
    && [_currentUser.mClass, _currentUser.m_class, _currentUser.level].some((level) => ['admin', 'pbt'].includes(String(level || '').trim()));
  const _dashboardPath = _isInstitutionUser ? '/dashboard2' : '/dashboard';
  const _displayName = (_currentUser && (_currentUser.fullname || _currentUser.m_name || _currentUser.username || _currentUser.m_user)) || '';
  const _displayPosition = (_currentUser && (_currentUser.position || _currentUser.m_position)) || '';
  const _avatarLabel = _displayName ? _displayName.trim().slice(0, 2).toUpperCase() : 'CC';
  const _institutionChartData = _institutionSummaryList.map((item) => ({
    key: item.key,
    label: item.label,
    count: Number(item.count || 0),
    color: item.key === 'non_agri' ? '#147b83' : item.key === 'farmer' ? '#f0a020' : '#107f50'
  }));
  const _turnoverCategorySummary = (typeof turnoverCategorySummary !== 'undefined' && turnoverCategorySummary) ? turnoverCategorySummary : {
    latestBudYear: 0,
    latestBudYearThai: '',
    totalAmount: 0,
    list: []
  };
  const _turnoverCategoryList = Array.isArray(_turnoverCategorySummary.list) ? _turnoverCategorySummary.list : [];
  const _turnoverTotalAmount = Number(_turnoverCategorySummary.totalAmount || 0);
  const _formatTurnoverAmount = (value) => {
    const amount = Number(value || 0);
    if (amount >= 1000000) return `${(amount / 1000000).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ล้านบาท`;
    return `${amount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} บาท`;
  };
  const _strengthGradeSummary = (typeof strengthGradeSummary !== 'undefined' && strengthGradeSummary) ? strengthGradeSummary : {
    year: 2568,
    list: [],
    totals: { total: 0, grade1: 0, grade2: 0, grade3: 0 }
  };
  const _strengthGradeList = Array.isArray(_strengthGradeSummary.list) ? _strengthGradeSummary.list : [];
  const _strengthGradeTotals = _strengthGradeSummary.totals || { total: 0, grade1: 0, grade2: 0, grade3: 0 };
  const _chamraSummary = (typeof chamraSummary !== 'undefined' && chamraSummary) ? chamraSummary : {
    total: 0,
    inProgress: 0,
    withdrawn: 0,
    noProcess: 0,
    completionPercent: 0,
    cooperativeCount: 0,
    farmerGroupCount: 0,
    latestUpdateThai: '',
    steps: []
  };
  const _chamraSteps = Array.isArray(_chamraSummary.steps) ? _chamraSummary.steps : [];
%>

<div class="main-dashboard-shell">
  <aside class="main-sidebar d-flex flex-column">
    <div class="main-brand">
      <img src="/icon/seal.svg" alt="CoopChain">
      <div>
        <p class="main-brand-title">CoopChain</p>
        <div class="main-brand-subtitle">สำนักงานสหกรณ์จังหวัดชัยภูมิ</div>
      </div>
    </div>

    <nav class="main-nav" aria-label="เมนูหลัก">
      <a href="/main" class="main-nav-link active" aria-current="page">
        <i class="bi bi-grid-1x2-fill"></i>
        <span>หน้าแรก</span>
      </a>
      <a href="/register" class="main-nav-link">
        <i class="bi bi-person-plus"></i>
        <span>สมัครสมาชิก</span>
      </a>
      <a href="/chamra" class="main-nav-link">
        <i class="bi bi-circle-fill"></i>
        <span>งานชำระบัญชี</span>
      </a>
      <a href="#cooperativeMapSection" class="main-nav-link">
        <i class="bi bi-pin-map"></i>
        <span>แผนที่สถาบัน</span>
      </a>

    </nav>

    <div class="main-sidebar-foot">
      <div class="small fw-semibold text-white-50 mb-2">สถานะระบบ</div>
      <div class="d-flex align-items-center justify-content-between gap-3">
        <span class="fw-semibold text-success">พร้อมใช้งาน</span>
        <span class="badge text-bg-success">Online</span>
      </div>
    </div>
  </aside>

  <section class="main-content">
    <div class="main-topbar">
      <div>
        <div class="text-muted small">หน้าหลัก CoopChain</div>
        <h1 class="h4 fw-bold mb-0">ระบบสารสนเทศและเครือข่ายสหกรณ์</h1>
      </div>
      <div class="d-flex align-items-center gap-3">
        <span class="main-pill d-none d-lg-inline-flex">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span><%= _currentUser ? 'อยู่ในระบบแล้ว' : `${_institutionTotal} สถาบัน` %></span>
        </span>
        <div class="main-avatar"><%= _avatarLabel %></div>
      </div>
    </div>

    <div class="row g-3 align-items-stretch">
      <div class="col-xl-4 order-1 order-xl-2">
        <div class="card main-login-card border-0 shadow-sm h-100">
          <div class="card-body p-4 d-flex flex-column <%= _currentUser ? '' : 'justify-content-center' %>">
            <% if (_currentUser) { %>
              <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                  <div class="main-stat-icon green"><i class="bi bi-person-check"></i></div>
                  <span class="badge text-bg-success">เข้าสู่ระบบแล้ว</span>
                </div>
                <h2 class="h4 fw-bold mb-2">คุณเข้าสู่ระบบแล้ว</h2>
                <p class="text-muted mb-0">ยังอยู่ใน session ของ <%= _displayName || 'ผู้ใช้งาน' %></p>
              </div>

              <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light border mb-4">
                <% if (_currentUser.m_img) { %>
                  <img src="<%= _currentUser.m_img %>" alt="Profile" class="rounded-circle" style="width: 52px; height: 52px; object-fit: cover;">
                <% } else { %>
                  <div class="main-avatar"><%= _avatarLabel %></div>
                <% } %>
                <div class="min-w-0">
                  <div class="fw-bold text-dark text-truncate"><%= _displayName || 'ผู้ใช้งาน' %></div>
                  <div class="small text-muted text-truncate"><%= _displayPosition || (_isInstitutionUser ? 'สมาชิกสถาบัน' : 'ผู้ใช้งานระบบ') %></div>
                </div>
              </div>

              <div class="d-grid gap-2 mt-auto">
                <a href="<%= _dashboardPath %>" class="btn btn-success btn-lg">
                  <i class="bi bi-speedometer2 me-1"></i>กลับเข้าแดชบอร์ด
                </a>
                <a href="/auth/logout" class="btn btn-outline-danger">
                  <i class="bi bi-box-arrow-right me-1"></i>ออกจากระบบ
                </a>
              </div>
            <% } else { %>
            <div class="mb-4">
              <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div class="main-stat-icon green"><i class="bi bi-shield-lock"></i></div>
                <span class="badge text-bg-light text-success">ระบบปลอดภัย</span>
              </div>
              <h2 class="h4 fw-bold mb-2">เข้าสู่ระบบ</h2>
              <p class="text-muted mb-0">ลงชื่อเข้าใช้เพื่อเข้าสู่หน้าหลักตามสิทธิ์ของบัญชี</p>
            </div>

            <form action="/auth/login" method="POST" class="mb-4">
              <div class="mb-3">
                <label for="username" class="form-label">ชื่อผู้ใช้</label>
                <input type="text" name="username" id="username" class="form-control form-control-lg" autocomplete="username" required autofocus>
                <div class="invalid-feedback">กรุณากรอกชื่อผู้ใช้</div>
              </div>

              <div class="mb-3">
                <label for="password" class="form-label">รหัสผ่าน</label>
                <input type="password" name="password" id="password" class="form-control form-control-lg" autocomplete="current-password" required>
                <div class="invalid-feedback">กรุณากรอกรหัสผ่าน</div>
              </div>

              <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
