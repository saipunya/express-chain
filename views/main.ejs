  .main-coop-map-tools .main-coop-map-filters { flex: 1 0 100%; justify-content: flex-start; }

  .main-coop-map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    border-top: 1px solid var(--main-line);
  }

  .main-coop-map-results {
