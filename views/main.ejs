  .main-coop-map-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: .75rem;
    padding: 0 1.2rem 1rem;
  }

  .main-coop-map-search { flex: 1 1 17rem; min-width: 0; }
  .main-coop-map-district { flex: 0 1 13rem; }
