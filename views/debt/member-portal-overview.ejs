<%- include('partials/member-head') %>
<% const totalBalance=loans.reduce((sum,x)=>sum+Number(x.principal_balance||0),0); const totalOverdue=loans.reduce((sum,x)=>sum+Number(x.total_overdue||0),0); const nearestDue=loans.map(x=>x.next_due_date).filter(Boolean).sort()[0]; const highestRisk=loans.find(x=>x.risk_color==='RED') || loans.find(x=>x.risk_color==='ORANGE') || loans[0]; %>
<section class="member-welcome"><div><span class="demo-pill"><%= member.demo_flag ? 'ข้อมูลสาธิต' : 'ข้อมูลสมาชิก' %></span><h1>สวัสดี <%= member.display_name %></h1><p>เลขสมาชิก <strong><%= member.member_no %></strong> • <%= member.c_name %></p></div><div class="member-asof"><small>ข้อมูล ณ วันที่</small><strong><%= debtDate(asOfDate) %></strong></div></section>
<div class="member-focus-layout"><section class="member-primary-card"><span>ยอดหนี้คงเหลือรวม</span><div><strong><%= debtMoney(totalBalance) %></strong><small>บาท</small></div><p><i class="bi bi-file-earmark-text"></i> <%= debtNumber(loans.length) %> สัญญาที่ใช้งาน</p></section><div class="member-quick-facts"><section class="<%= totalOverdue>0?'attention':'' %>"><span>ยอดค้างชำระ</span><strong><%= debtMoney(totalOverdue) %> บาท</strong><small><%= totalOverdue>0?'ควรตรวจสอบรายละเอียด':'ไม่มียอดค้างในข้อมูลล่าสุด' %></small></section><section><span>กำหนดชำระใกล้ที่สุด</span><strong><%= debtDate(nearestDue) %></strong><small><%= highestRisk ? debtRiskThai(highestRisk.risk_color) : 'ไม่พบสัญญา' %></small></section></div></div>
<section class="panel"><div class="panel-head"><div><span class="section-kicker">MY LOANS</span><h2>สัญญาเงินกู้ของฉัน</h2></div></div><% if(!loans.length){ %><div class="empty-state"><i class="bi bi-check2-circle"></i><p>ไม่พบสัญญาเงินกู้ที่ใช้งาน</p></div><% }else{ %><div class="member-loan-list"><% loans.forEach((loan)=>{ %><a href="/debt/member/loans/<%= loan.loan_id %>"><div class="loan-icon"><i class="bi bi-file-earmark-text"></i></div><div class="loan-info"><span><%= loan.loan_type || 'เงินกู้' %></span><strong><%= loan.loan_no %></strong><small><%= debtRiskThai(loan.risk_color) %> • <%= loan.attention_reason %></small></div><div class="loan-balance"><span>ยอดคงเหลือ</span><strong><%= debtMoney(loan.principal_balance) %></strong><small>บาท</small></div><i class="bi bi-chevron-right"></i></a><% }) %></div><% } %></section>
<div class="privacy-note"><i class="bi bi-info-circle"></i><div><strong>เกี่ยวกับข้อมูลของคุณ</strong><p>ระบบแสดงข้อมูลจากสหกรณ์โดยตรง สมาชิกไม่สามารถแก้ไขยอดหนี้หรือรายการชำระผ่านหน้านี้</p></div></div>
<%- include('partials/member-foot') %>
